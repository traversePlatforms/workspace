# ---------------------------------------------------------------
# What this repo is for: versioning the ~700 text files that get
# edited — markdown, HTML, CSS, scripts, SVG, PDFs, the .docx
# training sources. NOT a backup tool for 3.2 GB of raw footage.
# Media excluded here still needs a real backup elsewhere.
# ---------------------------------------------------------------

# --- Raw video: 3.2 GB, never edited in place, back up separately
*.mov
*.MOV
*.mp4
*.MP4
*.avi
# --- except the finished site hero (2 MB each, part of the deployable site)
!surge/website/build/assets/video/hero.mp4
!surge/website/build/assets/video/hero-mobile.mp4
!surge/website/build/assets/video/hero.webm

# --- Camera originals
*.heic
*.HEIC

# --- Archives / site bundles
*.zip
*.wpress
**/deploy/dist/

# --- The big photo tree (~500 MB) — but keep the notes written inside it
surge/brand/photos/**
!surge/brand/photos/**/
!surge/brand/photos/**/*.md

# --- Archive payload: superseded, duplicated and unrelated material.
#     Keep the record of what was set aside, not the bytes.
_archive/**
!_archive/
!_archive/README.md
!_archive/MOVE-MANIFEST-2026-09-13.csv
# The archived PAYLOAD stays out of git; the RECORD of what moved does not.
# Without these, every new archive folder loses its manifest and README the
# moment the payload is cleared, and the undo record goes with it.
!_archive/*/
!_archive/*/README.md
!_archive/*/MOVE-MANIFEST-*.csv

# --- Regenerable dependency trees (npm install rebuilds)
node_modules/

# --- OS / editor cruft
Thumbs.db
desktop.ini
.DS_Store
*.tmp
*~

# --- The Google Drive team-share folder: 5.4 MB of COPIES, rebuilt in a second
# by `node sixfold/team-share/build-team-share.mjs`. Tracking them would commit
# another copy of every PDF each time a source is corrected, for no benefit —
# the originals are already versioned and the generator is the real artefact.
# The folder itself still gets backed up by the OneDrive mirror.
sixfold/team-share/files/

# Sixfold site upload bundles — rebuildable with make-bundle.mjs, and 3 MB a go
sixfold/site/dist/

# --- Live credential: the Gmail app password the contact form sends with.
#     The shape is tracked as sixfold/site/api/secrets.example.php.
sixfold/site/api/secrets.php

# Door-territory outputs — generated from public county records, but each file is
# a list of named private individuals at their home addresses. Regenerable in
# minutes; nothing is lost by keeping them out of git and the OneDrive mirror.
traverse/data-pipeline/door-territory/*.csv
traverse/data-pipeline/door-territory/.address-cache.json
# 2026-10-03, same reasoning: the mailing list (owners at their mailing addresses), the
# property-address cache behind it, the state HOA roster (designated agents' names and
# addresses), and the lawn-health trial's per-door results. All regenerable by script.
traverse/data-pipeline/door-territory/mail/*.csv
traverse/data-pipeline/door-territory/.situs-cache.json
traverse/data-pipeline/door-territory/hoa-registry/*.csv
traverse/data-pipeline/door-territory/lawn-trial/ndvi-results.csv
traverse/data-pipeline/door-territory/lawn-trial/ndvi-cache.json
traverse/data-pipeline/door-territory/**/*.log
traverse/data-pipeline/door-territory/*.log
# and the printed versions of the same thing
traverse/data-pipeline/door-territory/*.pdf
traverse/data-pipeline/door-territory/walklist-print.html

# Live sign-in codes for /rounds/ — every code opens 2,656 home addresses.
sixfold/site/api/rounds-codes.php
traverse/app/api/rounds-codes.php
traverse/app/api/skiptrace-config.php
# Skip-trace provider key (2026-10-04). Shape tracked as sixfold/site/api/skiptrace-config.example.php.
sixfold/site/api/skiptrace-config.php
# Owners' mailing addresses + ZIPs per door (skip-trace sidecar): from the gitignored county CSVs,
# rebuildable with operations/door-territory/build-mail-sidecar.mjs
traverse/app/data/rounds/mail-*.json
# The marks log written beside the door lists.
traverse/app/data/rounds/*.log

# Owner history across door-list rebuilds (SX-35): named owners and every previous owner.
# Not rebuildable — the OneDrive mirror is its only backup.
traverse/data-pipeline/door-territory/owner-history.json

# Lawn outlines for the door app (SX-38): regenerable with lawn-trial/build-lawn-outlines.mjs, ~18 MB
traverse/app/data/rounds/lawnmask-*.json
traverse/app/data/rounds/search-index.txt

# Monthly lawn-health results (SX-42) carry addresses, like ndvi-results.csv
traverse/data-pipeline/door-territory/lawn-trial/ndvi-results-*.csv

# lawn-trial working files (per-door outlines cache and a pre-compact backup), never tracked
traverse/data-pipeline/door-territory/lawn-trial/lawnmask-cache.json
traverse/data-pipeline/door-territory/lawn-trial/*.bak

# Hail per door (2026-10-04): daily radar cut-outs and the built files, regenerable with
# door-app/operations/door-territory/hail/build-hail.mjs (fetch, then build)
traverse/data-pipeline/door-territory/hail/days/
traverse/data-pipeline/door-territory/hail/days-*/
traverse/data-pipeline/door-territory/hail/fetch.log
traverse/app/data/rounds/hail-*.json

# County assessor downloads (2026-10-04): owners names and addresses, regenerable from the county sites
traverse/data-pipeline/door-territory/assessor/raw/
# Roof measurements (2026-10-04): cache and the built files, regenerable with roofs/sample-roofs.mjs
traverse/data-pipeline/door-territory/roofs/roof-cache*.json*
traverse/data-pipeline/door-territory/roofs/sample.log
traverse/app/data/rounds/roof-*.json
traverse/app/data/rounds/year-*.json
# Roof photos (2026-10-05): per-door photo windows, the photo file index, house centres and spot-check images; regenerable
traverse/app/data/rounds/photo-*.json
traverse/app/data/rounds/outline-*.json
traverse/app/data/rounds/storm-refresh.json*
traverse/app/data/rounds/secmap-cache.json*
traverse/data-pipeline/door-territory/roofs/photo-index.json
traverse/data-pipeline/door-territory/roofs/photo-index.log
traverse/data-pipeline/door-territory/roofs/houses-*.json
traverse/data-pipeline/door-territory/roofs/photo-check*.png
traverse/data-pipeline/door-territory/elpaso-imagery/tiles.json

# Door files and area lists carry owners' names and home addresses (review 2026-10-05: they were tracked, against
# the rule that lists of named people stay out of git). Regenerable from the county CSVs with build-rounds-data.mjs;
# kept on disk and in the OneDrive mirror. git history before 2026-10-05 still holds them: a copy for sale needs a fresh repo.
traverse/app/data/rounds/black-forest.json
traverse/app/data/rounds/castle-rock.json
traverse/app/data/rounds/cripple-creek.json
traverse/app/data/rounds/divide.json
