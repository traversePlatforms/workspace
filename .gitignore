traverse/app/data/rounds/monument.json
traverse/app/data/rounds/palmer-lake.json
traverse/app/data/rounds/sedalia.json
traverse/app/data/rounds/woodland-park.json
traverse/data-pipeline/door-territory/*-areas.json
traverse/data-pipeline/door-territory/walk-tool.html
# the Sample door: Matthew's parents' address (2026-10-05); built by a script, kept off git
traverse/app/data/rounds/sample-door.json
traverse/data-pipeline/door-territory/sample/
# alert caches the server writes for itself (2026-10-05)
traverse/app/data/rounds/alerts-cache.json*
traverse/app/data/rounds/storms-recent.json
traverse/app/data/rounds/wind-*.json
traverse/app/data/rounds/material-*.json
