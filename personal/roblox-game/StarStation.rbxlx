      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Captain Nolan's Star Station: every number and name in one place, so the game is easy to tune.
local Config = {}

Config.GameTitle = "Captain Nolan's Star Station"
Config.CommanderName = "Captain Nolan"

-- Nolan's colours: light orange and light blue, on a dark space-station deck
Config.Colors = {
	Orange = Color3.fromRGB(255, 186, 125),
	Blue = Color3.fromRGB(150, 210, 255),
	Deck = Color3.fromRGB(38, 44, 64),
	DeckLine = Color3.fromRGB(62, 72, 102),
	Trim = Color3.fromRGB(232, 238, 248),
	Dark = Color3.fromRGB(16, 18, 28),
}

-- weight = how often a critter of that rarity lands on the pad (out of the total)
Config.Rarities = {
	Common = { order = 1, color = Color3.fromRGB(200, 210, 220), weight = 60 },
	Rare = { order = 2, color = Color3.fromRGB(110, 190, 255), weight = 26 },
	Epic = { order = 3, color = Color3.fromRGB(190, 120, 255), weight = 10 },
	Legendary = { order = 4, color = Color3.fromRGB(255, 200, 70), weight = 3.5 },
	Mythic = { order = 5, color = Color3.fromRGB(255, 105, 85), weight = 1.2 }, -- added 2026-10-18
	Cosmic = { order = 6, color = Color3.fromRGB(255, 120, 200), weight = 0.4 },
}

-- shape: blob | bunny | cat | pup | alien | bear | dragon
-- price in Stardust; income = Stardust per second while it sits in your base
Config.Critters = {
	{ id = "blipblob", name = "Blip Blob", rarity = "Common", price = 20, income = 1, shape = "blob",
		body = Color3.fromRGB(140, 230, 170), accent = Color3.fromRGB(90, 180, 120) },
	{ id = "moonbunny", name = "Moon Bunny", rarity = "Common", price = 30, income = 1, shape = "bunny",
		body = Color3.fromRGB(235, 235, 245), accent = Color3.fromRGB(255, 186, 200) },
	{ id = "glorp", name = "Glorp", rarity = "Common", price = 40, income = 2, shape = "alien",
		body = Color3.fromRGB(150, 210, 255), accent = Color3.fromRGB(255, 186, 125) },
	{ id = "cometcat", name = "Comet Cat", rarity = "Rare", price = 150, income = 5, shape = "cat",
		body = Color3.fromRGB(255, 186, 125), accent = Color3.fromRGB(255, 240, 220) },
	{ id = "rocketpup", name = "Rocket Pup", rarity = "Rare", price = 220, income = 7, shape = "pup",
		body = Color3.fromRGB(196, 150, 110), accent = Color3.fromRGB(150, 210, 255) },
	{ id = "starbear", name = "Star Bear", rarity = "Epic", price = 900, income = 20, shape = "bear",
		body = Color3.fromRGB(120, 110, 200), accent = Color3.fromRGB(255, 230, 120) },
	{ id = "nebulafox", name = "Nebula Fox", rarity = "Epic", price = 1300, income = 28, shape = "cat",
		body = Color3.fromRGB(200, 120, 230), accent = Color3.fromRGB(150, 210, 255) },
	{ id = "stardragon", name = "Star Dragon", rarity = "Legendary", price = 5000, income = 90, shape = "dragon",
		body = Color3.fromRGB(90, 160, 255), accent = Color3.fromRGB(255, 186, 125) },
	{ id = "sunbeamsnoot", name = "Sunbeam Snoot", rarity = "Legendary", price = 6500, income = 110, shape = "pup",
		body = Color3.fromRGB(255, 210, 90), accent = Color3.fromRGB(255, 140, 60) },
	-- wave 2 (2026-10-18): nine more, and the Mythic tier
	{ id = "puffball", name = "Puffball", rarity = "Common", price = 25, income = 1, shape = "blob",
		body = Color3.fromRGB(255, 175, 210), accent = Color3.fromRGB(255, 120, 170) },
	{ id = "craterbunny", name = "Crater Bunny", rarity = "Common", price = 35, income = 2, shape = "bunny",
		body = Color3.fromRGB(172, 172, 184), accent = Color3.fromRGB(120, 120, 136) },
	{ id = "zapblob", name = "Zap Blob", rarity = "Rare", price = 180, income = 6, shape = "alien",
		body = Color3.fromRGB(255, 235, 110), accent = Color3.fromRGB(255, 170, 60) },
	{ id = "rocketbunny", name = "Rocket Bunny", rarity = "Rare", price = 260, income = 8, shape = "bunny",
		body = Color3.fromRGB(255, 186, 125), accent = Color3.fromRGB(150, 210, 255) },
	{ id = "galaxypup", name = "Galaxy Pup", rarity = "Epic", price = 1100, income = 24, shape = "pup",
		body = Color3.fromRGB(110, 85, 200), accent = Color3.fromRGB(255, 186, 125) },
	{ id = "saturnbear", name = "Saturn Bear", rarity = "Epic", price = 1600, income = 32, shape = "bear",
		body = Color3.fromRGB(255, 186, 125), accent = Color3.fromRGB(150, 210, 255) },
	{ id = "supernovacat", name = "Supernova Cat", rarity = "Legendary", price = 7500, income = 130, shape = "cat",
		body = Color3.fromRGB(255, 110, 80), accent = Color3.fromRGB(255, 220, 120) },
	{ id = "moonkingbear", name = "Moon King Bear", rarity = "Mythic", price = 12000, income = 200, shape = "bear",
		body = Color3.fromRGB(235, 235, 245), accent = Color3.fromRGB(255, 205, 70), glow = Color3.fromRGB(255, 220, 120) },
	{ id = "blackholedragon", name = "Black Hole Dragon", rarity = "Mythic", price = 15000, income = 240, shape = "dragon",
		body = Color3.fromRGB(55, 35, 85), accent = Color3.fromRGB(190, 120, 255), glow = Color3.fromRGB(190, 120, 255) },
	-- wave 3 (2026-10-18): five new body types
	{ id = "bloopjelly", name = "Bloop Jelly", rarity = "Common", price = 30, income = 1, shape = "jelly",
		body = Color3.fromRGB(170, 225, 255), accent = Color3.fromRGB(110, 190, 255) },
	{ id = "tinbot", name = "Tin Bot", rarity = "Common", price = 45, income = 2, shape = "robot",
		body = Color3.fromRGB(175, 182, 196), accent = Color3.fromRGB(110, 118, 136), glow = Color3.fromRGB(150, 210, 255) },
	{ id = "novachick", name = "Nova Chick", rarity = "Common", price = 50, income = 2, shape = "bird",
		body = Color3.fromRGB(255, 225, 110), accent = Color3.fromRGB(255, 186, 125) },
	{ id = "cometturtle", name = "Comet Turtle", rarity = "Rare", price = 200, income = 6, shape = "turtle",
		body = Color3.fromRGB(110, 180, 120), accent = Color3.fromRGB(255, 186, 125) },
	{ id = "astroowl", name = "Astro Owl", rarity = "Rare", price = 280, income = 8, shape = "bird",
		body = Color3.fromRGB(150, 120, 210), accent = Color3.fromRGB(110, 85, 170) },
	{ id = "octopop", name = "Octo-Pop", rarity = "Rare", price = 320, income = 9, shape = "octo",
		body = Color3.fromRGB(255, 150, 190), accent = Color3.fromRGB(255, 110, 160) },
	{ id = "mechapup", name = "Mecha Pup", rarity = "Epic", price = 1200, income = 26, shape = "robot",
		body = Color3.fromRGB(255, 186, 125), accent = Color3.fromRGB(150, 210, 255), glow = Color3.fromRGB(255, 120, 60) },
	{ id = "nebulajelly", name = "Nebula Jelly", rarity = "Epic", price = 1500, income = 30, shape = "jelly",
		body = Color3.fromRGB(190, 130, 255), accent = Color3.fromRGB(130, 80, 220), glow = Color3.fromRGB(255, 160, 255) },
	{ id = "orbitturtle", name = "Orbit Turtle", rarity = "Epic", price = 1800, income = 34, shape = "turtle",
		body = Color3.fromRGB(110, 170, 255), accent = Color3.fromRGB(230, 240, 255), glow = Color3.fromRGB(150, 220, 200) },
	{ id = "galaxyocto", name = "Galaxy Octopus", rarity = "Legendary", price = 8000, income = 140, shape = "octo",
		body = Color3.fromRGB(40, 50, 110), accent = Color3.fromRGB(90, 110, 220), glow = Color3.fromRGB(150, 210, 255) },
	{ id = "phoenixowl", name = "Phoenix Owl", rarity = "Legendary", price = 9000, income = 155, shape = "bird",
		body = Color3.fromRGB(255, 110, 60), accent = Color3.fromRGB(255, 200, 80), glow = Color3.fromRGB(255, 160, 60) },
	{ id = "quasarbot", name = "Quasar Robot", rarity = "Mythic", price = 14000, income = 220, shape = "robot",
		body = Color3.fromRGB(255, 205, 70), accent = Color3.fromRGB(60, 50, 90), glow = Color3.fromRGB(190, 120, 255) },
	-- Nolan's cat: a grey tabby with darker stripes
	-- Nolan's friends (2026-10-18, from photos): his cats Hammy and Zuzu, Matt the alien plush, and the sunflower plush.
	-- family = true: a special announcement when one lands, and a spot by the Commander statue.
	{ id = "hammy", name = "Hammy", rarity = "Cosmic", price = 25000, income = 400, shape = "cat", family = true,
		body = Color3.fromRGB(128, 128, 136), accent = Color3.fromRGB(84, 84, 92), stripes = true, tailStripes = true,
		eyeColor = Color3.fromRGB(205, 212, 130), muzzle = Color3.fromRGB(240, 238, 232), tailColor = Color3.fromRGB(118, 118, 126),
		glow = Color3.fromRGB(255, 186, 125), material = "Fabric" },
	{ id = "zuzu", name = "Zuzu", rarity = "Cosmic", price = 28000, income = 450, shape = "cat", family = true,
		body = Color3.fromRGB(250, 246, 240), accent = Color3.fromRGB(236, 196, 160), earColor = Color3.fromRGB(232, 176, 138),
		cap = Color3.fromRGB(240, 196, 150), capStripe = Color3.fromRGB(214, 140, 80), chest = Color3.fromRGB(255, 255, 252),
		tailColor = Color3.fromRGB(240, 220, 200), eyeColor = Color3.fromRGB(90, 130, 190), glow = Color3.fromRGB(150, 210, 255), material = "Fabric" },
	{ id = "matt", name = "Matt", rarity = "Mythic", price = 13000, income = 210, shape = "matt", family = true,
		body = Color3.fromRGB(78, 190, 58), accent = Color3.fromRGB(236, 234, 214), glow = Color3.fromRGB(190, 255, 120), material = "Fabric" },
	{ id = "sunnysprout", name = "Sunny Sprout", rarity = "Legendary", price = 7000, income = 120, shape = "sunflower", family = true,
		body = Color3.fromRGB(150, 222, 92), accent = Color3.fromRGB(255, 196, 88), face = Color3.fromRGB(215, 145, 115), rim = Color3.fromRGB(128, 68, 48),
		glow = Color3.fromRGB(255, 210, 100), material = "Fabric" },
	-- Dad's surprise critter goes here: set enabled = true and fill it in when it's designed
	{ id = "surprise", name = "???", rarity = "Cosmic", price = 30000, income = 500, shape = "blob",
		body = Color3.fromRGB(150, 210, 255), accent = Color3.fromRGB(255, 186, 125), enabled = false },
}

-- Nolan's Roblox user ID (a number, never his username; set 2026-10-18). He is the Captain: captain's hat and tag, the
-- CAPTAIN ON DECK greeting, and the control panel by his statue. Only he can ever get exclusive critters.
Config.ExclusiveUserId = 4290657201
Config.CaptainInStudio = true -- in Studio play-tests everyone is the Captain, so the panel can be tried
-- seconds before the Captain can press the same control-panel button again
Config.CaptainCooldowns = { shower = 60, night = 90, lights = 2, rain = 20, launch = 5, lowgrav = 60 }
Config.RocketCountdown = 5 -- seconds counted down before liftoff
Config.RocketBackAfter = 25 -- seconds after liftoff until a new rocket stands on the pad
Config.ExclusiveCritters = {} -- e.g. { "surprise" }

Config.StartStardust = 60
Config.BaseCount = 8 -- 4 on each side (2026-10-18: bigger map). Set the place's Max Players to 8 in Game Settings.
Config.PedestalsPerBase = 8 -- pedestals every base starts with
Config.MaxPedestals = 12 -- after buying both expansions
Config.ExpandCosts = { 2500, 10000 } -- each adds 2 pedestals
Config.SellBack = 0.4 -- selling a critter gives back 40% of its price

-- sprint: hold Shift (or the Sprint button on a phone); the energy bar drains while running and refills when you stop
Config.Sprint = { walk = 16, run = 27, drainPerSecond = 25, refillPerSecond = 14, refillDelay = 0.8 }
Config.SpawnEvery = 2.5 -- seconds between critters landing on the pad
Config.ConveyorSpeed = 7 -- studs per second
-- the base door (2026-10-18, Matthew): locked = nobody gets in, owner included. A lock lasts up to ShieldSeconds, then it opens;
-- after it opens (by itself or by you) you must wait ShieldCooldown before locking again: unlocking to get in is a risk
Config.ShieldSeconds = 30 -- halved 2026-10-18 (Matthew)
Config.ShieldCooldown = 15

-- punching (Q, a click, or the PUNCH button): knocks people back, knocks carried critters to the floor, stuns Parker Bots
Config.Punch = { reach = 7, cooldown = 0.6, knock = 55, floorSeconds = 20 }

-- Parker Bots patrol the walkways: chase anyone carrying a critter, take it, and zap them home
Config.Bots = { count = 3, speed = 8, chaseSpeed = 17, -- a bit slower (2026-10-18): walking is 16, sprinting 27
	sight = 45, reach = 4.5, stunSeconds = 3 }
-- the Gear Bay beside the launch tunnel (2026-10-18, Matthew: "equipment and weapons, maybe 2 offensive weapons").
-- Bought once with Stardust and kept. Weapons go in your backpack (number keys, or tap the icon on a tablet); use them with
-- Q, a click, or the PUNCH button, which turns into the weapon's button while you hold one.
Config.Gear = {
	{ id = "glove", name = "Boing Glove", kind = "weapon", price = 250, button = "BOING",
		reach = 13, cooldown = 0.9, knock = 1.8, stun = 4,
		blurb = "A boxing glove on a spring. Hits from far away and sends people flying." },
	{ id = "blaster", name = "Star Blaster", kind = "weapon", price = 2000, button = "ZAP",
		range = 70, cooldown = 1.4, knock = 0.7, stun = 6,
		blurb = "Shoots a star bolt at whoever is in front of you. Knocks critters loose and stuns Parker Bots." },
	{ id = "boots", name = "Jet Boots", kind = "equipment", price = 900,
		jumpHeight = 12, boost = 58,
		blurb = "Always on once bought: jump higher, and press jump again in the air for a rocket boost." },
}
function Config.gearById(id)
	for _, g in ipairs(Config.Gear) do
		if g.id == id then
			return g
		end
	end
	return nil
end

-- sounds (2026-10-18). Ids from the Roblox Creator Store: Roblox's own sounds and the ProSoundEffects and APM Music
-- libraries, which Roblox licenses free for every game. Picked by title, not by ear: swap any id you don't like.
Config.Sounds = {
	music = { id = 1844643755, volume = 0.25 }, -- APM "Space Adventures", loops
	night = { id = 140269757258221, volume = 0.5 }, -- APM "Eerie Drone", during Black Hole Night
	click = { id = 6042053626, volume = 0.4 },
	buy = { id = 127645268874265, volume = 0.6 }, -- Roblox CoinTransfer_01
	star = { id = 9126073001, volume = 0.35 },
	home = { id = 9116394545, volume = 0.6 },
	alarm = { id = 9125898704, volume = 0.5, stopAfter = 2.5 },
	shower = { id = 12222095, volume = 0.6 }, -- Roblox "Rocket whoosh 01"
	booped = { id = 9117841338, volume = 0.7 },
	swing = { id = 9113305311, volume = 0.5 },
	glove = { id = 9113305619, volume = 0.6 },
	pow = { id = 9117969717, volume = 0.6 },
	zapped = { id = 9114277757, volume = 0.6 },
	blaster = { id = 1836246284, volume = 0.5, stopAfter = 1.2 }, -- APM "Laser Short"
	bolt = { id = 9117841516, volume = 0.6 },
	lock = { id = 9117297453, volume = 0.5 },
	unlock = { id = 9117297453, volume = 0.5, pitch = 0.7 },
	sell = { id = 9113728042, volume = 0.5 },
	expand = { id = 1839901345, volume = 0.5 },
	gear = { id = 1839901345, volume = 0.6 },
	boost = { id = 9120006514, volume = 0.45, stopAfter = 1 },
	bot = { id = 9119100090, volume = 0.6 },
	gate = { id = 9116907550, volume = 0.5 }, -- the metal gate landing
	bounce = { id = 1841185443, volume = 0.5, stopAfter = 1.2 }, -- APM "Whizzing About", the trampoline
	arcade = { id = 9119218533, volume = 0.5 },
	lowgrav = { id = 9116385087, volume = 0.6 },
	upgrade = { id = 1839901345, volume = 0.6 },
	comet = { id = 12222095, volume = 0.35 },
	captain = { id = 1836473422, volume = 0.5 }, -- APM "Victory Fanfare Sting", when the Captain arrives
	countdown = { id = 9117060347, volume = 0.6 },
	liftoff = { id = 12222065, volume = 0.8 }, -- Roblox "Launching rocket"
	roar = { id = 9119414091, volume = 0.6, stopAfter = 8 },
}
-- Character upgrades (2026-10-18, Matthew: "character upgrade, slightly faster speed, maybe double jump, long stun on hits").
-- Bought at the Upgrade Lab by the spawn, kept for good; prices are per level.
Config.Upgrades = {
	{ id = "speed", name = "Turbo Legs", prices = { 500, 2000, 6000 }, blurb = "Run a little faster every level." },
	{ id = "jump", name = "Double Jump", prices = { 1500 }, blurb = "Press jump again in the air." },
	{ id = "stun", name = "Stun Power", prices = { 400, 1500, 5000 }, blurb = "Your hits stun people and Parker Bots for longer." },
}
Config.SpeedPerLevel = { walk = 1.5, run = 2 } -- added to walking (16) and sprinting (27) per Turbo Legs level
Config.StunBase = 0.6 -- seconds a punched player is slowed, before Stun Power
Config.StunPerLevel = 0.5 -- more seconds per Stun Power level (Parker Bots get a whole second per level)
function Config.upgradeById(id)
	for _, u in ipairs(Config.Upgrades) do
		if u.id == id then
			return u
		end
	end
	return nil
end

-- Furniture (2026-10-18, Matthew: "furniture in the base you can interact with, maybe a furniture store"). Bought at the
-- Space Furniture shop across the tunnel from the Gear Bay; it appears in your base wherever you are given one.
Config.Furniture = {
	{ id = "beanbag", name = "Bean Bag", price = 150, blurb = "Flop down and relax." },
	{ id = "bed", name = "Rocket Bed", price = 350, blurb = "A bed shaped like a rocket. Take a nap." },
	{ id = "disco", name = "Disco Ball", price = 400, blurb = "Party lights in your base." },
	{ id = "trampoline", name = "Moon Trampoline", price = 500, blurb = "Bounce sky high." },
	{ id = "telescope", name = "Telescope", price = 600, blurb = "Take a close look at the planets." },
	{ id = "arcade", name = "Arcade Machine", price = 800, blurb = "Play for a Stardust prize every 90 seconds." },
}
Config.ArcadeCooldown = 90
function Config.furnitureById(id)
	for _, f in ipairs(Config.Furniture) do
		if f.id == id then
			return f
		end
	end
	return nil
end

-- Low Gravity (2026-10-18): every so often gravity drops and everyone floats. Set to false to switch it off.
Config.LowGravity = true
Config.LowGravityFirst = 240 -- seconds until the first one
Config.LowGravityEvery = 420
Config.LowGravitySeconds = 40
Config.LowGravityValue = 55 -- normal is 196.2
Config.CometEvery = { 100, 170 } -- seconds between comets flying over (random in this range)
Config.StealHold = 1.5 -- seconds to hold E to steal
Config.CatchDistance = 7 -- owner this close to a thief takes their critter back
Config.AutosaveEvery = 60

-- Mutations (2026-10-18): any critter can land Golden or Rainbow; they cost a bit more and earn a lot more
Config.Mutations = {
	{ id = "rainbow", name = "Rainbow", chance = 0.015, income = 5, price = 3 },
	{ id = "golden", name = "Golden", chance = 0.08, income = 2, price = 1.5, color = Color3.fromRGB(255, 205, 70) },
}

-- Stardust stars floating around the station to run and grab
Config.Stars = {
	count = 24, -- how many are out at once
	value = 5, -- the least a star is worth
	incomeFactor = 3, -- or 3 seconds of your base's income, whichever is more
	respawnMin = 3, respawnMax = 7,
	pickupDistance = 5,
}
Config.MeteorFirst = 180 -- seconds until the first Meteor Shower
Config.MeteorEvery = 600 -- then every 10 minutes
Config.MeteorSeconds = 30
Config.MeteorPerSecond = 3
Config.MeteorStarBonus = 2 -- shower stars are worth double
-- the screen shakes a little in a Meteor Shower (2026-10-25, Matthew): a short rumble when it starts, and a bump when a meteor
-- lands near you (harder the closer it is). Kept small on purpose so it can't make anyone feel sick: the camera only slides a
-- few tenths of a stud, never turns, and settles in about half a second. enabled = false switches it off.
Config.ScreenShake = {
	enabled = true,
	start = 0.35, -- studs of wobble when the shower starts
	meteor = 0.3, -- studs of wobble for a meteor landing right next to you
	radius = 80, -- meteors farther away than this don't shake the screen
	max = 0.45, -- never more than this, however many land at once
	decay = 6, -- how fast it settles (higher = shorter)
	speed = 18, -- how fast it wobbles
}

-- Black Hole Night: the lights go out and the Void Creeper roams; hide in a locker. Set to false to switch it off.
Config.BlackHoleNight = true
Config.NightFirst = 360 -- seconds until the first one
Config.NightEvery = 480 -- then every 8 minutes
Config.NightSeconds = 60
Config.CreeperSpeed = 13 -- a little slower than a player (16), so you can always get away
Config.CreeperReach = 5

function Config.critterById(id)
	for _, c in ipairs(Config.Critters) do
		if c.id == id then
			return c
		end
	end
	return nil
end

function Config.mutationById(id)
	for _, m in ipairs(Config.Mutations) do
		if m.id == id then
			return m
		end
	end
	return nil
end

-- a saved critter is "cometcat" or "cometcat:golden"
function Config.keyOf(defId, mutId)
	return mutId and (defId .. ":" .. mutId) or defId
end

function Config.fromKey(key)
	if typeof(key) ~= "string" then
		return nil, nil
	end
	local id, mutId = key:match("^([%w_]+):?([%w_]*)$")
	local def = id and Config.critterById(id)
	if not def then
		return nil, nil
	end
	local mut = (mutId and mutId ~= "") and Config.mutationById(mutId) or nil
	if mutId and mutId ~= "" and not mut then
		return nil, nil
	end
	return def, mut
end

-- the name, price and income of a critter with its mutation
function Config.statsOf(def, mut)
	local name = mut and (mut.name .. " " .. def.name) or def.name
	local price = math.floor(def.price * (mut and mut.price or 1))
	local income = math.floor(def.income * (mut and mut.income or 1))
	return name, price, income
end

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">CritterModels</string>
          <string name="Source"><![CDATA[-- Builds each space critter out of simple shapes (no imported meshes needed), so every critter is code you can change.
local Config = require(script.Parent.Config)

local CritterModels = {}

local function newPart(model, body, name, size, color, offset, opts)
	opts = opts or {}
	local p = Instance.new(opts.wedge and "WedgePart" or "Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = opts.material or Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Anchored = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if opts.ball then
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p
	elseif opts.cylinder then
		p.Shape = Enum.PartType.Cylinder
	end
	p.CFrame = body.CFrame * offset
	local w = Instance.new("WeldConstraint")
	w.Part0 = body
	w.Part1 = p
	w.Parent = p
	p.Parent = model
	return p
end

-- front of a critter faces -Z (Roblox's LookVector)
local function addEyes(model, body, s, spread, height, depth, def)
	local iris = def and def.eyeColor -- real cats (Hammy, Zuzu): coloured eyes with a slit pupil
	for _, side in ipairs({ -1, 1 }) do
		newPart(model, body, "Eye", Vector3.new(0.75, 0.85, 0.4) * s, iris or Color3.new(1, 1, 1),
			CFrame.new(side * spread * s, height * s, -depth * s), { ball = true })
		newPart(model, body, "Pupil", (iris and Vector3.new(0.18, 0.6, 0.25) or Vector3.new(0.4, 0.5, 0.25)) * s, Config.Colors.Dark,
			CFrame.new(side * spread * s, height * s, -(depth + 0.17) * s), { ball = true })
	end
end

-- a spot on the round body's surface: yaw turns from the front (-Z) around to the sides, pitch climbs toward the top.
-- The part's local Y runs up the head and local Z is the thin direction, so flat markings lie on the fur (2026-10-18)
local function onHead(s, yaw, pitch, lift)
	return CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0) * CFrame.new(0, 0, -(1.5 + (lift or 0)) * s)
end

local SHAPES = {}

function SHAPES.blob(model, body, def, s)
	addEyes(model, body, s, 0.45, 0.25, 1.25)
end

function SHAPES.bunny(model, body, def, s)
	addEyes(model, body, s, 0.45, 0.3, 1.3)
	for _, side in ipairs({ -1, 1 }) do
		newPart(model, body, "Ear", Vector3.new(0.55, 2.2, 0.35) * s, def.body, CFrame.new(side * 0.5 * s, 2.1 * s, 0) * CFrame.Angles(0, 0, side * -0.15), { ball = true })
		newPart(model, body, "EarInner", Vector3.new(0.3, 1.7, 0.2) * s, def.accent, CFrame.new(side * 0.5 * s, 2.1 * s, -0.1 * s) * CFrame.Angles(0, 0, side * -0.15), { ball = true })
	end
	newPart(model, body, "Tail", Vector3.new(0.9, 0.9, 0.9) * s, Color3.new(1, 1, 1), CFrame.new(0, -0.4 * s, 1.5 * s), { ball = true })
end

function SHAPES.cat(model, body, def, s)
	addEyes(model, body, s, 0.45, 0.3, 1.3, def)
	for _, side in ipairs({ -1, 1 }) do
		newPart(model, body, "Ear", Vector3.new(0.3, 1.0, 0.9) * s, def.earColor or def.body, CFrame.new(side * 0.75 * s, 1.55 * s, -0.2 * s) * CFrame.Angles(0, math.rad(90 * side), 0), { wedge = true }) -- mirrored, so both ears slope outward
	end
	if def.muzzle then -- a white chin and muzzle (Hammy)
		newPart(model, body, "Muzzle", Vector3.new(1.1, 0.7, 0.5) * s, def.muzzle, CFrame.new(0, -0.35 * s, -1.38 * s), { ball = true })
	end
	if def.chest then -- a fluffy chest ruff (Zuzu)
		newPart(model, body, "Chest", Vector3.new(2.0, 1.6, 1.0) * s, def.chest, CFrame.new(0, -0.75 * s, -1.05 * s), { ball = true })
	end
	if def.cap then -- the coloured patch and stripes on top of the head (Zuzu)
		-- a smaller ball sunk into the head, peeking out on top: a patch that follows the curve instead of sitting on it like a hat
		local up = CFrame.Angles(math.rad(-28), 0, 0) -- leaning toward the forehead
		newPart(model, body, "Cap", Vector3.new(2.6, 2.6, 2.6) * s, def.cap, up * CFrame.new(0, 0.26 * s, 0), { ball = true })
		for i, yaw in ipairs({ -0.22, 0, 0.22 }) do
			newPart(model, body, "CapStripe" .. i, Vector3.new(0.13, 0.6, 0.1) * s, def.capStripe or def.accent, onHead(s, yaw, math.rad(42), 0.05), { ball = true })
		end
	end
	newPart(model, body, "Nose", Vector3.new(0.35, 0.25, 0.2) * s, Color3.fromRGB(255, 160, 175), CFrame.new(0, -0.05 * s, -1.55 * s), { ball = true })
	local tailAt = CFrame.new(0, 0.5 * s, 1.9 * s) * CFrame.Angles(0, math.rad(90), math.rad(-55))
	newPart(model, body, "Tail", Vector3.new(2.6, 0.45, 0.45) * s, def.tailColor or def.accent, tailAt, { cylinder = true })
	if def.tailStripes then -- dark rings down the tail (Hammy)
		for i = -1, 1 do
			-- offsets are relative to the body (was tail.CFrame * ..., which put the rings far from Hammy away from the origin)
			newPart(model, body, "TailRing", Vector3.new(0.25, 0.5, 0.5) * s, def.accent, tailAt * CFrame.new(i * 0.7 * s, 0, 0), { cylinder = true })
		end
	end
	if def.stripes then -- tabby markings drawn flat on the fur (2026-10-18; were blocks standing up off the head)
		for i, yaw in ipairs({ -0.42, 0, 0.42 }) do -- stripes running back over the top of the head
			newPart(model, body, "Stripe" .. i, Vector3.new(0.2, 0.95, 0.1) * s, def.accent, onHead(s, yaw, math.rad(62)), { ball = true })
		end
		for _, side in ipairs({ -1, 1 }) do -- a pair of cheek stripes on each side
			for j, pitch in ipairs({ 0.05, -0.2 }) do
				newPart(model, body, "Cheek" .. j, Vector3.new(0.14, 0.7, 0.1) * s, def.accent,
					onHead(s, side * -1.05, pitch) * CFrame.Angles(0, 0, math.rad(90 + side * 10)), { ball = true })
			end
		end
		for i, side in ipairs({ -1, 1 }) do -- the little "M" on a tabby's forehead
			newPart(model, body, "Brow" .. i, Vector3.new(0.12, 0.5, 0.1) * s, def.accent, onHead(s, side * -0.16, math.rad(36)) * CFrame.Angles(0, 0, side * 0.45), { ball = true })
		end
	end
end

function SHAPES.pup(model, body, def, s)
	addEyes(model, body, s, 0.45, 0.35, 1.3)
	newPart(model, body, "Snout", Vector3.new(1.0, 0.7, 0.8) * s, def.accent, CFrame.new(0, -0.2 * s, -1.45 * s), { ball = true })
	newPart(model, body, "Nose", Vector3.new(0.35, 0.25, 0.2) * s, Config.Colors.Dark, CFrame.new(0, -0.05 * s, -1.85 * s), { ball = true })
	for _, side in ipairs({ -1, 1 }) do
		newPart(model, body, "Ear", Vector3.new(0.45, 1.4, 0.7) * s, def.accent, CFrame.new(side * 1.25 * s, 0.6 * s, -0.1 * s) * CFrame.Angles(0, 0, side * 0.25), { ball = true })
	end
	newPart(model, body, "Tail", Vector3.new(1.4, 0.4, 0.4) * s, def.body, CFrame.new(0, 0.6 * s, 1.6 * s) * CFrame.Angles(0, math.rad(90), math.rad(-40)), { cylinder = true })
end

function SHAPES.alien(model, body, def, s)
	addEyes(model, body, s, 0.45, 0.3, 1.25)
	newPart(model, body, "Antenna", Vector3.new(1.4, 0.15, 0.15) * s, def.accent, CFrame.new(0, 2.0 * s, 0) * CFrame.Angles(0, 0, math.rad(90)), { cylinder = true })
	local tip = newPart(model, body, "AntennaTip", Vector3.new(0.5, 0.5, 0.5) * s, def.accent, CFrame.new(0, 2.75 * s, 0), { ball = true, material = Enum.Material.Neon })
	local light = Instance.new("PointLight")
	light.Color = def.accent
	light.Range = 8
	light.Brightness = 1.5
	light.Parent = tip
end

function SHAPES.bear(model, body, def, s)
	addEyes(model, body, s, 0.45, 0.35, 1.3)
	newPart(model, body, "Snout", Vector3.new(1.0, 0.7, 0.6) * s, def.accent, CFrame.new(0, -0.25 * s, -1.4 * s), { ball = true })
	for _, side in ipairs({ -1, 1 }) do
		newPart(model, body, "Ear", Vector3.new(0.8, 0.8, 0.4) * s, def.body, CFrame.new(side * 0.95 * s, 1.35 * s, 0), { ball = true })
	end
	newPart(model, body, "Star", Vector3.new(0.6, 0.6, 0.15) * s, def.accent, CFrame.new(0, -0.7 * s, -1.38 * s), { ball = true, material = Enum.Material.Neon })
end

function SHAPES.dragon(model, body, def, s)
	addEyes(model, body, s, 0.45, 0.35, 1.3)
	for _, side in ipairs({ -1, 1 }) do
		newPart(model, body, "Horn", Vector3.new(0.25, 1.0, 0.25) * s, def.accent, CFrame.new(side * 0.55 * s, 1.6 * s, 0.1 * s) * CFrame.Angles(0, 0, side * -0.3))
		newPart(model, body, "Wing", Vector3.new(2.2, 0.15, 1.4) * s, def.accent, CFrame.new(side * 2.0 * s, 0.6 * s, 0.4 * s) * CFrame.Angles(0, 0, side * 0.45), { material = Enum.Material.Neon })
	end
	newPart(model, body, "Tail", Vector3.new(2.4, 0.5, 0.5) * s, def.body, CFrame.new(0, -0.2 * s, 2.0 * s) * CFrame.Angles(0, math.rad(90), math.rad(-15)), { cylinder = true })
end

-- wave 3 body types (2026-10-18): jellyfish, robot, bird, turtle, octopus
function SHAPES.jelly(model, body, def, s)
	addEyes(model, body, s, 0.42, 0.35, 1.25)
	newPart(model, body, "Rim", Vector3.new(3.4, 0.5, 3.4) * s, def.accent, CFrame.new(0, -0.6 * s, 0), { ball = true })
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		local x, z = math.cos(a) * 0.9 * s, math.sin(a) * 0.9 * s
		newPart(model, body, "Tentacle", Vector3.new(2.2, 0.3, 0.3) * s, def.accent, CFrame.new(x, -1.7 * s, z) * CFrame.Angles(0, 0, math.rad(90 + (i % 2 == 0 and 8 or -8))), { cylinder = true })
		newPart(model, body, "TentacleTip", Vector3.new(0.4, 0.4, 0.4) * s, def.glow or def.accent, CFrame.new(x, -2.8 * s, z), { ball = true, material = Enum.Material.Neon })
	end
end

function SHAPES.robot(model, body, def, s)
	body.Transparency = 1 -- the robot is all box: the round body only carries it
	newPart(model, body, "Chassis", Vector3.new(2.8, 2.6, 2.4) * s, def.body, CFrame.new(0, 0, 0), { material = Enum.Material.Metal })
	newPart(model, body, "Visor", Vector3.new(2.2, 1.1, 0.2) * s, Config.Colors.Dark, CFrame.new(0, 0.45 * s, -1.22 * s))
	for _, side in ipairs({ -1, 1 }) do
		newPart(model, body, "EyeLight", Vector3.new(0.45, 0.45, 0.15) * s, def.accent, CFrame.new(side * 0.5 * s, 0.45 * s, -1.34 * s), { ball = true, material = Enum.Material.Neon })
		newPart(model, body, "Arm", Vector3.new(0.5, 1.6, 0.5) * s, def.accent, CFrame.new(side * 1.65 * s, -0.2 * s, 0) * CFrame.Angles(0, 0, side * 0.25), { material = Enum.Material.Metal })
		newPart(model, body, "Foot", Vector3.new(0.9, 0.5, 1.2) * s, def.accent, CFrame.new(side * 0.7 * s, -1.5 * s, 0), { material = Enum.Material.Metal })
	end
	newPart(model, body, "Antenna", Vector3.new(1.2, 0.15, 0.15) * s, def.accent, CFrame.new(0, 1.8 * s, 0) * CFrame.Angles(0, 0, math.rad(90)), { cylinder = true })
	newPart(model, body, "AntennaTip", Vector3.new(0.45, 0.45, 0.45) * s, def.glow or def.accent, CFrame.new(0, 2.45 * s, 0), { ball = true, material = Enum.Material.Neon })
	newPart(model, body, "Badge", Vector3.new(0.7, 0.7, 0.12) * s, def.glow or Config.Colors.Orange, CFrame.new(0, -0.6 * s, -1.24 * s), { ball = true, material = Enum.Material.Neon })
end

function SHAPES.bird(model, body, def, s)
	addEyes(model, body, s, 0.45, 0.4, 1.28)
	newPart(model, body, "Beak", Vector3.new(0.5, 0.6, 0.8) * s, Color3.fromRGB(255, 170, 60), CFrame.new(0, 0.0, -1.6 * s) * CFrame.Angles(math.rad(90), 0, 0), { wedge = true })
	for _, side in ipairs({ -1, 1 }) do
		newPart(model, body, "Wing", Vector3.new(0.5, 1.8, 2.0) * s, def.accent, CFrame.new(side * 1.5 * s, 0, 0.2 * s) * CFrame.Angles(0, 0, side * 0.35), { ball = true })
		newPart(model, body, "Foot", Vector3.new(0.6, 0.25, 0.7) * s, Color3.fromRGB(255, 170, 60), CFrame.new(side * 0.5 * s, -1.5 * s, -0.2 * s), { ball = true })
	end
	newPart(model, body, "Tuft", Vector3.new(0.4, 1.0, 0.4) * s, def.accent, CFrame.new(0, 1.7 * s, -0.2 * s) * CFrame.Angles(math.rad(-20), 0, 0), { ball = true })
end

function SHAPES.turtle(model, body, def, s)
	-- the round body is the shell; a head pokes out the front
	newPart(model, body, "ShellRim", Vector3.new(3.5, 0.6, 3.5) * s, def.accent, CFrame.new(0, -0.7 * s, 0), { ball = true })
	for i, x in ipairs({ -0.7, 0, 0.7 }) do
		newPart(model, body, "ShellSpot" .. i, Vector3.new(0.8, 0.3, 0.8) * s, def.accent, CFrame.new(x * s, 1.38 * s - math.abs(x) * 0.25 * s, 0.1 * s), { ball = true })
	end
	local skin = def.glow or Color3.fromRGB(150, 210, 140)
	newPart(model, body, "Head", Vector3.new(1.4, 1.3, 1.4) * s, skin, CFrame.new(0, -0.2 * s, -1.9 * s), { ball = true })
	for _, side in ipairs({ -1, 1 }) do
		newPart(model, body, "Eye", Vector3.new(0.45, 0.5, 0.3) * s, Color3.new(1, 1, 1), CFrame.new(side * 0.32 * s, 0.05 * s, -2.5 * s), { ball = true })
		newPart(model, body, "Pupil", Vector3.new(0.25, 0.3, 0.2) * s, Config.Colors.Dark, CFrame.new(side * 0.32 * s, 0.05 * s, -2.62 * s), { ball = true })
		for _, fz in ipairs({ -0.9, 0.9 }) do
			newPart(model, body, "Leg", Vector3.new(0.8, 0.6, 0.8) * s, skin, CFrame.new(side * 1.3 * s, -1.0 * s, fz * s), { ball = true })
		end
	end
end

function SHAPES.octo(model, body, def, s)
	addEyes(model, body, s, 0.45, 0.2, 1.25)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local p = dir * 1.5 * s + Vector3.new(0, -1.3 * s, 0)
		newPart(model, body, "Arm", Vector3.new(0.55, 0.45, 1.8) * s, def.accent, CFrame.lookAt(p, p + dir) * CFrame.Angles(math.rad(-15), 0, 0), { ball = true })
	end
	newPart(model, body, "Spot", Vector3.new(0.7, 0.5, 0.15) * s, def.glow or def.accent, CFrame.new(0.6 * s, 1.0 * s, -1.0 * s), { ball = true, material = Enum.Material.Neon })
end

-- Nolan's own (2026-10-18, from photos of his toys): Matt the alien plush and Sunny Sprout the sunflower plush
function SHAPES.matt(model, body, def, s)
	-- big pale almond eyes with a light-green outline
	for _, side in ipairs({ -1, 1 }) do
		local tilt = CFrame.Angles(0, 0, side * math.rad(-28))
		newPart(model, body, "EyeRim", Vector3.new(1.15, 0.8, 0.3) * s, def.glow, CFrame.new(side * 0.6 * s, 0.35 * s, -1.28 * s) * tilt, { ball = true, material = Enum.Material.Neon })
		newPart(model, body, "Eye", Vector3.new(1.0, 0.68, 0.3) * s, def.accent, CFrame.new(side * 0.6 * s, 0.35 * s, -1.36 * s) * tilt, { ball = true })
	end
	newPart(model, body, "Smile", Vector3.new(0.5, 0.07, 0.08) * s, Config.Colors.Dark, CFrame.new(0, -0.25 * s, -1.47 * s))
	newPart(model, body, "Belly", Vector3.new(1.6, 1.4, 0.5) * s, def.accent, CFrame.new(0, -0.75 * s, -1.15 * s), { ball = true })
	for _, side in ipairs({ -1, 1 }) do
		newPart(model, body, "HeadBump", Vector3.new(0.55, 0.6, 0.55) * s, def.accent, CFrame.new(side * 0.85 * s, 1.35 * s, 0), { ball = true })
		newPart(model, body, "Arm", Vector3.new(0.6, 1.2, 0.6) * s, def.body, CFrame.new(side * 1.5 * s, -0.4 * s, -0.1 * s) * CFrame.Angles(0, 0, side * 0.5), { ball = true })
		newPart(model, body, "Foot", Vector3.new(0.9, 0.7, 1.0) * s, def.body, CFrame.new(side * 0.65 * s, -1.4 * s, -0.4 * s), { ball = true })
	end
end

function SHAPES.sunflower(model, body, def, s)
	-- the round body is the lime-green plush; the flower head sits on top of it
	local head = CFrame.new(0, 2.3 * s, -0.7 * s) -- up and forward, so the body no longer hides the bottom of the face (2026-10-18)
	newPart(model, body, "FaceRim", Vector3.new(0.5, 2.5, 2.5) * s, def.rim or Color3.fromRGB(130, 70, 50), head * CFrame.Angles(0, math.rad(90), 0), { cylinder = true })
	newPart(model, body, "Face", Vector3.new(0.55, 2.0, 2.0) * s, def.face or Color3.fromRGB(215, 145, 115), head * CFrame.new(0, 0, -0.05 * s) * CFrame.Angles(0, math.rad(90), 0), { cylinder = true })
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2
		local p = Vector3.new(math.cos(a), math.sin(a), 0) * 1.65 * s
		newPart(model, body, "Petal", Vector3.new(0.9, 1.3, 0.3) * s, def.accent, head * CFrame.new(p) * CFrame.Angles(0, 0, a - math.pi / 2), { ball = true })
	end
	for _, side in ipairs({ -1, 1 }) do
		newPart(model, body, "Eye", Vector3.new(0.28, 0.28, 0.12) * s, Config.Colors.Dark, head * CFrame.new(side * 0.4 * s, 0.25 * s, -0.33 * s), { ball = true })
		newPart(model, body, "Arm", Vector3.new(0.5, 1.0, 0.5) * s, def.body, CFrame.new(side * 1.45 * s, -0.2 * s, 0) * CFrame.Angles(0, 0, side * 0.6), { ball = true })
		newPart(model, body, "Foot", Vector3.new(0.95, 0.75, 1.1) * s, def.body, CFrame.new(side * 0.65 * s, -1.4 * s, -0.4 * s), { ball = true })
	end
	newPart(model, body, "Smile", Vector3.new(0.55, 0.07, 0.08) * s, Config.Colors.Dark, head * CFrame.new(0, -0.15 * s, -0.33 * s))
end

function CritterModels.scaleFor(def)
	local order = Config.Rarities[def.rarity].order
	return 0.8 + (order - 1) * 0.22
end

-- returns a Model whose PrimaryPart ("Body") is anchored at `cframe`; every other part is welded to it
-- mut (optional): a Config.Mutations entry; Golden repaints the critter gold, Rainbow is colour-cycled on each screen
function CritterModels.build(def, cframe, mut)
	local s = CritterModels.scaleFor(def)
	local model = Instance.new("Model")
	model.Name = mut and (mut.name .. " " .. def.name) or def.name
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Shape = Enum.PartType.Ball
	body.Size = Vector3.new(3, 3, 3) * s
	body.Color = def.body
	body.Material = Enum.Material.SmoothPlastic
	body.TopSurface = Enum.SurfaceType.Smooth
	body.BottomSurface = Enum.SurfaceType.Smooth
	body.Anchored = true
	body.CanCollide = false
	body.CanTouch = false
	body.CFrame = cframe
	body.Parent = model
	model.PrimaryPart = body
	;(SHAPES[def.shape] or SHAPES.blob)(model, body, def, s)

	if def.material then -- Nolan's plush toys look fuzzy: Fabric on everything but the eyes, smile and glowing bits
		local skip = { Eye = true, Pupil = true, Smile = true, Nose = true }
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") and not skip[p.Name] and p.Material ~= Enum.Material.Neon then
				p.Material = Enum.Material[def.material]
			end
		end
	end

	local rarity = Config.Rarities[def.rarity]
	if rarity.order >= 4 then -- Legendary and Cosmic glow
		local light = Instance.new("PointLight")
		light.Color = def.glow or rarity.color
		light.Range = 14
		light.Brightness = 2
		light.Parent = body
		local sparkle = Instance.new("ParticleEmitter")
		sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		sparkle.Color = ColorSequence.new(def.glow or rarity.color)
		-- a third fewer sparkles than before (2026-10-25, lag on the iPad: every base full of Legendaries added up)
		sparkle.Rate = def.rarity == "Cosmic" and 12 or (def.rarity == "Mythic" and 8 or 5)
		sparkle.Lifetime = NumberRange.new(0.8, 1.4)
		sparkle.Speed = NumberRange.new(1, 3)
		sparkle.Size = NumberSequence.new(0.35)
		sparkle.LightEmission = 1
		sparkle.Parent = body
	end

	local tag = Instance.new("BillboardGui")
	tag.Name = "Tag"
	tag.Size = UDim2.fromOffset(220, 60)
	tag.StudsOffsetWorldSpace = Vector3.new(0, (def.shape == "sunflower" and 4.9 or 2.6) * s + 1.5, 0) -- clear of Sunny Sprout's petals
	tag.AlwaysOnTop = false
	tag.MaxDistance = 80
	tag.Parent = body
	local nameL = Instance.new("TextLabel")
	nameL.Name = "CritterName"
	nameL.Size = UDim2.new(1, 0, 0.55, 0)
	nameL.BackgroundTransparency = 1
	nameL.Font = Enum.Font.FredokaOne
	nameL.TextScaled = true
	nameL.TextColor3 = rarity.color
	nameL.TextStrokeTransparency = 0.3
	nameL.Text = model.Name
	nameL.Parent = tag
	local infoL = Instance.new("TextLabel")
	infoL.Name = "Info"
	infoL.Position = UDim2.new(0, 0, 0.55, 0)
	infoL.Size = UDim2.new(1, 0, 0.45, 0)
	infoL.BackgroundTransparency = 1
	infoL.Font = Enum.Font.GothamBold
	infoL.TextScaled = true
	infoL.TextColor3 = Color3.new(1, 1, 1)
	infoL.TextStrokeTransparency = 0.4
	infoL.Text = def.rarity
	infoL.Parent = tag

	model:SetAttribute("CritterId", def.id)

	if mut then
		model:SetAttribute("Mutation", mut.id)
		local keep = { Eye = true, Pupil = true, Nose = true, Smile = true }
		if mut.id == "golden" then
			for _, p in ipairs(model:GetDescendants()) do
				if p:IsA("BasePart") and not keep[p.Name] then
					p.Color = (p == body) and mut.color or mut.color:Lerp(Color3.fromRGB(200, 140, 30), 0.35)
					p.Material = Enum.Material.Foil
				end
			end
			nameL.TextColor3 = mut.color
		elseif mut.id == "rainbow" then
			model:SetAttribute("Rainbow", true) -- FX.client.lua cycles the colours
		end
		local shine = Instance.new("ParticleEmitter")
		shine.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		shine.Color = mut.id == "rainbow" and ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 120, 120)),
			ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 230, 120)),
			ColorSequenceKeypoint.new(0.66, Color3.fromRGB(120, 220, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 140, 255)),
		}) or ColorSequence.new(mut.color)
		shine.Rate = 7 -- was 10 (2026-10-25, lag on the iPad)
		shine.Lifetime = NumberRange.new(0.6, 1.2)
		shine.Speed = NumberRange.new(0.5, 2)
		shine.Size = NumberSequence.new(0.3)
		shine.LightEmission = 1
		shine.Parent = body
	end
	return model
end

function CritterModels.setInfo(model, text)
	local body = model.PrimaryPart
	local tag = body and body:FindFirstChild("Tag")
	local info = tag and tag:FindFirstChild("Info")
	if info then
		info.Text = text
	end
end

-- a third line on the name tag, in green: the Stardust it earns every second once it's in your base (2026-10-25, Nolan
-- wanted to see it on the launch pad belt). Main.server.lua passes the number the income loop pays (Config.statsOf), so
-- the tag and the payout can't disagree. Stays on while the critter is carried over your head.
local RATE_GREEN = Color3.fromRGB(140, 255, 170)
function CritterModels.setRate(model, text)
	local body = model.PrimaryPart
	local tag = body and body:FindFirstChild("Tag")
	if not tag then
		return
	end
	local rate = tag:FindFirstChild("Rate")
	if not rate then
		tag.Size = UDim2.fromOffset(220, 88) -- was 60 high: name and price keep the same size, the new line goes under them
		local nameL, info = tag:FindFirstChild("CritterName"), tag:FindFirstChild("Info")
		if nameL then
			nameL.Size = UDim2.new(1, 0, 0.4, 0)
		end
		if info then
			info.Position = UDim2.new(0, 0, 0.4, 0)
			info.Size = UDim2.new(1, 0, 0.3, 0)
		end
		rate = Instance.new("TextLabel")
		rate.Name = "Rate"
		rate.Position = UDim2.new(0, 0, 0.7, 0)
		rate.Size = UDim2.new(1, 0, 0.3, 0)
		rate.BackgroundTransparency = 1
		rate.Font = Enum.Font.GothamBold
		rate.TextScaled = true
		rate.TextColor3 = RATE_GREEN
		rate.TextStrokeTransparency = 0.3
		rate.Parent = tag
	end
	rate.Text = text
end

return CritterModels
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="4">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="5">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Decor</string>
          <string name="Source"><![CDATA[-- The station's looks (2026-10-18, Matthew: "it didn't look like much in a sense of the walls and the overall station"):
-- a hangar shell with windows and a roof frame, a glass dome over the launch pad, deck plating, proper hangar bases,
-- props (rocket, fuel tanks, crates, satellite dish), a hologram planet, and asteroids outside.
-- Anything with a "SpinSpeed" attribute is turned by the player's own screen (Spin.client.lua), so it costs the server nothing.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local Config = require(ReplicatedStorage.Shared.Config)

local C = Config.Colors
local METAL = Color3.fromRGB(140, 148, 170) -- a little lighter (2026-10-18, Matthew: "a little brighter")
local METAL_DARK = Color3.fromRGB(84, 92, 116)
local HAZARD = Color3.fromRGB(255, 196, 60)
-- the Gear Bay, Upgrade Lab and furniture shop were too bright (2026-10-25, Matthew: "the lighting is off there"): three
-- ceiling spotlights on a pale floor, white neon lamp panels and glowing stands made a hot spot. Now the floor matches the deck,
-- the lamps are a softer grey and the lights about half as strong; the coloured neon edges and rings still mark the shops.
local SHOP_FLOOR = Color3.fromRGB(138, 146, 170) -- was 176, 184, 204; the deck tiles are 150/136
local SHOP_LAMP = Color3.fromRGB(176, 184, 200) -- was C.Trim (232, 238, 248) neon
local SHOP_LIGHT = { brightness = 1.1, range = 20 } -- was 2.5 (Gear Bay) / 2.2 (shops), range 24
local STAND_GLOW = 0.8 -- the light inside each display stand, was 1.6 (Gear Bay) / 1.4 (Upgrade Lab)

local Decor = {}

local function part(parent, props)
	local p = Instance.new(props.ClassName or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.Metal
	p.CastShadow = true
	for k, v in pairs(props) do
		if k ~= "ClassName" then
			p[k] = v
		end
	end
	-- lag on the iPad (2026-10-25): glowing, see-through, small and paper-thin pieces cast no shadow. Nobody notices those shadows, but
	-- the tablet still draws every one. A piece can still ask for a shadow with CastShadow = true.
	if props.CastShadow == nil then
		local sz = props.Size
		if props.Material == Enum.Material.Neon or (props.Transparency or 0) > 0 or (sz and (math.max(sz.X, sz.Y, sz.Z) < 2 or math.min(sz.X, sz.Y, sz.Z) <= 0.3)) then
			p.CastShadow = false
		end
	end
	p.Parent = parent
	return p
end

local function glow(p, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range or 16
	l.Brightness = brightness or 1.5
	l.Parent = p
	return l
end

-- ---------- the hangar shell: walls with windows, pillars, roof beams ----------
local W, D, H = 460, 300, 34 -- deck size and wall height (bigger 2026-10-18: 8 bases)

local function wallRun(folder, from, to, inward)
	local len = (to - from).Magnitude
	local dir = (to - from).Unit
	local bays = math.floor(len / 24)
	local bay = len / bays
	for i = 0, bays do
		local at = from + dir * (i * bay)
		local pillar = part(folder, { Name = "Pillar", Size = Vector3.new(4, H, 4), Color = METAL_DARK, CFrame = CFrame.new(at + Vector3.new(0, H / 2, 0)) })
		part(folder, { Name = "PillarLight", Size = Vector3.new(4.4, 1, 4.4), Color = (i % 2 == 0) and C.Orange or C.Blue, Material = Enum.Material.Neon, CFrame = pillar.CFrame * CFrame.new(0, H / 2 - 2, 0) })
		part(folder, { Name = "PillarFoot", Size = Vector3.new(5.5, 1.2, 5.5), Color = METAL, CFrame = CFrame.new(at + Vector3.new(0, 0.6, 0)) })
		if i < bays then
			local mid = at + dir * (bay / 2)
			local face = CFrame.lookAt(mid, mid + inward)
			-- lower wall, big window, top band
			part(folder, { Name = "WallLow", Size = Vector3.new(bay - 4, 7, 2), Color = METAL, Material = Enum.Material.DiamondPlate, CFrame = face * CFrame.new(0, 3.5, 0) })
			part(folder, { Name = "WallStripe", Size = Vector3.new(bay - 4, 0.6, 2.2), Color = C.Orange, Material = Enum.Material.Neon, CFrame = face * CFrame.new(0, 6.8, 0) })
			part(folder, { Name = "Window", Size = Vector3.new(bay - 4, H - 14, 0.6), Color = C.Blue, Material = Enum.Material.Glass, Transparency = 0.82, CastShadow = false, CFrame = face * CFrame.new(0, 7 + (H - 14) / 2, 0) })
			part(folder, { Name = "WindowBar", Size = Vector3.new(0.8, H - 14, 1), Color = METAL_DARK, CFrame = face * CFrame.new(0, 7 + (H - 14) / 2, 0) })
			part(folder, { Name = "WallTop", Size = Vector3.new(bay - 4, 7, 2), Color = METAL_DARK, CFrame = face * CFrame.new(0, H - 3.5, 0) })
		end
	end
end

local function shell(folder)
	local hx, hz = W / 2, D / 2
	wallRun(folder, Vector3.new(-hx, 0, hz), Vector3.new(hx, 0, hz), Vector3.new(0, 0, -1))
	wallRun(folder, Vector3.new(-hx, 0, -hz), Vector3.new(hx, 0, -hz), Vector3.new(0, 0, 1))
	wallRun(folder, Vector3.new(hx, 0, -hz), Vector3.new(hx, 0, hz), Vector3.new(-1, 0, 0))
	wallRun(folder, Vector3.new(-hx, 0, -hz), Vector3.new(-hx, 0, hz), Vector3.new(1, 0, 0))
	-- no roof any more (2026-10-18, Matthew: "do away with the bars on the roof, maybe make it completely open"): the sky,
	-- planets and comets show straight overhead. The lights that hung from it are hovering light drones now.
	for _, x in ipairs({ -171, -57, 57, 171 }) do
		for _, z in ipairs({ -95, 95, -45, 45 }) do
			local m = Instance.new("Model")
			m.Name = "LightDrone"
			m.Parent = folder
			local disc = part(m, { Name = "DroneDisc", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.9, 6, 6), Color = METAL, CanCollide = false, CFrame = CFrame.new(x, H - 1, z) * CFrame.Angles(0, 0, math.rad(90)) })
			part(m, { Name = "DroneRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 6.4, 6.4), Color = (z > 0) and C.Orange or C.Blue, Material = Enum.Material.Neon, CanCollide = false,
				CFrame = CFrame.new(x, H - 1.4, z) * CFrame.Angles(0, 0, math.rad(90)) })
			local lamp = part(m, { Name = "Lamp", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 4, 4), Color = C.Trim, Material = Enum.Material.Neon, CanCollide = false,
				CFrame = CFrame.new(x, H - 1.55, z) * CFrame.Angles(0, 0, math.rad(90)) })
			local sl = Instance.new("SpotLight")
			sl.Face = Enum.NormalId.Left -- a quarter-turned cylinder's -X faces down
			sl.Range = 45
			sl.Angle = 80
			sl.Brightness = 2.2
			sl.Color = Color3.fromRGB(255, 240, 220)
			sl.Parent = lamp
			m.PrimaryPart = disc
			m:SetAttribute("Bob", 0.5)
		end
	end
	-- an invisible lid over the whole hangar, so nobody floats off into space in Low Gravity or with Jet Boots
	local lidY = 95
	part(folder, { Name = "SkyLid", Size = Vector3.new(W + 20, 2, D + 20), Transparency = 1, CanQuery = false, CastShadow = false, CFrame = CFrame.new(0, lidY, 0) })
	for _, spec in ipairs({ { Vector3.new(W + 20, lidY - H, 2), Vector3.new(0, 0, D / 2 + 1) }, { Vector3.new(W + 20, lidY - H, 2), Vector3.new(0, 0, -D / 2 - 1) },
		{ Vector3.new(2, lidY - H, D + 20), Vector3.new(W / 2 + 1, 0, 0) }, { Vector3.new(2, lidY - H, D + 20), Vector3.new(-W / 2 - 1, 0, 0) } }) do
		part(folder, { Name = "SkyWall", Size = spec[1], Transparency = 1, CanQuery = false, CastShadow = false, CFrame = CFrame.new(spec[2] + Vector3.new(0, H + (lidY - H) / 2, 0)) })
	end
end

-- ---------- the deck: real floor tiles and walkways (2026-10-18, Matthew: "flooring needs to actually be floor") ----------
local TILE_A, TILE_B = Color3.fromRGB(150, 158, 182), Color3.fromRGB(136, 144, 168) -- lighter deck (2026-10-18)
local WALK = Color3.fromRGB(196, 204, 222)

local function plating(folder)
	local tiles = Instance.new("Folder")
	tiles.Name = "FloorTiles"
	tiles.Parent = folder
	local n = 0
	for x = -W / 2 + 10, W / 2 - 10, 20 do
		for z = -D / 2 + 10, D / 2 - 10, 20 do
			n += 1
			local tile = part(tiles, { Name = "Tile", Size = Vector3.new(19.6, 0.2, 19.6), Color = (n % 2 == 0) and TILE_A or TILE_B, Material = Enum.Material.Plastic, CastShadow = false, CFrame = CFrame.new(x, 0.1, z) }) -- matte Plastic, not shiny Metal (2026-10-18)
			if (math.floor(x / 20) + math.floor(z / 20)) % 3 == 0 then -- a few tiles carry a grille panel
				part(tiles, { Name = "Grille", Size = Vector3.new(6, 0.05, 6), Color = METAL_DARK, Material = Enum.Material.DiamondPlate, CanCollide = false, CastShadow = false, CFrame = tile.CFrame * CFrame.new(0, 0.12, 0) })
			end
		end
	end
	-- walkways: spawn to the tunnel, along both sides of it, and out to every base
	local function walk(a, b, width)
		local mid, len = (a + b) / 2, (b - a).Magnitude
		local cf = CFrame.lookAt(mid, b)
		part(folder, { Name = "Walkway", Size = Vector3.new(width, 0.15, len), Color = WALK, Material = Enum.Material.Plastic, CastShadow = false, CFrame = cf * CFrame.new(0, 0.28, 0) })
		for _, side in ipairs({ -1, 1 }) do
			part(folder, { Name = "WalkEdge", Size = Vector3.new(0.5, 0.17, len), Color = C.Orange, Material = Enum.Material.Neon, CastShadow = false, CFrame = cf * CFrame.new(side * (width / 2 - 0.25), 0.3, 0) })
		end
	end
	walk(Vector3.new(-145, 0, 0), Vector3.new(-80, 0, 0), 12) -- from the rocket pad past the spawn to the tunnel mouth
	walk(Vector3.new(80, 0, 0), Vector3.new(110, 0, 0), 12)
	for _, z in ipairs({ -22, 22 }) do
		walk(Vector3.new(-205, 0, z), Vector3.new(205, 0, z), 8)
	end
	for _, x in ipairs({ -171, -57, 57, 171 }) do
		walk(Vector3.new(x, 0, 26), Vector3.new(x, 0, 71), 10)
		walk(Vector3.new(x, 0, -26), Vector3.new(x, 0, -71), 10)
	end
end

-- ---------- the launch tunnel (2026-10-18, Matthew: "tunnel needs to be developed more") ----------
-- a glass tube on metal ribs over a moving belt, a glowing portal the critters come out of, and a chute they drop into
local TUNNEL_R = 13

local function rib(folder, x, color)
	local segs = 9
	for i = 0, segs - 1 do -- a half-circle of short beams from one side of the belt, over the top, to the other
		local a0, a1 = math.pi * i / segs, math.pi * (i + 1) / segs
		local p0 = Vector3.new(x, math.sin(a0) * TUNNEL_R, math.cos(a0) * TUNNEL_R)
		local p1 = Vector3.new(x, math.sin(a1) * TUNNEL_R, math.cos(a1) * TUNNEL_R)
		part(folder, { Name = "Rib", Size = Vector3.new(1.4, 1.4, (p1 - p0).Magnitude + 0.5), Color = METAL_DARK, CanCollide = false, CFrame = CFrame.lookAt((p0 + p1) / 2, p1) })
		part(folder, { Name = "RibLight", Size = Vector3.new(0.4, 0.4, (p1 - p0).Magnitude * 0.7), Color = color, Material = Enum.Material.Neon, CanCollide = false, CastShadow = false,
			CFrame = CFrame.lookAt((p0 + p1) / 2, p1) * CFrame.new(0, -0.8, 0) })
	end
	for _, side in ipairs({ -1, 1 }) do -- feet where the rib meets the deck
		part(folder, { Name = "RibFoot", Size = Vector3.new(2.4, 1.6, 2.4), Color = METAL, CFrame = CFrame.new(x, 0.8, side * TUNNEL_R) })
	end
end

local function launchPad(folder)
	local tunnel = Instance.new("Folder")
	tunnel.Name = "Tunnel"
	tunnel.Parent = folder
	-- hazard edging either side of the belt
	for x = -66, 66, 4 do
		local color = ((x / 4) % 2 == 0) and HAZARD or C.Dark
		for _, z in ipairs({ -7.6, 7.6 }) do
			part(tunnel, { Name = "Hazard", Size = Vector3.new(4, 0.2, 1.6), Color = color, Material = Enum.Material.SmoothPlastic, CanCollide = false, CFrame = CFrame.new(x, 0.3, z) })
		end
	end
	-- the belt: rollers along each side and stripes that travel with the critters (Spin.client.lua moves them)
	for x = -64, 64, 2.5 do
		for _, z in ipairs({ -5.9, 5.9 }) do
			part(tunnel, { Name = "Roller", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 1, 1), Color = METAL, CanCollide = false, CastShadow = false, CFrame = CFrame.new(x, 1.2, z) * CFrame.Angles(0, math.rad(90), 0) })
		end
	end
	for x = -64, 63, 3 do
		local s = part(tunnel, { Name = "BeltStripe", Size = Vector3.new(0.5, 0.06, 10.6), Color = Color3.fromRGB(60, 66, 86), Material = Enum.Material.SmoothPlastic, CanCollide = false, CastShadow = false, CFrame = CFrame.new(x, 1.04, 0) })
		s:SetAttribute("Belt", true)
	end
	for x = -54, 54, 18 do -- chevrons pointing the way the belt moves
		for _, side in ipairs({ -1, 1 }) do
			part(tunnel, { Name = "Arrow", Size = Vector3.new(0.6, 0.12, 4.2), Color = C.Orange, Material = Enum.Material.Neon, CanCollide = false, CastShadow = false,
				CFrame = CFrame.new(x, 1.08, side * 1.4) * CFrame.Angles(0, side * math.rad(-40), 0) })
		end
	end
	-- the glass tube and its ribs
	part(tunnel, { Name = "TubeGlass", Shape = Enum.PartType.Cylinder, Size = Vector3.new(132, TUNNEL_R * 2, TUNNEL_R * 2), Color = C.Blue, Material = Enum.Material.Glass, Transparency = 0.88,
		CanCollide = false, CanQuery = false, CastShadow = false, CFrame = CFrame.new(0, 0, 0) })
	local n = 0
	for x = -64, 64, 8 do
		n += 1
		rib(tunnel, x, (n % 2 == 0) and C.Orange or C.Blue)
	end
	for _, z in ipairs({ -4, 4 }) do -- light strips along the top
		part(tunnel, { Name = "TopLight", Size = Vector3.new(128, 0.4, 0.6), Color = C.Trim, Material = Enum.Material.Neon, CanCollide = false, CastShadow = false, CFrame = CFrame.new(0, TUNNEL_R - 0.9, z) })
	end
	-- the portal the critters come out of
	local portalAt = CFrame.new(-69, 0, 0)
	part(tunnel, { Name = "PortalFrame", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, TUNNEL_R * 2 + 6, TUNNEL_R * 2 + 6), Color = METAL_DARK, CFrame = portalAt })
	part(tunnel, { Name = "PortalRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3.2, TUNNEL_R * 2 + 1, TUNNEL_R * 2 + 1), Color = C.Orange, Material = Enum.Material.Neon, CFrame = portalAt })
	local swirl = part(tunnel, { Name = "PortalSwirl", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3.4, TUNNEL_R * 2 - 2, TUNNEL_R * 2 - 2), Color = C.Blue, Material = Enum.Material.ForceField, CFrame = portalAt })
	swirl:SetAttribute("SpinSpeed", 0) -- ForceField material shimmers by itself
	glow(swirl, C.Blue, 30, 3)
	local spark = Instance.new("ParticleEmitter")
	spark.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	spark.Color = ColorSequence.new(C.Blue, C.Orange)
	spark.LightEmission = 1
	spark.Rate = 25
	spark.Speed = NumberRange.new(3, 8)
	spark.Lifetime = NumberRange.new(0.6, 1.2)
	spark.EmissionDirection = Enum.NormalId.Top
	spark.Size = NumberSequence.new(0.5, 0)
	spark.Parent = swirl
	-- the chute at the far end
	local chuteAt = CFrame.new(69, 0, 0)
	part(tunnel, { Name = "ChuteFrame", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, TUNNEL_R * 2 + 6, TUNNEL_R * 2 + 6), Color = METAL_DARK, CFrame = chuteAt })
	part(tunnel, { Name = "ChuteRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3.2, TUNNEL_R * 2 + 1, TUNNEL_R * 2 + 1), Color = C.Blue, Material = Enum.Material.Neon, CFrame = chuteAt })
	part(tunnel, { Name = "ChuteHole", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3.4, TUNNEL_R * 2 - 2, TUNNEL_R * 2 - 2), Color = C.Dark, Material = Enum.Material.SmoothPlastic, CFrame = chuteAt })
	-- the hologram planet, projected from the top of the tunnel
	local holo = part(folder, { Name = "HoloPlanet", Shape = Enum.PartType.Ball, Size = Vector3.new(9, 9, 9), Color = C.Blue, Material = Enum.Material.ForceField, CanCollide = false, CastShadow = false, CFrame = CFrame.new(0, TUNNEL_R + 9, 0) })
	holo:SetAttribute("SpinSpeed", 25)
	glow(holo, C.Blue, 24, 2)
	local ring = part(folder, { Name = "HoloRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 16, 16), Color = C.Orange, Material = Enum.Material.Neon, Transparency = 0.3, CanCollide = false, CastShadow = false, CFrame = CFrame.new(0, TUNNEL_R + 9, 0) * CFrame.Angles(0, 0, math.rad(80)) })
	ring:SetAttribute("SpinSpeed", -40)
	part(folder, { Name = "HoloBase", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.2, 7, 7), Color = METAL, CanCollide = false, CFrame = CFrame.new(0, TUNNEL_R + 0.4, 0) * CFrame.Angles(0, 0, math.rad(90)) })
	part(folder, { Name = "HoloBeam", Shape = Enum.PartType.Cylinder, Size = Vector3.new(5, 3, 3), Color = C.Blue, Material = Enum.Material.Neon, Transparency = 0.6, CanCollide = false, CastShadow = false, CFrame = CFrame.new(0, TUNNEL_R + 3.5, 0) * CFrame.Angles(0, 0, math.rad(90)) })
end

-- ---------- bases: pillars, a roof with light trim, an entrance arch, wall lights ----------
local function hangar(folder, base)
	local cf, hw, hd = base.cf, base.halfW, base.halfD
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			part(folder, { Name = "BasePillar", Size = Vector3.new(2.6, 16, 2.6), Color = METAL_DARK, CFrame = cf * CFrame.new(sx * (hw + 0.6), 8, sz * (hd + 0.6)) })
		end
	end
	-- a glass roof on a metal frame over the whole base, so you can still see in from above
	local RY = 16.2
	part(folder, { Name = "BaseRoofGlass", Size = Vector3.new(hw * 2 + 2, 0.4, hd * 2 + 2), Color = C.Blue, Material = Enum.Material.Glass, Transparency = 0.7, CastShadow = false, CFrame = cf * CFrame.new(0, RY, 0) })
	for _, sz in ipairs({ -1, 0, 1 }) do
		part(folder, { Name = "BaseRoofBeam", Size = Vector3.new(hw * 2 + 3, 1.2, 1.4), Color = METAL_DARK, CFrame = cf * CFrame.new(0, RY + 0.4, sz * hd) })
	end
	for _, sx in ipairs({ -1, -0.33, 0.33, 1 }) do
		part(folder, { Name = "BaseRoofBeam", Size = Vector3.new(1.4, 1.2, hd * 2 + 3), Color = METAL_DARK, CFrame = cf * CFrame.new(sx * hw, RY + 0.4, 0) })
	end
	part(folder, { Name = "BaseRoofEdge", Size = Vector3.new(hw * 2 + 3.4, 0.6, 0.8), Color = C.Orange, Material = Enum.Material.Neon, CFrame = cf * CFrame.new(0, RY - 0.2, -hd - 1) })
	for i = -2, 2 do -- strip lights under the roof
		local strip = part(folder, { Name = "BaseRoofLight", Size = Vector3.new(0.6, 0.3, hd * 2 - 4), Color = C.Blue, Material = Enum.Material.Neon, CastShadow = false, CFrame = cf * CFrame.new(i * 10, RY - 0.5, 0) })
		if i == 0 then
			glow(strip, C.Blue, 34, 1.3)
		end
	end
	-- the entrance arch
	for _, side in ipairs({ -1, 1 }) do
		part(folder, { Name = "ArchPost", Size = Vector3.new(2, 12, 2), Color = METAL_DARK, CFrame = cf * CFrame.new(side * 9.5, 6, -hd) })
		part(folder, { Name = "ArchLight", Size = Vector3.new(0.6, 10, 0.6), Color = C.Blue, Material = Enum.Material.Neon, CFrame = cf * CFrame.new(side * 9.5, 6, -hd - 1.1) })
	end
	part(folder, { Name = "ArchTop", Size = Vector3.new(21, 2.2, 2.4), Color = METAL_DARK, CFrame = cf * CFrame.new(0, 12.6, -hd) })
	local num = part(folder, { Name = "ArchSign", Size = Vector3.new(8, 1.8, 0.3), Color = C.Dark, CFrame = cf * CFrame.new(0, 12.6, -hd - 1.3) })
	local g = Instance.new("SurfaceGui")
	g.Face = Enum.NormalId.Front
	g.LightInfluence = 0
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = 40
	g.Parent = num
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = C.Orange
	l.Text = "BAY " .. base.index
	l.Parent = g
end

-- ---------- props ----------
-- a proper rocket (2026-10-18, Matthew: "the rockets there need to look more like rockets"): a tall white body with
-- black roll stripes, a pointed orange nose cone, swept fins, a flared engine bell, side boosters and a launch tower.
-- Everything stays under the hangar roof (34 studs). s scales the whole thing; full = boosters and tower too.
local function cylY(parent, name, at, y, h, r, color, props)
	local p = { Name = name, Shape = Enum.PartType.Cylinder, Size = Vector3.new(h, r * 2, r * 2), Color = color, Material = Enum.Material.SmoothPlastic,
		CFrame = at * CFrame.new(0, y, 0) * CFrame.Angles(0, 0, math.rad(90)) }
	for k, v in pairs(props or {}) do
		p[k] = v
	end
	return part(parent, p)
end

-- a pointed cone from stacked slices: base radius r at y0, rising h studs to a point
local function cone(parent, at, y0, h, r, color, slices)
	slices = slices or 10
	local sh = h / slices
	for i = 0, slices - 1 do
		local t = i / slices
		cylY(parent, "Cone", at, y0 + sh * (i + 0.5), sh + 0.02, math.max(0.15, r * (1 - t) ^ 0.75), color)
	end
end

local function flame(parent, scale)
	local f = Instance.new("ParticleEmitter")
	f.Color = ColorSequence.new(Color3.fromRGB(255, 230, 150), Color3.fromRGB(255, 110, 50))
	f.Texture = "rbxasset://textures/particles/fire_main.dds"
	f.LightEmission = 1
	f.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.6 * scale), NumberSequenceKeypoint.new(1, 0) })
	f.Lifetime = NumberRange.new(0.3, 0.6)
	f.Rate = 24 -- was 40 (2026-10-25, lag on the iPad); a launch still turns it up to 260
	f.Speed = NumberRange.new(5, 9)
	f.EmissionDirection = Enum.NormalId.Left -- a quarter-turned cylinder's -X points down
	f.Parent = parent
	return f
end

local function booster(m, at, s)
	local R = 1.6 * s
	cylY(m, "BoosterBody", at, 9 * s, 14 * s, R, C.Trim)
	cylY(m, "BoosterBand", at, 14 * s, 0.8 * s, R + 0.1, C.Orange)
	cone(m, at, 16 * s, 3.5 * s, R, C.Trim, 6)
	cylY(m, "BoosterNozzle", at, 1.4 * s, 1.2 * s, R * 0.75, METAL_DARK, { Material = Enum.Material.Metal })
	local n = cylY(m, "BoosterBell", at, 0.7 * s, 0.6 * s, R * 0.95, METAL_DARK, { Material = Enum.Material.Metal })
	flame(n, s * 0.7)
end

local function tower(m, at, s, rocketR)
	-- beside the rocket on its right, facing it (its -Z points at the rocket), so the name and windows on the front stay in view
	local towerPos = (at * CFrame.new(rocketR + 7 * s, 0, 0)).Position
	local base = CFrame.lookAt(towerPos, Vector3.new(at.Position.X, towerPos.Y, at.Position.Z))
	local h = 31 * s
	for _, x in ipairs({ -2.2, 2.2 }) do
		for _, z in ipairs({ -2.2, 2.2 }) do
			part(m, { Name = "TowerPost", Size = Vector3.new(0.7, h, 0.7), Color = Color3.fromRGB(230, 80, 60), CFrame = base * CFrame.new(x * s, h / 2, z * s) })
		end
	end
	for y = 3, h - 1, 4 * s do -- criss-cross bracing on every face
		for _, face in ipairs({ 0, 90, 180, 270 }) do
			local f = base * CFrame.Angles(0, math.rad(face), 0) * CFrame.new(0, y, -2.2 * s)
			part(m, { Name = "Brace", Size = Vector3.new(6.2 * s, 0.35, 0.35), Color = Color3.fromRGB(200, 70, 55), CFrame = f * CFrame.Angles(0, 0, math.rad(40)) })
			part(m, { Name = "Brace", Size = Vector3.new(4.4 * s, 0.4, 0.4), Color = METAL, CFrame = f * CFrame.new(0, 2 * s, 0) })
		end
	end
	-- the access arm to the crew cabin, and a blinking beacon on top
	local armY = 23 * s
	part(m, { Name = "AccessArm", Size = Vector3.new(2.2 * s, 1.6 * s, 7 * s), Color = METAL, CFrame = base * CFrame.new(0, armY, -(3.5 * s + 1)) })
	part(m, { Name = "ArmRail", Size = Vector3.new(0.2, 0.2, 7 * s), Color = HAZARD, Material = Enum.Material.Neon, CFrame = base * CFrame.new(1.1 * s, armY + 0.9 * s, -(3.5 * s + 1)) })
	local beacon = part(m, { Name = "Beacon", Shape = Enum.PartType.Ball, Size = Vector3.new(1.2, 1.2, 1.2), Color = Color3.fromRGB(255, 60, 60), Material = Enum.Material.Neon,
		CFrame = base * CFrame.new(0, h + 0.6, 0) })
	beacon:SetAttribute("Blink", true)
	glow(beacon, Color3.fromRGB(255, 60, 60), 18, 2)
end

local function rocket(folder, at, s, full)
	s = s or 1
	local m = Instance.new("Model")
	m.Name = "Rocket"
	m.Parent = folder
	local R = 3.6 * s
	-- launch pad: a round platform, hazard ring and clamps
	cylY(m, "LaunchPadBase", at, 0.6, 1.2, 12 * s, METAL_DARK, { Material = Enum.Material.DiamondPlate })
	cylY(m, "PadRing", at, 1.25, 0.12, 11.2 * s, HAZARD, { Material = Enum.Material.Neon })
	cylY(m, "PadInner", at, 1.3, 0.12, 10.6 * s, METAL_DARK, { Material = Enum.Material.DiamondPlate })
	for i = 0, 3 do
		part(m, { Name = "Clamp", Size = Vector3.new(1.2 * s, 2.4 * s, 2.4 * s), Color = METAL,
			CFrame = at * CFrame.Angles(0, math.rad(i * 90), 0) * CFrame.new(0, 1.2 + 1.2 * s, -(R + 1.6 * s)) })
	end
	-- engine: a bell that flares out toward the bottom
	for i, r in ipairs({ 1.4, 1.9, 2.4, 2.8 }) do
		local bell = cylY(m, "EngineBell", at, 1.3 + (4.6 - i) * 0.75 * s, 0.78 * s, r * s, METAL_DARK, { Material = Enum.Material.Metal })
		if i == 4 then
			flame(bell, s)
			glow(bell, C.Orange, 20, 2.5)
		end
	end
	-- body, roll stripes, bands, name
	local y0 = 1.3 + 3.1 * s
	local bodyH = 17 * s
	cylY(m, "Body", at, y0 + bodyH / 2, bodyH, R, Color3.fromRGB(246, 247, 252))
	for _, a in ipairs({ 0, 180 }) do
		part(m, { Name = "RollStripe", Size = Vector3.new(2.6 * s, bodyH - 2 * s, 0.3), Color = C.Dark,
			CFrame = at * CFrame.Angles(0, math.rad(a + 90), 0) * CFrame.new(0, y0 + bodyH / 2, -R + 0.1) })
	end
	for _, y in ipairs({ y0 + 1.2 * s, y0 + bodyH - 1.2 * s }) do
		cylY(m, "Band", at, y, 1 * s, R + 0.08, C.Orange)
	end
	local plate = part(m, { Name = "NamePlate", Size = Vector3.new(bodyH - 5 * s, 2.2 * s, 0.1), Color = Color3.fromRGB(246, 247, 252), Transparency = 1, CanCollide = false,
		CFrame = at * CFrame.new(0, y0 + bodyH / 2, -R - 0.06) * CFrame.Angles(0, 0, math.rad(90)) })
	local g = Instance.new("SurfaceGui")
	g.Face = Enum.NormalId.Front
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = 30
	g.Parent = plate
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = Color3.fromRGB(40, 70, 140)
	l.Text = "STAR STATION"
	l.Parent = g
	-- crew cabin with portholes, then the nose cone and a beacon on the tip
	local cy = y0 + bodyH
	cylY(m, "Cabin", at, cy + 2 * s, 4 * s, R * 0.94, Color3.fromRGB(225, 230, 240))
	for i = -1, 1 do
		part(m, { Name = "Porthole", Shape = Enum.PartType.Ball, Size = Vector3.new(1.3, 1.3, 1.3) * s, Color = C.Blue, Material = Enum.Material.Neon,
			CFrame = at * CFrame.Angles(0, math.rad(i * 35), 0) * CFrame.new(0, cy + 2 * s, -R * 0.94 + 0.25) })
	end
	cone(m, at, cy + 4 * s, 7 * s, R * 0.94, C.Orange, full and 20 or 12)
	local tip = part(m, { Name = "NoseTip", Shape = Enum.PartType.Ball, Size = Vector3.new(0.6, 0.6, 0.6) * s, Color = Color3.fromRGB(255, 70, 70), Material = Enum.Material.Neon,
		CFrame = at * CFrame.new(0, cy + 11 * s, 0) })
	tip:SetAttribute("Blink", true)
	-- swept fins between the boosters
	for _, a in ipairs({ 45, 135, 225, 315 }) do
		part(m, { ClassName = "WedgePart", Name = "Fin", Size = Vector3.new(0.6 * s, 7 * s, 3.6 * s), Color = C.Blue,
			CFrame = at * CFrame.Angles(0, math.rad(a), 0) * CFrame.new(0, 1.4 + 3.5 * s, -(R + 1.8 * s) + 0.1) })
		part(m, { Name = "FinEdge", Size = Vector3.new(0.7 * s, 0.3 * s, 3.6 * s), Color = C.Orange, Material = Enum.Material.Neon,
			CFrame = at * CFrame.Angles(0, math.rad(a), 0) * CFrame.new(0, 1.55, -(R + 1.8 * s) + 0.1) })
	end
	if full then
		for _, side in ipairs({ -1, 1 }) do
			booster(m, at * CFrame.new(side * (R + 1.9 * s), 1.2, 0), s)
		end
		tower(m, at, s, R)
		for _, side in ipairs({ -1, 1 }) do -- floodlights at the pad edge shining up the rocket
			local lamp = part(m, { Name = "Floodlight", Size = Vector3.new(1.6, 1, 1.6), Color = C.Trim, Material = Enum.Material.Neon,
				CFrame = at * CFrame.new(side * 9 * s, 1.7, -9 * s) })
			local sl = Instance.new("SpotLight")
			sl.Face = Enum.NormalId.Top
			sl.Angle = 50
			sl.Range = 40
			sl.Brightness = 3
			sl.Parent = lamp
		end
	end
	-- the LAUNCH console beside the pad (2026-10-18, Matthew: "can the rockets launch into the sky?")
	local console = part(m, { Name = "LaunchConsole", Size = Vector3.new(2.4, 3.4, 1.8), Color = METAL_DARK, CFrame = at * CFrame.new(7 * s + 2, 1.7, -(12 * s + 2)) })
	local button = part(m, { Name = "LaunchButton", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.5, 1.4, 1.4), Color = Color3.fromRGB(255, 60, 60), Material = Enum.Material.Neon,
		CFrame = console.CFrame * CFrame.new(0, 1.9, 0) * CFrame.Angles(0, 0, math.rad(90)) })
	glow(button, Color3.fromRGB(255, 60, 60), 8, 1.5)
	local sign = part(m, { Name = "LaunchSign", Size = Vector3.new(2.3, 0.8, 0.1), Color = C.Dark, CFrame = console.CFrame * CFrame.new(0, 0.9, -0.95) })
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.LightInfluence = 0
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 50
	sg.Parent = sign
	local sl2 = Instance.new("TextLabel")
	sl2.Size = UDim2.fromScale(1, 1)
	sl2.BackgroundTransparency = 1
	sl2.Font = Enum.Font.FredokaOne
	sl2.TextScaled = true
	sl2.TextColor3 = Color3.fromRGB(255, 90, 90)
	sl2.Text = "LAUNCH"
	sl2.Parent = sg
	-- what stays behind when it launches: the pad, the tower, the lights and this console; everything else flies
	local STAY = { LaunchPadBase = true, PadRing = true, PadInner = true, Clamp = true, TowerPost = true, Brace = true, AccessArm = true,
		ArmRail = true, Beacon = true, Floodlight = true, LaunchConsole = true, LaunchButton = true, LaunchSign = true }
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") and STAY[p.Name] then
			p:SetAttribute("Stays", true)
		end
	end
	m:SetAttribute("Launchable", true)
	return m
end

-- ---------- the Gear Bay (2026-10-18, Matthew: "to the left of the tunnel there should be some equipment and weapons") ----------
-- an open-fronted armoury facing the tunnel: three display stands (Boing Glove, Star Blaster, Jet Boots), space suits,
-- helmets on a shelf, oxygen tanks and a tool chest. Returns each stand so Main.server.lua can put the Buy prompts on them.
local function spaceSuit(parent, at)
	local suit = C.Trim
	for _, side in ipairs({ -1, 1 }) do
		part(parent, { Name = "SuitLeg", Size = Vector3.new(1.3, 3.6, 1.4), Color = suit, Material = Enum.Material.Fabric, CFrame = at * CFrame.new(side * 0.75, 2.6, 0) })
		part(parent, { Name = "SuitBoot", Size = Vector3.new(1.5, 0.9, 1.9), Color = C.Orange, CFrame = at * CFrame.new(side * 0.75, 0.95, -0.2) })
		part(parent, { Name = "SuitArm", Size = Vector3.new(1.1, 3.4, 1.2), Color = suit, Material = Enum.Material.Fabric, CFrame = at * CFrame.new(side * 2.15, 6.1, 0) * CFrame.Angles(0, 0, side * 0.15) })
		part(parent, { Name = "SuitGlove", Shape = Enum.PartType.Ball, Size = Vector3.new(1.1, 1.1, 1.1), Color = C.Orange, CFrame = at * CFrame.new(side * 2.45, 4.3, 0) })
	end
	part(parent, { Name = "SuitBody", Size = Vector3.new(3.2, 3.8, 1.9), Color = suit, Material = Enum.Material.Fabric, CFrame = at * CFrame.new(0, 6.2, 0) })
	part(parent, { Name = "SuitPanel", Size = Vector3.new(1.6, 1, 0.2), Color = C.Blue, Material = Enum.Material.Neon, CFrame = at * CFrame.new(0, 6.6, -1) })
	part(parent, { Name = "SuitPack", Size = Vector3.new(2.6, 3.2, 1.2), Color = METAL, CFrame = at * CFrame.new(0, 6.4, 1.5) })
	part(parent, { Name = "SuitHelmet", Shape = Enum.PartType.Ball, Size = Vector3.new(2.8, 2.8, 2.8), Color = suit, CFrame = at * CFrame.new(0, 9.4, 0) })
	part(parent, { Name = "SuitVisor", Size = Vector3.new(2.0, 1.3, 0.5), Color = C.Orange, Material = Enum.Material.Glass, Transparency = 0.15, CFrame = at * CFrame.new(0, 9.5, -1.2) })
end

local function gearBay(folder, at)
	local GearTools = require(script.Parent.GearTools)
	local m = Instance.new("Model")
	m.Name = "GearBay"
	m.Parent = folder
	part(m, { Name = "BayFloor", Size = Vector3.new(46, 0.5, 22), Color = SHOP_FLOOR, Material = Enum.Material.DiamondPlate, CFrame = at * CFrame.new(0, 0.45, 0) })
	part(m, { Name = "BayEdge", Size = Vector3.new(46, 0.2, 0.6), Color = C.Orange, Material = Enum.Material.Neon, CFrame = at * CFrame.new(0, 0.75, -10.8) })
	part(m, { Name = "BayBackWall", Size = Vector3.new(46, 16, 1.5), Color = METAL, Material = Enum.Material.Metal, CFrame = at * CFrame.new(0, 8, 11) })
	part(m, { Name = "BayWallStripe", Size = Vector3.new(46, 0.6, 1.7), Color = C.Blue, Material = Enum.Material.Neon, CFrame = at * CFrame.new(0, 4, 11) })
	for _, side in ipairs({ -1, 1 }) do
		part(m, { Name = "BaySideWall", Size = Vector3.new(1.5, 16, 12), Color = METAL, CFrame = at * CFrame.new(side * 23, 8, 5.6) })
		part(m, { Name = "BayPost", Size = Vector3.new(2, 17, 2), Color = METAL_DARK, CFrame = at * CFrame.new(side * 23, 8.5, -0.6) })
		part(m, { Name = "BayPostLight", Size = Vector3.new(0.5, 14, 0.5), Color = C.Orange, Material = Enum.Material.Neon, CFrame = at * CFrame.new(side * 23, 8, -1.7) })
	end
	local roof = part(m, { Name = "BayRoof", Size = Vector3.new(48, 0.8, 13), Color = METAL_DARK, CFrame = at * CFrame.new(0, 16.6, 4.6) })
	for _, x in ipairs({ -13, 0, 13 }) do
		local lamp = part(m, { Name = "BayLamp", Size = Vector3.new(5, 0.3, 2), Color = SHOP_LAMP, Material = Enum.Material.Neon, CFrame = roof.CFrame * CFrame.new(x, -0.5, -4) })
		local sl = Instance.new("SpotLight")
		sl.Face = Enum.NormalId.Bottom
		sl.Angle = 70
		sl.Range = SHOP_LIGHT.range
		sl.Brightness = SHOP_LIGHT.brightness
		sl.Parent = lamp
	end
	-- the sign
	local sign = part(m, { Name = "BaySign", Size = Vector3.new(22, 3.6, 0.4), Color = C.Dark, CFrame = at * CFrame.new(0, 13.4, 10.1) })
	local g = Instance.new("SurfaceGui")
	g.Face = Enum.NormalId.Front
	g.LightInfluence = 0
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = 40
	g.Parent = sign
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = C.Orange
	l.Text = "GEAR BAY"
	l.Parent = g
	-- three display stands
	local stands = {}
	for i, id in ipairs({ "glove", "blaster", "boots" }) do
		local x = (i - 2) * 13
		local def = Config.gearById(id)
		local stand = part(m, { Name = "GearStand", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3.2, 5, 5), Color = METAL_DARK, CFrame = at * CFrame.new(x, 2.3, -1) * CFrame.Angles(0, 0, math.rad(90)) })
		part(m, { Name = "StandRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 5.3, 5.3), Color = def.kind == "weapon" and C.Orange or C.Blue, Material = Enum.Material.Neon,
			CFrame = at * CFrame.new(x, 3.95, -1) * CFrame.Angles(0, 0, math.rad(90)) })
		local beam = part(m, { Name = "HoloBeam", Shape = Enum.PartType.Cylinder, Size = Vector3.new(4, 3.4, 3.4), Color = C.Blue, Material = Enum.Material.Neon, Transparency = 0.82, CanCollide = false, CastShadow = false,
			CFrame = at * CFrame.new(x, 6, -1) * CFrame.Angles(0, 0, math.rad(90)) })
		glow(beam, def.kind == "weapon" and C.Orange or C.Blue, 12, STAND_GLOW)
		local show = GearTools.display(id, at * CFrame.new(x, 7.2, -1), m)
		show:SetAttribute("SpinSpeed", 45)
		local tag = part(m, { Name = "StandTag", Size = Vector3.new(6, 1.6, 0.3), Color = C.Dark, CFrame = at * CFrame.new(x, 1.6, -3.7) * CFrame.Angles(math.rad(-20), 0, 0) })
		local tg = Instance.new("SurfaceGui")
		tg.Face = Enum.NormalId.Front
		tg.LightInfluence = 0
		tg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		tg.PixelsPerStud = 50
		tg.Parent = tag
		local tl = Instance.new("TextLabel")
		tl.Size = UDim2.fromScale(1, 1)
		tl.BackgroundTransparency = 1
		tl.Font = Enum.Font.FredokaOne
		tl.TextScaled = true
		tl.TextColor3 = C.Trim
		tl.RichText = true
		tl.Text = def.name .. "\n<font color=\"#FFBA7D\">" .. def.price .. " ★</font>"
		tl.Parent = tg
		stands[id] = stand
	end
	-- along the back wall: space suits, a helmet shelf, oxygen tanks, a tool chest
	for _, x in ipairs({ -19, 19 }) do
		spaceSuit(m, at * CFrame.new(x, 0.7, 8.4))
	end
	local shelf = part(m, { Name = "Shelf", Size = Vector3.new(16, 0.5, 2.4), Color = METAL_DARK, CFrame = at * CFrame.new(0, 9.4, 9.4) })
	for i = -2, 2 do
		local helmet = part(m, { Name = "Helmet", Shape = Enum.PartType.Ball, Size = Vector3.new(2.2, 2.2, 2.2), Color = (i % 2 == 0) and C.Trim or C.Orange, CFrame = shelf.CFrame * CFrame.new(i * 3.1, 1.35, 0) })
		part(m, { Name = "HelmetVisor", Size = Vector3.new(1.5, 0.9, 0.3), Color = C.Blue, Material = Enum.Material.Glass, Transparency = 0.1, CFrame = helmet.CFrame * CFrame.new(0, 0.1, -0.95) })
	end
	for i, x in ipairs({ -10, -8.4, 8.4, 10 }) do
		cylY(m, "OxygenTank", at * CFrame.new(x, 0.7, 9.2), 2.6, 5.2, 0.75, (i % 2 == 0) and C.Blue or C.Trim)
		part(m, { Name = "TankValve", Shape = Enum.PartType.Ball, Size = Vector3.new(0.8, 0.8, 0.8), Color = METAL, CFrame = at * CFrame.new(x, 6.1, 9.2) })
	end
	local chest = part(m, { Name = "ToolChest", Size = Vector3.new(5, 3.2, 2.2), Color = Color3.fromRGB(220, 70, 60), CFrame = at * CFrame.new(0, 2.3, 9.2) })
	for i = 0, 2 do
		part(m, { Name = "Drawer", Size = Vector3.new(4.4, 0.12, 0.1), Color = METAL, CFrame = chest.CFrame * CFrame.new(0, -1 + i * 0.9, -1.12) })
	end
	return stands
end

-- ---------- the Space Furniture shop (2026-10-18): across the tunnel from the Gear Bay, six pieces on spinning stands ----------
local function standTag(m, at, title, price, color)
	local tag = part(m, { Name = "StandTag", Size = Vector3.new(6, 1.6, 0.3), Color = C.Dark, CFrame = at * CFrame.Angles(math.rad(-20), 0, 0) })
	local tg = Instance.new("SurfaceGui")
	tg.Face = Enum.NormalId.Front
	tg.LightInfluence = 0
	tg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	tg.PixelsPerStud = 50
	tg.Parent = tag
	local tl = Instance.new("TextLabel")
	tl.Size = UDim2.fromScale(1, 1)
	tl.BackgroundTransparency = 1
	tl.Font = Enum.Font.FredokaOne
	tl.TextScaled = true
	tl.TextColor3 = C.Trim
	tl.RichText = true
	tl.Text = title .. "\n<font color=\"#" .. color:ToHex() .. "\">" .. price .. "</font>"
	tl.Parent = tg
	return tag
end

local function shopShell(m, at, width, accent, title)
	part(m, { Name = "ShopFloor", Size = Vector3.new(width, 0.5, 22), Color = SHOP_FLOOR, Material = Enum.Material.Plastic, CFrame = at * CFrame.new(0, 0.45, 0) })
	part(m, { Name = "ShopEdge", Size = Vector3.new(width, 0.2, 0.6), Color = accent, Material = Enum.Material.Neon, CFrame = at * CFrame.new(0, 0.75, -10.8) })
	part(m, { Name = "ShopBackWall", Size = Vector3.new(width, 16, 1.5), Color = METAL, CFrame = at * CFrame.new(0, 8, 11) })
	part(m, { Name = "ShopWallStripe", Size = Vector3.new(width, 0.6, 1.7), Color = accent, Material = Enum.Material.Neon, CFrame = at * CFrame.new(0, 4, 11) })
	for _, side in ipairs({ -1, 1 }) do
		part(m, { Name = "ShopSideWall", Size = Vector3.new(1.5, 16, 12), Color = METAL, CFrame = at * CFrame.new(side * width / 2, 8, 5.6) })
		part(m, { Name = "ShopPostLight", Size = Vector3.new(0.5, 14, 0.5), Color = accent, Material = Enum.Material.Neon, CFrame = at * CFrame.new(side * width / 2, 8, -0.4) })
	end
	local roof = part(m, { Name = "ShopRoof", Size = Vector3.new(width + 2, 0.8, 13), Color = METAL_DARK, CFrame = at * CFrame.new(0, 16.6, 4.6) })
	for x = -width / 2 + 8, width / 2 - 8, 12 do
		local lamp = part(m, { Name = "ShopLamp", Size = Vector3.new(5, 0.3, 2), Color = SHOP_LAMP, Material = Enum.Material.Neon, CFrame = roof.CFrame * CFrame.new(x, -0.5, -4) })
		local sl = Instance.new("SpotLight")
		sl.Face = Enum.NormalId.Bottom
		sl.Angle = 70
		sl.Range = SHOP_LIGHT.range
		sl.Brightness = SHOP_LIGHT.brightness
		sl.Parent = lamp
	end
	local sign = part(m, { Name = "ShopSign", Size = Vector3.new(26, 3.6, 0.4), Color = C.Dark, CFrame = at * CFrame.new(0, 13.4, 10.1) })
	local g = Instance.new("SurfaceGui")
	g.Face = Enum.NormalId.Front
	g.LightInfluence = 0
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = 40
	g.Parent = sign
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = accent
	l.Text = title
	l.Parent = g
end

local function furnitureShop(folder, at)
	local Furniture = require(script.Parent.Furniture)
	local m = Instance.new("Model")
	m.Name = "FurnitureShop"
	m.Parent = folder
	local PINK = Color3.fromRGB(255, 150, 210)
	shopShell(m, at, 48, PINK, "SPACE FURNITURE")
	local stands = {}
	for i, def in ipairs(Config.Furniture) do
		local x = (i - 3.5) * 7.4
		local stand = part(m, { Name = "FurnitureStand", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.2, 5.6, 5.6), Color = METAL_DARK, CFrame = at * CFrame.new(x, 1.3, -1) * CFrame.Angles(0, 0, math.rad(90)) })
		part(m, { Name = "StandRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.25, 5.9, 5.9), Color = PINK, Material = Enum.Material.Neon, CFrame = at * CFrame.new(x, 1.95, -1) * CFrame.Angles(0, 0, math.rad(90)) })
		local show = Furniture.build(def.id, CFrame.new(), m, true)
		show:ScaleTo(def.id == "bed" and 0.62 or 0.9)
		show:PivotTo(at * CFrame.new(x, 1.95, -1)) -- its origin is floor level, so it stands on the stand
		show:SetAttribute("SpinSpeed", 30)
		standTag(m, at * CFrame.new(x, 1.3, -4.4), def.name, def.price .. " ★", PINK)
		stands[def.id] = stand
	end
	return stands
end

-- ---------- the Upgrade Lab (2026-10-18, Matthew: "character upgrade, slightly faster speed, maybe double jump, long stun") ----------
-- three glowing pods by the spawn; the level and price for you show on the prompt (Gear.client.lua)
local function upgradeLab(folder, at)
	local m = Instance.new("Model")
	m.Name = "UpgradeLab"
	m.Parent = folder
	local GREEN = Color3.fromRGB(140, 255, 170)
	shopShell(m, at, 32, GREEN, "UPGRADE LAB")
	local pads = {}
	local icons = { speed = "»", jump = "⇈", stun = "★" }
	for i, def in ipairs(Config.Upgrades) do
		local x = (i - 2) * 9
		local pad = part(m, { Name = "UpgradePod", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 6, 6), Color = METAL_DARK, CFrame = at * CFrame.new(x, 1.2, -1) * CFrame.Angles(0, 0, math.rad(90)) })
		part(m, { Name = "PodRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.25, 6.3, 6.3), Color = GREEN, Material = Enum.Material.Neon, CFrame = at * CFrame.new(x, 1.75, -1) * CFrame.Angles(0, 0, math.rad(90)) })
		local beam = part(m, { Name = "PodBeam", Shape = Enum.PartType.Cylinder, Size = Vector3.new(7, 5, 5), Color = GREEN, Material = Enum.Material.Neon, Transparency = 0.82, CanCollide = false, CastShadow = false,
			CFrame = at * CFrame.new(x, 5.5, -1) * CFrame.Angles(0, 0, math.rad(90)) })
		glow(beam, GREEN, 12, STAND_GLOW)
		local g = Instance.new("BillboardGui") -- a big floating symbol in each pod
		g.Size = UDim2.fromScale(4, 4)
		g.LightInfluence = 0
		g.MaxDistance = 120
		g.Parent = beam
		local l = Instance.new("TextLabel")
		l.Size = UDim2.fromScale(1, 1)
		l.BackgroundTransparency = 1
		l.Font = Enum.Font.FredokaOne
		l.TextScaled = true
		l.TextColor3 = GREEN
		l.TextStrokeTransparency = 0.3
		l.Text = icons[def.id] or "+"
		l.Parent = g
		standTag(m, at * CFrame.new(x, 1.3, -4.6), def.name, #def.prices == 1 and (def.prices[1] .. " ★") or (#def.prices .. " levels"), GREEN)
		pads[def.id] = pad
	end
	return pads
end

-- ---------- a moon rover parked near the spawn, and a UFO beaming up crates ----------
local function rover(folder, at)
	local m = Instance.new("Model")
	m.Name = "Rover"
	m.Parent = folder
	part(m, { Name = "Chassis", Size = Vector3.new(5, 1.6, 9), Color = C.Trim, CFrame = at * CFrame.new(0, 2.6, 0) })
	part(m, { Name = "ChassisStripe", Size = Vector3.new(5.1, 0.4, 9.1), Color = C.Orange, Material = Enum.Material.Neon, CFrame = at * CFrame.new(0, 2.4, 0) })
	for _, z in ipairs({ -3.4, 0, 3.4 }) do
		for _, side in ipairs({ -1, 1 }) do
			part(m, { Name = "Wheel", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 2.6, 2.6), Color = Color3.fromRGB(50, 54, 70), CFrame = at * CFrame.new(side * 2.9, 1.3, z) })
			part(m, { Name = "Hub", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.1, 1, 1), Color = C.Blue, Material = Enum.Material.Neon, CFrame = at * CFrame.new(side * 2.9, 1.3, z) })
		end
	end
	part(m, { Name = "SolarPanel", Size = Vector3.new(6.5, 0.2, 4.5), Color = Color3.fromRGB(40, 60, 130), Material = Enum.Material.Glass, CFrame = at * CFrame.new(0, 3.6, 1.8) * CFrame.Angles(math.rad(-12), 0, 0) })
	part(m, { Name = "Mast", Size = Vector3.new(0.4, 3.4, 0.4), Color = METAL, CFrame = at * CFrame.new(1.9, 5.1, -3.6) }) -- front corner, out of the driver's way
	local cam = part(m, { Name = "CameraHead", Size = Vector3.new(1.6, 1, 1), Color = C.Trim, CFrame = at * CFrame.new(1.9, 7.1, -3.6) })
	for _, side in ipairs({ -1, 1 }) do
		part(m, { Name = "Lens", Shape = Enum.PartType.Ball, Size = Vector3.new(0.5, 0.5, 0.5), Color = C.Blue, Material = Enum.Material.Neon, CFrame = cam.CFrame * CFrame.new(side * 0.4, 0, -0.5) })
	end
	local dish = part(m, { Name = "RoverDish", Size = Vector3.new(2.4, 0.6, 2.4), Color = C.Trim, CFrame = at * CFrame.new(1.5, 4.8, 3.4) * CFrame.Angles(math.rad(30), 0, 0) })
	local dm = Instance.new("SpecialMesh")
	dm.MeshType = Enum.MeshType.Sphere
	dm.Parent = dish

	-- drivable (2026-10-18, Matthew: "make it so you can drive the rover"): everything welds to one invisible hull that
	-- floats just off the deck. Hover height, heading and speed come from three constraints; while someone drives, their
	-- own screen sets them (Rover.client.lua), otherwise the server holds it still. Its underside is 0.9 up, so it rides
	-- over walkways but bumps off base floors, the launch pad and walls.
	local hull = part(m, { Name = "Hull", Size = Vector3.new(6.2, 2, 9.8), Transparency = 1, CanCollide = true, Material = Enum.Material.SmoothPlastic,
		CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.1, 0.2), CFrame = at * CFrame.new(0, 1.9, 0) })
	local seat = Instance.new("VehicleSeat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(2.2, 0.6, 2.2)
	seat.Color = C.Orange
	seat.Material = Enum.Material.Fabric
	seat.HeadsUpDisplay = false
	seat.TopSurface = Enum.SurfaceType.Smooth
	seat.CFrame = at * CFrame.new(0, 3.7, -1.2)
	seat:SetAttribute("Rover", true)
	seat.Parent = m
	part(m, { Name = "SeatBack", Size = Vector3.new(2.2, 1.8, 0.4), Color = C.Orange, Material = Enum.Material.Fabric, CFrame = at * CFrame.new(0, 4.6, -0.05) })
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored = false
			if p ~= hull then
				p.CanCollide = false
				p.Massless = true
				local w = Instance.new("WeldConstraint")
				w.Part0 = hull
				w.Part1 = p
				w.Parent = p
			end
		end
	end
	local att = Instance.new("Attachment")
	att.Name = "Drive"
	att.Parent = hull
	local lv = Instance.new("LinearVelocity")
	lv.Attachment0 = att
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.ForceLimitMode = Enum.ForceLimitMode.PerAxis
	lv.MaxAxesForce = Vector3.new(60000, 0, 60000) -- sideways only: the hover holds the height
	lv.VectorVelocity = Vector3.zero
	lv.Parent = hull
	local hover = Instance.new("AlignPosition")
	hover.Mode = Enum.PositionAlignmentMode.OneAttachment
	hover.Attachment0 = att
	hover.ForceLimitMode = Enum.ForceLimitMode.PerAxis
	hover.MaxAxesForce = Vector3.new(0, 200000, 0)
	hover.Responsiveness = 40
	hover.Position = hull.Position
	hover.Parent = hull
	local turn = Instance.new("AlignOrientation")
	turn.Mode = Enum.OrientationAlignmentMode.OneAttachment
	turn.Attachment0 = att
	turn.MaxTorque = 1e7
	turn.Responsiveness = 25
	turn.CFrame = hull.CFrame - hull.Position
	turn.Parent = hull
	m.PrimaryPart = hull
	return m
end

local function ufo(folder, at, beamTo)
	local m = Instance.new("Model")
	m.Name = "UFO"
	m.Parent = folder
	local disc = part(m, { Name = "Saucer", Size = Vector3.new(16, 2.2, 16), Color = Color3.fromRGB(200, 206, 222), CanCollide = false, CFrame = at })
	local sm = Instance.new("SpecialMesh")
	sm.MeshType = Enum.MeshType.Sphere
	sm.Parent = disc
	part(m, { Name = "Dome", Shape = Enum.PartType.Ball, Size = Vector3.new(6.5, 6.5, 6.5), Color = Color3.fromRGB(140, 255, 190), Material = Enum.Material.Glass, Transparency = 0.35, CanCollide = false, CFrame = at * CFrame.new(0, 1.2, 0) })
	part(m, { Name = "Pilot", Shape = Enum.PartType.Ball, Size = Vector3.new(2.2, 2.2, 2.2), Color = Color3.fromRGB(120, 220, 90), CanCollide = false, CFrame = at * CFrame.new(0, 1.9, 0) })
	for _, side in ipairs({ -1, 1 }) do
		part(m, { Name = "PilotEye", Shape = Enum.PartType.Ball, Size = Vector3.new(0.7, 0.9, 0.4), Color = C.Dark, CanCollide = false, CFrame = at * CFrame.new(side * 0.45, 2.1, -0.95) })
	end
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2
		part(m, { Name = "RimLight", Shape = Enum.PartType.Ball, Size = Vector3.new(0.8, 0.8, 0.8), Color = (i % 2 == 0) and C.Orange or C.Blue, Material = Enum.Material.Neon, CanCollide = false,
			CFrame = at * CFrame.new(math.cos(a) * 7.4, 0, math.sin(a) * 7.4) })
	end
	local under = part(m, { Name = "Underglow", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 5, 5), Color = Color3.fromRGB(140, 255, 190), Material = Enum.Material.Neon, CanCollide = false,
		CFrame = at * CFrame.new(0, -1, 0) * CFrame.Angles(0, 0, math.rad(90)) })
	glow(under, Color3.fromRGB(140, 255, 190), 26, 2)
	local h = at.Position.Y - beamTo.Y
	part(m, { Name = "TractorBeam", Shape = Enum.PartType.Cylinder, Size = Vector3.new(h, 6, 6), Color = Color3.fromRGB(140, 255, 190), Material = Enum.Material.Neon, Transparency = 0.82,
		CanCollide = false, CanQuery = false, CastShadow = false, CFrame = CFrame.new(at.Position.X, beamTo.Y + h / 2, at.Position.Z) * CFrame.Angles(0, 0, math.rad(90)) })
	m.PrimaryPart = disc
	m:SetAttribute("SpinSpeed", 30)
	m:SetAttribute("Bob", 1.2)
end

local function fuelTanks(folder, at)
	for i, offset in ipairs({ -7, 0, 7 }) do
		local base = at * CFrame.new(offset, 0, 0)
		part(folder, { Name = "Tank", Shape = Enum.PartType.Cylinder, Size = Vector3.new(14, 6, 6), Color = (i == 2) and C.Orange or C.Trim, CFrame = base * CFrame.new(0, 7, 0) * CFrame.Angles(0, 0, math.rad(90)) })
		part(folder, { Name = "TankBand", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 6.3, 6.3), Color = C.Blue, Material = Enum.Material.Neon, CFrame = base * CFrame.new(0, 10, 0) * CFrame.Angles(0, 0, math.rad(90)) })
		local cap = part(folder, { Name = "TankCap", Size = Vector3.new(6, 3, 6), Color = METAL, CFrame = base * CFrame.new(0, 14, 0) })
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = cap
	end
end

local function crates(folder, at, seed)
	local rng = Random.new(seed)
	for i = 1, 7 do
		local x, z = rng:NextNumber(-6, 6), rng:NextNumber(-4, 4)
		local s = rng:NextNumber(3, 4.5)
		local y = (i > 4) and (s / 2 + 4) or s / 2
		local crate = part(folder, { Name = "Crate", Size = Vector3.new(s, s, s), Color = (i % 3 == 0) and C.Orange or METAL, Material = Enum.Material.DiamondPlate,
			CFrame = at * CFrame.new(x, y, z) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0) })
		part(folder, { Name = "CrateStripe", Size = Vector3.new(s + 0.1, 0.4, s + 0.1), Color = C.Blue, Material = Enum.Material.Neon, CFrame = crate.CFrame })
	end
end

local function satelliteDish(folder, at)
	part(folder, { Name = "DishMast", Size = Vector3.new(2, 14, 2), Color = METAL_DARK, CFrame = at * CFrame.new(0, 7, 0) })
	local dish = part(folder, { Name = "Dish", Size = Vector3.new(14, 3, 14), Color = C.Trim, CFrame = at * CFrame.new(0, 15, 0) * CFrame.Angles(math.rad(25), 0, 0) })
	local m = Instance.new("SpecialMesh")
	m.MeshType = Enum.MeshType.Sphere
	m.Parent = dish
	dish:SetAttribute("SpinSpeed", 8)
	local tip = part(folder, { Name = "DishTip", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4), Color = C.Orange, Material = Enum.Material.Neon, CFrame = at * CFrame.new(0, 19, 0) })
	glow(tip, C.Orange, 10, 2)
end

-- ---------- outside: asteroids ----------
local function asteroids(folder)
	local rng = Random.new(365)
	for i = 1, 26 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local dist = rng:NextNumber(260, 520)
		local pos = Vector3.new(math.cos(angle) * dist, rng:NextNumber(-20, 160), math.sin(angle) * dist)
		local s = rng:NextNumber(6, 24)
		local rock = Instance.new("Model")
		rock.Name = "Asteroid" .. i
		rock.Parent = folder
		local core = part(rock, { Name = "Core", Size = Vector3.new(s, s * rng:NextNumber(0.6, 1), s * rng:NextNumber(0.7, 1)), Color = Color3.fromRGB(110 + rng:NextInteger(0, 30), 100, 95), Material = Enum.Material.Slate,
			CanCollide = false, CastShadow = false, CFrame = CFrame.new(pos) * CFrame.Angles(rng:NextNumber(0, 3), rng:NextNumber(0, 3), 0) })
		for _ = 1, 3 do
			part(rock, { Name = "Lump", Size = Vector3.new(s, s, s) * rng:NextNumber(0.35, 0.6), Color = core.Color, Material = Enum.Material.Slate, CanCollide = false, CastShadow = false,
				CFrame = core.CFrame * CFrame.new(rng:NextNumber(-s / 3, s / 3), rng:NextNumber(-s / 3, s / 3), rng:NextNumber(-s / 3, s / 3)) * CFrame.Angles(rng:NextNumber(0, 3), rng:NextNumber(0, 3), 0) })
		end
		rock.PrimaryPart = core
		rock:SetAttribute("SpinSpeed", rng:NextNumber(-12, 12))
	end
end

-- ---------- hiding lockers for Black Hole Night ----------
local function locker(folder, at)
	local m = Instance.new("Model")
	m.Name = "Locker"
	m.Parent = folder
	local body = part(m, { Name = "LockerBody", Size = Vector3.new(4.6, 9, 3.6), Color = Color3.fromRGB(96, 110, 150), Material = Enum.Material.Metal, CFrame = at * CFrame.new(0, 4.5, 0) })
	part(m, { Name = "Door", Size = Vector3.new(4.0, 8.2, 0.3), Color = Color3.fromRGB(110, 126, 170), Material = Enum.Material.Metal, CFrame = at * CFrame.new(0, 4.5, -1.9) })
	for i = 1, 3 do
		part(m, { Name = "Vent", Size = Vector3.new(2.4, 0.25, 0.1), Color = C.Dark, Material = Enum.Material.SmoothPlastic, CFrame = at * CFrame.new(0, 7 + i * 0.5, -2.06) })
	end
	local strip = part(m, { Name = "DoorLight", Size = Vector3.new(0.3, 6, 0.1), Color = C.Blue, Material = Enum.Material.Neon, CFrame = at * CFrame.new(1.6, 4.5, -2.08) })
	part(m, { Name = "Handle", Size = Vector3.new(0.3, 1.2, 0.3), Color = C.Orange, Material = Enum.Material.Neon, CFrame = at * CFrame.new(-1.4, 4.5, -2.15) })
	m.PrimaryPart = body
	return { model = m, body = body, strip = strip, inside = at * CFrame.new(0, 3.2, 0), front = at * CFrame.new(0, 3.2, -5) }
end

local function lockers(folder)
	local f = Instance.new("Folder")
	f.Name = "Lockers"
	f.Parent = folder
	local list = {}
	local spots = {}
	for _, x in ipairs({ -114, 0, 114 }) do -- in the gaps between bases
		for _, z in ipairs({ -95, 95 }) do
			table.insert(spots, Vector3.new(x - 3, 0, z))
			table.insert(spots, Vector3.new(x + 3, 0, z))
		end
	end
	for _, z in ipairs({ -40, 40 }) do
		table.insert(spots, Vector3.new(-140, 0, z))
		table.insert(spots, Vector3.new(140, 0, z * 0.75))
	end
	for _, p in ipairs(spots) do
		local facing = CFrame.lookAt(p, Vector3.new(p.X, 0, 0)) -- doors face the middle of the station
		table.insert(list, locker(f, facing))
	end
	return list
end

local function colour()
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Saturation = 0.15
	cc.Contrast = 0.08
	cc.Brightness = 0.02
	cc.Parent = Lighting
end

function Decor.build(station, bases)
	local folder = Instance.new("Folder")
	folder.Name = "Decor"
	folder.Parent = station
	shell(folder)
	plating(folder)
	launchPad(folder)
	for _, base in ipairs(bases) do
		hangar(folder, base)
	end
	local rockets = {
		rocket(folder, CFrame.new(-160, 0, 0) * CFrame.Angles(0, math.rad(-90), 0), 1, true), -- front (name, windows) toward the spawn
		rocket(folder, CFrame.new(200, 0, 0) * CFrame.Angles(0, math.rad(90), 0), 0.65, false),
	}
	local stands = gearBay(folder, CFrame.lookAt(Vector3.new(0, 0, -48), Vector3.new(0, 0, 0))) -- beside the tunnel, open side facing it
	local roverModel = rover(folder, CFrame.new(-104, 0, -46) * CFrame.Angles(0, math.rad(25), 0))
	local furnitureStands = furnitureShop(folder, CFrame.lookAt(Vector3.new(0, 0, 48), Vector3.new(0, 0, 0))) -- across the tunnel from the Gear Bay
	local upgradePads = upgradeLab(folder, CFrame.lookAt(Vector3.new(-104, 0, 48), Vector3.new(-104, 0, 0))) -- by the spawn, facing the walkway
	ufo(folder, CFrame.new(165, 22, 45), Vector3.new(165, 0, 45))
	fuelTanks(folder, CFrame.new(-150, 0, 40) * CFrame.Angles(0, math.rad(90), 0))
	crates(folder, CFrame.new(-150, 0, -40), 1)
	crates(folder, CFrame.new(165, 0, 45), 2)
	crates(folder, CFrame.new(165, 0, -45), 3)
	satelliteDish(folder, CFrame.new(160, 0, 0))
	asteroids(folder)
	colour()
	return lockers(folder), stands, roverModel, rockets, furnitureStands, upgradePads
end

return Decor
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Furniture</string>
          <string name="Source"><![CDATA[-- Furniture for the bases (2026-10-18, Matthew: "furniture in the base you can interact with, maybe a furniture store").
-- Each piece is built from parts around a floor-level origin, front facing -Z. The same builder makes the spinning displays
-- in the Space Furniture shop (display = true: seats switched off, nothing to bounce on).
-- SLOTS place each piece in a base, in the base's own coordinates (front = the doorway, local -Z), clear of the pedestals
-- (rows at z 15, 6 and -4, x ±18 and ±6), the doorway path (x -9..9) and the door console.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local C = Config.Colors
local Furniture = {}

Furniture.SLOTS = {
	beanbag = CFrame.new(-17, 1.1, -14) * CFrame.Angles(0, math.rad(-60), 0),
	bed = CFrame.new(24.6, 1.1, 10),
	disco = CFrame.new(0, 1.1, 10.5),
	trampoline = CFrame.new(16, 1.1, -15),
	telescope = CFrame.new(-24.5, 1.1, 14) * CFrame.Angles(0, math.rad(180), 0),
	arcade = CFrame.new(-25.6, 1.1, 2) * CFrame.Angles(0, math.rad(-90), 0),
}

local function newPart(m, root, name, size, color, offset, opts)
	opts = opts or {}
	local p = Instance.new(opts.class or "Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = opts.material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = opts.collide ~= false
	if opts.ball then
		p.Shape = Enum.PartType.Ball
	elseif opts.cyl then
		p.Shape = Enum.PartType.Cylinder
	elseif opts.sphere then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	if opts.transparency then
		p.Transparency = opts.transparency
	end
	p.CFrame = root * offset
	p.Parent = m
	return p
end

local UP = CFrame.Angles(0, 0, math.rad(90)) -- a cylinder standing upright
local ALONG_Z = CFrame.Angles(0, math.rad(90), 0)

local BUILD = {}

function BUILD.beanbag(m, at, display)
	newPart(m, at, "Bag", Vector3.new(5, 2.6, 5), C.Orange, CFrame.new(0, 1.2, 0), { sphere = true, material = Enum.Material.Fabric })
	newPart(m, at, "BagBack", Vector3.new(4.4, 3, 2.2), Color3.fromRGB(240, 165, 105), CFrame.new(0, 2.2, 1.4) * CFrame.Angles(math.rad(-15), 0, 0), { sphere = true, material = Enum.Material.Fabric })
	local seat = newPart(m, at, "Seat", Vector3.new(2.4, 0.4, 2.4), C.Orange, CFrame.new(0, 2.1, -0.2), { class = "Seat", transparency = 1 })
	seat.Disabled = display
	return seat
end

function BUILD.bed(m, at, display)
	-- a rocket lying down: a white body, a pointed orange end at the head, fins at the foot, a blue blanket
	newPart(m, at, "BedBody", Vector3.new(4.2, 1.6, 7), C.Trim, CFrame.new(0, 1.0, 0))
	for i, r in ipairs({ 2.1, 1.6, 1.0, 0.45 }) do
		newPart(m, at, "BedNose", Vector3.new(0.5, r * 2, r * 2) * Vector3.new(1, 0.62, 1), C.Orange, CFrame.new(0, 1.0, 3.5 + i * 0.5) * ALONG_Z, { cyl = true })
	end
	newPart(m, at, "Mattress", Vector3.new(3.8, 0.6, 6.4), Color3.fromRGB(250, 250, 255), CFrame.new(0, 2.1, 0), { material = Enum.Material.Fabric })
	newPart(m, at, "Blanket", Vector3.new(3.9, 0.3, 3.6), C.Blue, CFrame.new(0, 2.45, -1.3), { material = Enum.Material.Fabric })
	newPart(m, at, "Pillow", Vector3.new(2.6, 0.7, 1.4), Color3.fromRGB(255, 240, 220), CFrame.new(0, 2.6, 2.4), { sphere = true, material = Enum.Material.Fabric })
	for _, side in ipairs({ -1, 1 }) do
		newPart(m, at, "BedFin", Vector3.new(0.4, 2.2, 1.8), C.Orange, CFrame.new(side * 2.3, 1.4, -3.2), { class = "WedgePart" })
	end
	local seat = newPart(m, at, "Seat", Vector3.new(2.4, 0.4, 2.4), C.Trim, CFrame.new(0, 2.5, 0.4), { class = "Seat", transparency = 1 })
	seat.Disabled = display
	return seat
end

function BUILD.disco(m, at, display)
	-- hangs from the base roof; on a shop stand it sits on a short pole
	local ballY = display and 3.4 or 10
	local top = display and 0.2 or 15.1 -- on a stand it's a pole up from the stand, in a base a chain down from the roof
	newPart(m, at, "Chain", Vector3.new(math.abs(top - ballY), 0.18, 0.18), Color3.fromRGB(180, 186, 200), CFrame.new(0, (top + ballY) / 2, 0) * UP, { cyl = true, collide = false })
	local ball = newPart(m, at, "DiscoBall", Vector3.new(2.6, 2.6, 2.6), Color3.fromRGB(225, 230, 245), CFrame.new(0, ballY, 0), { ball = true, material = Enum.Material.Foil, collide = false })
	ball:SetAttribute("Disco", true)
	for i, col in ipairs({ Color3.fromRGB(255, 90, 160), Color3.fromRGB(90, 200, 255), Color3.fromRGB(255, 220, 90), Color3.fromRGB(140, 255, 140) }) do
		local l = Instance.new("SpotLight")
		l.Name = "DiscoLight" .. i
		l.Color = col
		l.Range = 30
		l.Angle = 40
		l.Brightness = 0 -- switched on by Station.client.lua while the base's party is on
		l.Face = ({ Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right })[i]
		l.Parent = ball
	end
	return ball
end

function BUILD.trampoline(m, at, display)
	local mat = newPart(m, at, "TrampolineMat", Vector3.new(0.3, 6.4, 6.4), Color3.fromRGB(30, 34, 48), CFrame.new(0, 1.7, 0) * UP, { cyl = true })
	newPart(m, at, "TrampolineRim", Vector3.new(0.5, 7.2, 7.2), C.Blue, CFrame.new(0, 1.6, 0) * UP, { cyl = true, material = Enum.Material.Neon })
	for i = 0, 3 do
		local a = math.rad(45 + i * 90)
		newPart(m, at, "TrampolineLeg", Vector3.new(0.4, 1.6, 0.4), Color3.fromRGB(120, 128, 150), CFrame.new(math.cos(a) * 3, 0.8, math.sin(a) * 3))
	end
	if not display then
		mat:SetAttribute("Bounce", 95) -- Station.client.lua launches whoever lands on it
	end
	return mat
end

function BUILD.telescope(m, at, display)
	for i = 0, 2 do
		local a = math.rad(i * 120)
		newPart(m, at, "TripodLeg", Vector3.new(0.25, 3.4, 0.25), Color3.fromRGB(70, 76, 96), CFrame.new(math.cos(a) * 0.9, 1.6, math.sin(a) * 0.9) * CFrame.Angles(math.sin(a) * 0.3, 0, -math.cos(a) * 0.3))
	end
	local tube = newPart(m, at, "TelescopeTube", Vector3.new(4.2, 0.9, 0.9), C.Trim, CFrame.new(0, 3.6, -0.6) * CFrame.Angles(math.rad(35), 0, 0) * ALONG_Z, { cyl = true })
	newPart(m, at, "TubeBand", Vector3.new(0.3, 1.0, 1.0), C.Orange, CFrame.new(0, 3.6, -0.6) * CFrame.Angles(math.rad(35), 0, 0) * ALONG_Z * CFrame.new(1.2, 0, 0), { cyl = true })
	newPart(m, at, "Lens", Vector3.new(0.12, 0.8, 0.8), C.Blue, CFrame.new(0, 3.6, -0.6) * CFrame.Angles(math.rad(35), 0, 0) * CFrame.new(0, 0, -2.12) * ALONG_Z, { cyl = true, material = Enum.Material.Neon })
	return tube
end

function BUILD.arcade(m, at, display)
	local cab = newPart(m, at, "Cabinet", Vector3.new(3, 6, 2.6), Color3.fromRGB(110, 70, 200), CFrame.new(0, 3, 0))
	newPart(m, at, "Screen", Vector3.new(2.4, 1.8, 0.2), Color3.fromRGB(80, 220, 255), CFrame.new(0, 4.3, -1.25) * CFrame.Angles(math.rad(-12), 0, 0), { material = Enum.Material.Neon })
	newPart(m, at, "Marquee", Vector3.new(3, 0.9, 0.3), C.Orange, CFrame.new(0, 5.6, -1.2), { material = Enum.Material.Neon })
	newPart(m, at, "Panel", Vector3.new(3, 0.3, 1.2), Color3.fromRGB(40, 44, 62), CFrame.new(0, 3.1, -1.6) * CFrame.Angles(math.rad(-15), 0, 0))
	newPart(m, at, "Stick", Vector3.new(0.4, 0.4, 0.4), Color3.fromRGB(255, 70, 70), CFrame.new(-0.6, 3.6, -1.6), { ball = true })
	for i, col in ipairs({ Color3.fromRGB(255, 220, 60), Color3.fromRGB(90, 255, 120) }) do
		newPart(m, at, "Button", Vector3.new(0.15, 0.35, 0.35), col, CFrame.new(0.3 + i * 0.45, 3.35, -1.65) * UP, { cyl = true, material = Enum.Material.Neon })
	end
	return cab
end

-- builds one piece; returns the model and the part a prompt or seat belongs to
function Furniture.build(id, at, parent, display)
	local m = Instance.new("Model")
	m.Name = (Config.furnitureById(id) or {}).name or id
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(0.2, 0.2, 0.2)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CFrame = at
	root.Parent = m
	m.PrimaryPart = root
	local key = BUILD[id] and BUILD[id](m, at, display) or nil
	m.Parent = parent
	return m, key
end

return Furniture
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">GearTools</string>
          <string name="Source"><![CDATA[-- The Gear Bay's items, built from simple parts (2026-10-18): the Boing Glove and Star Blaster as Roblox Tools,
-- the same shapes as spinning displays for the Gear Bay, and the Jet Boots that clip onto a player's feet.
-- A tool's "forward" is the Handle's -Z and "up" is its +Y, which is how a hand holds it with the arm raised.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local C = Config.Colors
local WHITE = Color3.fromRGB(240, 242, 248)
local STEEL = Color3.fromRGB(110, 118, 140)
local RED = Color3.fromRGB(235, 70, 60)

local GearTools = {}

local function piece(parent, root, name, size, color, offset, opts)
	opts = opts or {}
	local p = Instance.new(opts.wedge and "WedgePart" or "Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = opts.material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	if opts.ball then
		p.Shape = Enum.PartType.Ball
	elseif opts.cyl then
		p.Shape = Enum.PartType.Cylinder
	end
	if root then
		p.CFrame = root.CFrame * offset
		if not opts.noWeld then
			local w = Instance.new("WeldConstraint")
			w.Part0 = root
			w.Part1 = p
			w.Parent = p
		end
	end
	p.Parent = parent
	return p
end

local ALONG_Z = CFrame.Angles(0, math.rad(90), 0) -- turns a cylinder's length (its X) to run front to back

-- each builder fills `parent` around `handle` (already placed) and returns the parts the animations need
local BUILD = {}

function BUILD.glove(parent, handle)
	-- a launcher tube over the grip, a striped spring, and a big red glove that shoots out on a hit
	piece(parent, handle, "Tube", Vector3.new(2.2, 1.0, 1.0), WHITE, CFrame.new(0, 0.7, -0.7) * ALONG_Z, { cyl = true })
	piece(parent, handle, "TubeBand", Vector3.new(0.3, 1.1, 1.1), C.Orange, CFrame.new(0, 0.7, -1.6) * ALONG_Z, { cyl = true, material = Enum.Material.Neon })
	piece(parent, handle, "Trigger", Vector3.new(0.2, 0.4, 0.3), STEEL, CFrame.new(0, 0.05, -0.45))
	local rod = piece(parent, handle, "Spring", Vector3.new(1.4, 0.45, 0.45), Color3.fromRGB(200, 205, 215), CFrame.new(0, 0.7, -2.4) * ALONG_Z,
		{ cyl = true, material = Enum.Material.Metal, noWeld = true })
	local rodJoint = Instance.new("Motor6D")
	rodJoint.Name = "SpringJoint"
	rodJoint.Part0 = handle
	rodJoint.Part1 = rod
	rodJoint.C0 = CFrame.new(0, 0.7, -2.4) * ALONG_Z
	rodJoint.Parent = handle
	local glove = piece(parent, handle, "Glove", Vector3.new(1.9, 1.7, 1.9), RED, CFrame.new(0, 0.7, -3.6), { ball = true, noWeld = true })
	local gloveJoint = Instance.new("Motor6D")
	gloveJoint.Name = "GloveJoint"
	gloveJoint.Part0 = handle
	gloveJoint.Part1 = glove
	gloveJoint.C0 = CFrame.new(0, 0.7, -3.6)
	gloveJoint.Parent = handle
	piece(parent, glove, "Thumb", Vector3.new(0.7, 0.9, 0.8), RED, CFrame.new(0.85, 0.1, 0.1), { ball = true })
	piece(parent, glove, "Cuff", Vector3.new(0.5, 1.5, 1.5), WHITE, CFrame.new(0, 0, 0.9) * ALONG_Z, { cyl = true })
	piece(parent, glove, "Lace", Vector3.new(0.18, 0.18, 0.9), WHITE, CFrame.new(0, 0.82, 0.2))
	return { glove = glove }
end

function BUILD.blaster(parent, handle)
	-- a chunky white body, a glowing blue barrel with coils, and an orange star crystal at the muzzle
	piece(parent, handle, "Body", Vector3.new(0.9, 1.0, 2.4), WHITE, CFrame.new(0, 0.75, -0.6))
	piece(parent, handle, "Stripe", Vector3.new(0.95, 0.25, 2.0), C.Orange, CFrame.new(0, 1.0, -0.6), { material = Enum.Material.Neon })
	piece(parent, handle, "Barrel", Vector3.new(1.8, 0.55, 0.55), STEEL, CFrame.new(0, 0.75, -2.5) * ALONG_Z, { cyl = true, material = Enum.Material.Metal })
	for i = 0, 2 do
		piece(parent, handle, "Coil", Vector3.new(0.2, 0.8, 0.8), C.Blue, CFrame.new(0, 0.75, -1.9 - i * 0.45) * ALONG_Z, { cyl = true, material = Enum.Material.Neon })
	end
	local tip = piece(parent, handle, "Crystal", Vector3.new(0.6, 0.6, 0.6), C.Orange, CFrame.new(0, 0.75, -3.45), { ball = true, material = Enum.Material.Neon })
	piece(parent, handle, "Sight", Vector3.new(0.2, 0.4, 0.5), C.Blue, CFrame.new(0, 1.4, -1.2), { material = Enum.Material.Neon })
	for _, side in ipairs({ -1, 1 }) do
		piece(parent, handle, "Fin", Vector3.new(0.12, 0.7, 0.9), C.Blue, CFrame.new(side * 0.5, 1.1, 0.25) * CFrame.Angles(0, 0, side * -0.4), { wedge = true })
	end
	local muzzle = Instance.new("Attachment")
	muzzle.Name = "Muzzle"
	muzzle.Position = Vector3.new(0, 0.75, -3.8)
	muzzle.Parent = handle
	local light = Instance.new("PointLight")
	light.Name = "Flash"
	light.Color = C.Orange
	light.Range = 12
	light.Brightness = 0
	light.Parent = tip
	return { tip = tip }
end

local function newHandle(parent, at)
	local h = piece(parent, nil, "Handle", Vector3.new(0.45, 1.1, 0.6), Color3.fromRGB(60, 66, 86), nil, { material = Enum.Material.Metal })
	h.CFrame = at or CFrame.new()
	return h
end

-- a Tool for the backpack
function GearTools.tool(id)
	local def = Config.gearById(id)
	if not (def and BUILD[id]) then
		return nil
	end
	local tool = Instance.new("Tool")
	tool.Name = def.name
	tool.ToolTip = def.blurb
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.Grip = CFrame.new(0, -0.1, 0) -- the hand closes round the middle of the grip
	tool:SetAttribute("GearId", id)
	tool:SetAttribute("Cooldown", def.cooldown or 0.6)
	tool:SetAttribute("Button", def.button or "USE")
	local handle = newHandle(tool)
	BUILD[id](tool, handle)
	return tool
end

-- the same shape, anchored, for the Gear Bay's display stands (Spin.client.lua turns it)
function GearTools.display(id, cframe, parent)
	local m = Instance.new("Model")
	m.Name = (Config.gearById(id) or {}).name or id
	if id == "boots" then
		local root = piece(m, nil, "Root", Vector3.new(0.2, 0.2, 0.2), STEEL, nil)
		root.Transparency = 1
		root.CFrame = cframe
		for _, side in ipairs({ -1, 1 }) do
			GearTools.boot(m, root, CFrame.new(side * 1.4, 0, 0) * CFrame.Angles(0, math.rad(180), 0), 2)
		end
		m.PrimaryPart = root
	else
		local handle = newHandle(m, CFrame.new())
		BUILD[id](m, handle)
		m.PrimaryPart = handle
		m:ScaleTo(2)
		-- centre it on the stand, side-on so you see its whole length
		local box = m:GetBoundingBox()
		m:PivotTo(cframe * CFrame.Angles(0, math.rad(90), 0) * box:ToObjectSpace(m:GetPivot()))
	end
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored = true
		elseif p:IsA("Motor6D") then
			p:Destroy() -- on display nothing needs to move by itself
		end
	end
	m.Parent = parent
	return m
end

-- one jet boot around `root` at `offset`; scale 1 fits a player's foot
function GearTools.boot(parent, root, offset, scale)
	scale = scale or 1
	local s = scale
	local shell = piece(parent, root, "JetBoot", Vector3.new(1.15, 0.9, 1.5) * s, WHITE, offset * CFrame.new(0, 0.05 * s, -0.05 * s))
	piece(parent, root, "BootToe", Vector3.new(1.1, 0.75, 0.9) * s, C.Orange, offset * CFrame.new(0, -0.05 * s, -0.75 * s), { ball = true })
	piece(parent, root, "BootBand", Vector3.new(1.2, 0.22, 1.55) * s, C.Blue, offset * CFrame.new(0, 0.35 * s, -0.05 * s), { material = Enum.Material.Neon })
	local nozzle = piece(parent, root, "BootJet", Vector3.new(0.35, 0.6, 0.6) * s, Color3.fromRGB(70, 76, 96), offset * CFrame.new(0, 0.1 * s, 0.8 * s) * ALONG_Z, { cyl = true, material = Enum.Material.Metal })
	nozzle:SetAttribute("JetNozzle", true)
	return shell
end

-- clip a pair onto a character's feet (R15 feet, or the bottom of R6 legs)
function GearTools.fitBoots(character)
	if character:FindFirstChild("JetBoots") then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "JetBoots"
	folder.Parent = character
	for _, names in ipairs({ { "LeftFoot", "Left Leg" }, { "RightFoot", "Right Leg" } }) do
		local foot = character:FindFirstChild(names[1])
		local offset = CFrame.new(0, 0.25, 0) -- R15: lift the shell so it doesn't sink into the floor
		if not foot then
			foot = character:FindFirstChild(names[2])
			offset = CFrame.new(0, -0.6, 0)
		end
		if foot then
			GearTools.boot(folder, foot, offset, 1)
		end
	end
end

return GearTools
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="9">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Captain Nolan's Star Station: the game rules. Grab critters off the launch pad, carry them home, earn Stardust,
-- grab Stardust stars, steal from friends, close your airlock, and catch thieves before they get home.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local CritterModels = require(ReplicatedStorage.Shared.CritterModels)
local MapBuilder = require(script.Parent.MapBuilder)
local PlayerData = require(script.Parent.PlayerData)

local map = MapBuilder.build()
local stationFolder = map.critterFolder.Parent

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = ReplicatedStorage
local function remote(name)
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotes
	return r
end
local Notify = remote("Notify")
local ShieldRequest = remote("ShieldRequest")
local FX = remote("FX") -- sparkles, pop-up numbers, the steal alarm (drawn on each player's screen)
local SetPet = remote("SetPet") -- pick which of your critters follows you around
local Expand = remote("Expand") -- buy two more pedestals
local Drop = remote("Drop") -- put down what you are carrying (2026-10-18: to grab something better)

-- a sound from Config.Sounds: at a spot in the world for everyone nearby, or just for one player (2026-10-18)
local function sfx(name, pos, player)
	if player then
		FX:FireClient(player, "sfx", name, pos)
	else
		FX:FireAllClients("sfx", name, pos)
	end
end

local state = {} -- [player] = { base = base, carrying = { model, crit, from = { owner, slot } | nil } }
local conveyor = {}

local function now()
	return workspace:GetServerTimeNow()
end

local function tell(player, text, kind)
	if player and player.Parent then
		Notify:FireClient(player, text, kind or "info")
	end
end

local function tellAll(text, kind)
	Notify:FireAllClients(text, kind or "info")
end

local function addCommas(n)
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (out:gsub("^,", ""))
end

-- a critter as the game counts it: its kind, its mutation, and what that makes it worth
local function makeCrit(def, mut)
	local name, price, income = Config.statsOf(def, mut)
	return { key = Config.keyOf(def.id, mut and mut.id), def = def, mut = mut, name = name, price = price, income = income }
end

local function radiusOf(def)
	return 1.5 * CritterModels.scaleFor(def)
end

-- ---------- stats ----------
local function incomeOf(st)
	local income = 0
	if st and st.base then
		for _, rec in pairs(st.base.slots) do
			income += rec.crit.income
		end
	end
	return income
end

local function refreshStats(player)
	local d = PlayerData.get(player)
	local st = state[player]
	if not (d and st) then
		return
	end
	local ls = player:FindFirstChild("leaderstats")
	if ls then
		ls.Stardust.Value = d.stardust
		local n = 0
		for _ in pairs(d.slots) do
			n += 1
		end
		ls.Critters.Value = n
	end
	player:SetAttribute("Income", incomeOf(st))
	player:SetAttribute("Stardust", d.stardust)
	-- the Collection Book (every critter you have ever had) and what is in your base now, for the screens
	local found, owned, ownedSet = {}, {}, {}
	for key in pairs(d.found) do
		table.insert(found, key)
	end
	if st.base then
		for _, rec in pairs(st.base.slots) do
			if not ownedSet[rec.crit.key] then
				ownedSet[rec.crit.key] = true
				table.insert(owned, rec.crit.key)
			end
		end
	end
	player:SetAttribute("NextExpand", (st.base and Config.ExpandCosts[(st.base.unlocked - Config.PedestalsPerBase) / 2 + 1]) or 0)
	player:SetAttribute("Found", table.concat(found, ","))
	player:SetAttribute("Owned", table.concat(owned, ","))
	local pet = player:GetAttribute("Pet")
	if pet and not ownedSet[pet] then -- your pet was stolen: it stops following you
		player:SetAttribute("Pet", nil)
	end
end

local function markFound(player, crit)
	local d = PlayerData.get(player)
	if d and not d.found[crit.key] then
		d.found[crit.key] = true
		tell(player, "NEW! " .. crit.name .. " is in your Collection Book!", "rare")
	end
end

-- ---------- pedestals ----------
local tryStealing

local function placeOnPedestal(base, slot, crit)
	local ped = base.pedestals[slot]
	local model = CritterModels.build(crit.def, ped.top * CFrame.new(0, radiusOf(crit.def) + 0.3, 0), crit.mut)
	CritterModels.setInfo(model, "+" .. addCommas(crit.income) .. " Stardust/s")
	model:SetAttribute("OnPedestal", true) -- each screen makes it bob
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Steal"
	prompt.ObjectText = crit.name
	prompt.HoldDuration = Config.StealHold
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = true -- the walls and windows block it (2026-10-18)
	prompt:SetAttribute("OwnerUserId", base.owner and base.owner.UserId or 0) -- the owner's own screen hides it
	prompt.Enabled = base.shieldUntil <= now()
	prompt.Parent = model.PrimaryPart
	prompt.Triggered:Connect(function(who)
		tryStealing(who, base, slot)
	end)
	-- the owner can sell it (F) to make room; only the owner's screen shows this one
	local sell = Instance.new("ProximityPrompt")
	sell.ActionText = "Sell (+" .. addCommas(math.floor(crit.price * Config.SellBack)) .. ")"
	sell.ObjectText = crit.name
	sell.KeyboardKeyCode = Enum.KeyCode.F
	sell.GamepadKeyCode = Enum.KeyCode.ButtonY
	sell.HoldDuration = 1
	sell.MaxActivationDistance = 9
	sell.RequiresLineOfSight = false
	sell.UIOffset = Vector2.new(0, 70)
	sell:SetAttribute("OnlyFor", base.owner and base.owner.UserId or 0)
	sell.Parent = model.PrimaryPart
	sell.Triggered:Connect(function(who)
		if who ~= base.owner or base.slots[slot] == nil or base.slots[slot].model ~= model then
			return
		end
		local d = PlayerData.get(who)
		if not d then
			return
		end
		local value = math.floor(crit.price * Config.SellBack)
		base.slots[slot] = nil
		d.slots[tostring(slot)] = nil
		d.stardust += value
		FX:FireAllClients("burst", model:GetPivot().Position, Config.Colors.Orange)
		sfx("sell", model:GetPivot().Position)
		model:Destroy()
		refreshStats(who)
		tell(who, "Sold " .. crit.name .. " for " .. addCommas(value) .. " Stardust.", "info")
	end)
	model.Parent = map.critterFolder
	base.slots[slot] = { model = model, crit = crit, prompt = prompt }
	return model
end

local function freeSlot(base)
	for i = 1, base.unlocked do
		if not base.slots[i] then
			return i
		end
	end
	return nil
end

-- ---------- carrying ----------
local function insideBase(base, pos)
	local p = base.cf:PointToObjectSpace(pos)
	return math.abs(p.X) < base.halfW and math.abs(p.Z) < base.halfD
end

local function rootOf(player)
	local ch = player.Character
	return ch and ch:FindFirstChild("HumanoidRootPart")
end

local function attach(player, model, crit, from)
	local hrp = rootOf(player)
	if not hrp then
		return false
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			d:Destroy()
		end
	end
	model:SetAttribute("OnPedestal", nil)
	local body = model.PrimaryPart
	model:PivotTo(hrp.CFrame * CFrame.new(0, 3.2 + radiusOf(crit.def), 0))
	body.Anchored = false
	body.Massless = true
	local w = Instance.new("WeldConstraint")
	w.Name = "CarryWeld"
	w.Part0 = hrp
	w.Part1 = body
	w.Parent = body
	CritterModels.setInfo(model, from and "STOLEN! Run home!" or "Take it home!")
	CritterModels.setRate(model, "+" .. addCommas(crit.income) .. " Stardust/s") -- still showing over your head while you carry it
	state[player].carrying = { model = model, crit = crit, from = from }
	player:SetAttribute("Carrying", crit.name) -- the guide beam home
	return true
end

local function clearCarry(player)
	local st = state[player]
	if st then
		st.carrying = nil
	end
	if player.Parent then
		player:SetAttribute("Carrying", nil)
	end
end

-- a carried critter that never made it home: a stolen one goes back to its owner, a bought one is refunded
local function dropCarried(player, reason)
	local st = state[player]
	local c = st and st.carrying
	if not c then
		return
	end
	clearCarry(player)
	if c.model then
		c.model:Destroy()
	end
	if c.from then
		local owner = c.from.owner
		local ost = owner and state[owner]
		local od = owner and PlayerData.get(owner)
		if ost and ost.base and od then
			local slot = c.from.slot
			if ost.base.slots[slot] then
				slot = freeSlot(ost.base) -- its old pedestal was filled meanwhile: any free one
			end
			if slot then
				placeOnPedestal(ost.base, slot, c.crit)
				od.slots[tostring(slot)] = c.crit.key
				refreshStats(owner)
				tell(owner, "Your " .. c.crit.name .. " came back home!", "good")
			end
		end
		if reason == "caught" then
			tell(player, "Caught! " .. c.crit.name .. " went back to its owner.", "bad")
		elseif reason == "dropped" then
			tell(player, "You put " .. c.crit.name .. " down. It went back to its owner.", "info")
		end
	else
		local d = PlayerData.get(player)
		if d then
			d.stardust += c.crit.price
			refreshStats(player)
			if player.Parent then
				tell(player, "You dropped " .. c.crit.name .. ". All " .. addCommas(c.crit.price) .. " Stardust back.", "info")
			end
		end
	end
end

local function bringHome(player)
	local st = state[player]
	local c = st.carrying
	local d = PlayerData.get(player)
	local slot = freeSlot(st.base)
	if not (c and d and slot) then
		return
	end
	clearCarry(player)
	c.model:Destroy()
	local model = placeOnPedestal(st.base, slot, c.crit)
	d.slots[tostring(slot)] = c.crit.key
	d.caught += 1
	markFound(player, c.crit)
	refreshStats(player)
	FX:FireAllClients("confetti", model:GetPivot().Position)
	tell(player, c.crit.name .. " joined your base! +" .. addCommas(c.crit.income) .. " Stardust every second", "good")
	if c.from and c.from.owner and c.from.owner ~= player then
		tell(c.from.owner, player.DisplayName .. " got away with your " .. c.crit.name .. "!", "bad")
	end
end

-- ---------- buying from the launch pad ----------
local function tryBuy(player, item)
	local st = state[player]
	local d = PlayerData.get(player)
	if item.taken or not (st and d) then
		return
	end
	local crit = item.crit
	if not st.base then
		tell(player, "The station is full right now: no free base for you yet.", "bad")
		return
	end
	if st.carrying then
		tell(player, "Your hands are full! Take your critter home first.", "bad")
		return
	end
	if d.stardust < crit.price then
		tell(player, "You need " .. addCommas(crit.price - d.stardust) .. " more Stardust for " .. crit.name .. ".", "bad")
		return
	end
	if not freeSlot(st.base) then
		tell(player, "Your base is full! Every pedestal has a critter.", "bad")
		return
	end
	item.taken = true
	d.stardust -= crit.price
	refreshStats(player)
	local at = item.model:GetPivot().Position
	if not attach(player, item.model, crit, nil) then
		d.stardust += crit.price
		refreshStats(player)
		item.model:Destroy()
		return
	end
	FX:FireAllClients("burst", at, Config.Rarities[crit.def.rarity].color)
	sfx("buy", at)
	tell(player, "Got " .. crit.name .. "! Carry it to your base.", "good")
end

-- ---------- stealing ----------
tryStealing = function(thief, base, slot)
	local owner = base.owner
	local st = state[thief]
	if not (owner and st) or owner == thief then
		return
	end
	if base.shieldUntil > now() then
		tell(thief, "Their door is locked! Wait for it to open.", "bad")
		return
	end
	local thrp = rootOf(thief)
	if not (thrp and insideBase(base, thrp.Position)) then -- no stealing through the walls (2026-10-18)
		return
	end
	if st.carrying then
		tell(thief, "Your hands are full!", "bad")
		return
	end
	if not (st.base and freeSlot(st.base)) then
		tell(thief, "Your base is full, so there's nowhere to take it.", "bad")
		return
	end
	local rec = base.slots[slot]
	local od = PlayerData.get(owner)
	if not (rec and od) then
		return
	end
	base.slots[slot] = nil
	od.slots[tostring(slot)] = nil
	refreshStats(owner)
	if not attach(thief, rec.model, rec.crit, { owner = owner, slot = slot }) then
		rec.model:Destroy()
		placeOnPedestal(base, slot, rec.crit)
		od.slots[tostring(slot)] = rec.crit.key
		refreshStats(owner)
		return
	end
	FX:FireClient(owner, "alarm", base.index)
	tell(thief, "You grabbed " .. rec.crit.name .. "! Run to your base before they catch you!", "good")
	tell(owner, "THIEF! " .. thief.DisplayName .. " is stealing your " .. rec.crit.name .. ". Catch them!", "bad")
end

-- ---------- airlock shield ----------
-- the door (2026-10-18): locked = a solid red energy door nobody can pass, owner included; steal prompts off
local function setShieldVisual(base, on)
	base.shield.Transparency = 1 -- the metal gate shows it now (Station.client.lua); this only blocks the way
	base.shield.CanCollide = on
	for _, lamp in ipairs(base.doorLamps or {}) do
		lamp.Color = on and Color3.fromRGB(255, 70, 80) or Color3.fromRGB(80, 230, 120)
	end
	for _, rec in pairs(base.slots) do
		rec.prompt.Enabled = not on
	end
end

local function unlockDoor(base, why)
	base.shieldUntil = 0
	base.cooldownUntil = now() + Config.ShieldCooldown -- the risk: no locking again for a while
	base.root:SetAttribute("ShieldUntil", 0)
	base.root:SetAttribute("CooldownUntil", base.cooldownUntil)
	setShieldVisual(base, false)
	sfx("unlock", base.cf.Position)
	if base.owner then
		tell(base.owner, why == "timer" and "Your door opened by itself. Guard your critters!" or ("Door unlocked. You can lock it again in " .. Config.ShieldCooldown .. " seconds."), "info")
	end
end

local function toggleDoor(player)
	local st = state[player]
	local base = st and st.base
	if not base then
		return
	end
	local t = now()
	if base.shieldUntil > t then
		unlockDoor(base, "owner")
		return
	end
	if base.cooldownUntil > t then
		tell(player, "You can lock the door again in " .. math.ceil(base.cooldownUntil - t) .. "s.", "info")
		return
	end
	base.shieldUntil = t + Config.ShieldSeconds
	base.root:SetAttribute("ShieldUntil", base.shieldUntil)
	setShieldVisual(base, true)
	sfx("lock", base.cf.Position)
	-- anyone else inside is put out the door
	for other in pairs(state) do
		local hrp = other ~= player and other.Character and other.Character:FindFirstChild("HumanoidRootPart")
		if hrp and insideBase(base, hrp.Position) then
			other.Character:PivotTo(base.cf * CFrame.new(0, 4, -base.halfD - 8))
			tell(other, "The door locked and you were put outside!", "info")
		end
	end
	tell(player, "Door locked for " .. Config.ShieldSeconds .. " seconds. Nobody can get in, you included.", "good")
	local myUntil = base.shieldUntil
	task.delay(Config.ShieldSeconds, function()
		if base.shieldUntil == myUntil then
			unlockDoor(base, "timer")
		end
	end)
end

ShieldRequest.OnServerEvent:Connect(toggleDoor)
for _, base in ipairs(map.bases) do
	base.consolePrompt.Triggered:Connect(function(who)
		if base.owner == who then
			toggleDoor(who)
		else
			tell(who, "That's not your door.", "info")
		end
	end)
end

-- ---------- bases: claim on join, free on leave ----------
local function pedestalLooks(base)
	for i, ped in ipairs(base.pedestals) do
		local locked = i > base.unlocked
		ped.part.Transparency = locked and 0.8 or 0
		ped.ring.Color = locked and Color3.fromRGB(90, 96, 116) or Config.Colors.Blue
		ped.ring.Transparency = locked and 0.6 or 0
	end
end

local function claimBase(player, d)
	for _, base in ipairs(map.bases) do
		if not base.owner then
			base.owner = player
			base.unlocked = d.pedestals
			pedestalLooks(base)
			base.shieldUntil, base.cooldownUntil = 0, 0
			base.root:SetAttribute("OwnerUserId", player.UserId)
			base.root:SetAttribute("ShieldUntil", 0)
			base.root:SetAttribute("CooldownUntil", 0)
			base.signLabel.Text = player.DisplayName .. "'s Base"
			base.nameLabel.Text = player.DisplayName .. "'s Base"
			return base
		end
	end
	return nil
end

local function freeBase(base)
	for slot, rec in pairs(base.slots) do
		rec.model:Destroy()
		base.slots[slot] = nil
	end
	base.owner = nil
	base.unlocked = Config.PedestalsPerBase
	pedestalLooks(base)
	base.shieldUntil, base.cooldownUntil = 0, 0
	setShieldVisual(base, false)
	base.root:SetAttribute("OwnerUserId", 0)
	base.signLabel.Text = "Free base"
	base.nameLabel.Text = "Free base"
end

local function onCharacter(player, character)
	local hum = character:WaitForChild("Humanoid", 10)
	if hum then
		hum.Died:Connect(function()
			dropCarried(player, "died")
		end)
	end
	local st = state[player]
	if st and st.base then -- start each life at your own base
		task.defer(function()
			local hrp = character:WaitForChild("HumanoidRootPart", 5)
			if hrp then
				character:PivotTo(st.base.cf * CFrame.new(0, 4, -10))
			end
		end)
	end
end

local function onPlayerAdded(player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local sd = Instance.new("IntValue")
	sd.Name = "Stardust"
	sd.Parent = ls
	local cr = Instance.new("IntValue")
	cr.Name = "Critters"
	cr.Parent = ls
	ls.Parent = player

	local d = PlayerData.load(player)
	if not player.Parent then
		PlayerData.release(player)
		return
	end
	state[player] = { base = claimBase(player, d), carrying = nil }
	local st = state[player]
	if st.base then
		for k, key in pairs(d.slots) do
			local def, mut = Config.fromKey(key)
			if def then
				local crit = makeCrit(def, mut)
				placeOnPedestal(st.base, tonumber(k), crit)
				d.found[crit.key] = true
			end
		end
	end
	if d.pet then
		player:SetAttribute("Pet", d.pet) -- refreshStats clears it if that critter is no longer in the base
	end
	refreshStats(player)
	player.CharacterAdded:Connect(function(ch)
		onCharacter(player, ch)
	end)
	if player.Character then
		onCharacter(player, player.Character)
	end
	tell(player, "Welcome aboard " .. Config.GameTitle .. "!", "good")
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in ipairs(Players:GetPlayers()) do -- anyone who joined before this script ran (Studio play-testing)
	task.spawn(onPlayerAdded, p)
end

Players.PlayerRemoving:Connect(function(player)
	local st = state[player]
	if st then
		dropCarried(player, "left")
		if st.base then
			freeBase(st.base)
		end
	end
	PlayerData.release(player)
	state[player] = nil
end)

game:BindToClose(function()
	PlayerData.saveAll()
end)

-- ---------- the launch pad ----------
local function pickCritter()
	local exclusive = {}
	for _, id in ipairs(Config.ExclusiveCritters) do
		exclusive[id] = true
	end
	local pool, total = {}, 0
	for name, r in pairs(Config.Rarities) do
		local list = {}
		for _, c in ipairs(Config.Critters) do
			if c.rarity == name and c.enabled ~= false and not exclusive[c.id] then
				table.insert(list, c)
			end
		end
		if #list > 0 then
			table.insert(pool, { weight = r.weight, list = list })
			total += r.weight
		end
	end
	local roll = math.random() * total
	for _, entry in ipairs(pool) do
		roll -= entry.weight
		if roll <= 0 then
			return entry.list[math.random(1, #entry.list)]
		end
	end
	local last = pool[#pool]
	return last.list[math.random(1, #last.list)]
end

local function rollMutation()
	local r = math.random()
	for _, m in ipairs(Config.Mutations) do -- rarest first
		if r < m.chance then
			return m
		end
		r -= m.chance
	end
	return nil
end

local FACING = CFrame.Angles(0, math.rad(-90), 0) -- critters face the way the pad moves

local function spawnOnPad()
	local def = pickCritter()
	local crit = makeCrit(def, rollMutation())
	local y = map.padY + radiusOf(def) + 0.4
	local model = CritterModels.build(def, CFrame.new(map.padStart, y, 0) * FACING, crit.mut)
	CritterModels.setInfo(model, addCommas(crit.price) .. " Stardust")
	CritterModels.setRate(model, "+" .. addCommas(crit.income) .. " Stardust/s") -- what it earns once it is in your base (Nolan, 2026-10-25)
	local item = { model = model, crit = crit, x = map.padStart, y = y, t = 0, taken = false }
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Grab (" .. addCommas(crit.price) .. ")"
	prompt.ObjectText = crit.name
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = model.PrimaryPart
	prompt.Triggered:Connect(function(who)
		tryBuy(who, item)
	end)
	model.Parent = map.critterFolder
	table.insert(conveyor, item)
	local order = Config.Rarities[def.rarity].order
	if def.family then -- one of Nolan's own friends
		tellAll("Nolan's friend " .. crit.name .. " landed on the launch pad! Quick, grab them!", "cosmic")
	elseif crit.mut and crit.mut.id == "rainbow" then
		tellAll("A RAINBOW critter landed on the launch pad: " .. crit.name .. "!", "cosmic")
	elseif order >= 4 then
		tellAll("A " .. def.rarity:upper() .. " critter landed on the launch pad: " .. crit.name .. "!", def.rarity == "Cosmic" and "cosmic" or "rare")
	end
end

RunService.Heartbeat:Connect(function(dt)
	for i = #conveyor, 1, -1 do
		local item = conveyor[i]
		if item.taken then
			table.remove(conveyor, i)
		else
			item.x += Config.ConveyorSpeed * dt
			item.t += dt
			if item.x > map.padEnd then
				item.model:Destroy()
				table.remove(conveyor, i)
			else
				item.model:PivotTo(CFrame.new(item.x, item.y + math.sin(item.t * 3) * 0.25, 0) * FACING)
			end
		end
	end
end)

task.spawn(function()
	while true do
		spawnOnPad()
		task.wait(Config.SpawnEvery)
	end
end)

-- ---------- Stardust stars and the Meteor Shower ----------
local starFolder = Instance.new("Folder")
starFolder.Name = "Stars"
starFolder.Parent = stationFolder
local stars = {} -- [part] = { bonus = n, shower = bool }
local rng = Random.new()

local function freeSpot()
	for _ = 1, 30 do
		local x, z = rng:NextNumber(-218, 218), rng:NextNumber(-140, 140)
		local ok = not (math.abs(z) < 12 and math.abs(x) < 72) -- not on the launch pad
		for _, base in ipairs(map.bases) do
			local p = base.cf:PointToObjectSpace(Vector3.new(x, 0, z))
			if math.abs(p.X) < base.halfW + 3 and math.abs(p.Z) < base.halfD + 3 then
				ok = false
			end
		end
		if ok then
			return Vector3.new(x, 2.6, z)
		end
	end
	return Vector3.new(rng:NextNumber(-60, 60), 2.6, 30)
end

local function makeStar(pos, shower)
	local s = Instance.new("Part")
	s.Name = "Star"
	s.Shape = Enum.PartType.Ball
	s.Size = shower and Vector3.new(2.6, 2.6, 2.6) or Vector3.new(2.1, 2.1, 2.1)
	s.Color = shower and Config.Colors.Blue or Config.Colors.Orange
	s.Material = Enum.Material.Neon
	s.Anchored = true
	s.CanCollide = false
	s.CanQuery = false
	s.CanTouch = false
	s.CFrame = CFrame.new(pos)
	s.CastShadow = false
	-- only the everyday stars carry a light (2026-10-25, lag on the iPad): a shower can have about 75 stars out at once, and a
	-- light on each one is a lot for a tablet to draw. The neon glows on its own.
	if not shower then
		local light = Instance.new("PointLight")
		light.Color = s.Color
		light.Range = 8
		light.Brightness = 1.6
		light.Parent = s
	end
	s.Parent = starFolder
	return s
end

local function spawnStar()
	local s = makeStar(freeSpot(), false)
	s:SetAttribute("Ready", true)
	stars[s] = { bonus = 1, shower = false }
end

for _ = 1, Config.Stars.count do
	spawnStar()
end

local function collect(player, s, info)
	stars[s] = nil
	local d = PlayerData.get(player)
	local st = state[player]
	if d then
		local value = math.max(Config.Stars.value, math.floor(incomeOf(st) * Config.Stars.incomeFactor)) * info.bonus
		d.stardust += value
		refreshStats(player)
		FX:FireClient(player, "pop", s.Position, "+" .. addCommas(value) .. " ★")
	end
	for _, p in ipairs(Players:GetPlayers()) do -- the grabber already saw it burst on their own screen
		if p ~= player then
			FX:FireClient(p, "burst", s.Position, s.Color)
		end
	end
	s:Destroy()
	if not info.shower then
		task.delay(rng:NextNumber(Config.Stars.respawnMin, Config.Stars.respawnMax), spawnStar)
	end
end

task.spawn(function()
	local reach = Config.Stars.pickupDistance
	while true do
		task.wait(0.12)
		for player in pairs(state) do
			local hrp = rootOf(player)
			if hrp then
				local p = hrp.Position
				for s, info in pairs(stars) do
					if s.Parent and s:GetAttribute("Ready") and (s.Position - p).Magnitude <= reach then
						collect(player, s, info)
					end
				end
			end
		end
	end
end)

local function meteorStar()
	local land = freeSpot()
	local s = makeStar(land + Vector3.new(rng:NextNumber(-40, 40), 160, rng:NextNumber(-40, 40)), true)
	stars[s] = { bonus = Config.MeteorStarBonus, shower = true }
	local tw = TweenService:Create(s, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = CFrame.new(land) })
	tw:Play()
	tw.Completed:Connect(function()
		if s.Parent then
			s:SetAttribute("Ready", true)
			FX:FireAllClients("meteor", land) -- a burst, and a little screen shake for anyone close (FX.client.lua)
			task.delay(25, function() -- uncollected shower stars fade away
				if s.Parent then
					stars[s] = nil
					s:Destroy()
				end
			end)
		end
	end)
end

-- a Meteor Shower: on its timer, or when the Captain presses the button (returns false if one is already falling)
local showerOn = false
local function meteorShower()
	if showerOn then
		return false
	end
	showerOn = true
	tellAll("METEOR SHOWER! Grab the falling stars, they're worth double!", "cosmic")
	FX:FireAllClients("shower", Config.MeteorSeconds)
	local t0 = os.clock()
	while os.clock() - t0 < Config.MeteorSeconds do
		meteorStar()
		task.wait(1 / Config.MeteorPerSecond)
	end
	showerOn = false
	return true
end

task.spawn(function()
	task.wait(Config.MeteorFirst)
	while true do
		meteorShower()
		task.wait(Config.MeteorEvery)
	end
end)

Drop.OnServerEvent:Connect(function(player)
	local st = state[player]
	if st and st.carrying then
		local at = st.carrying.model and st.carrying.model.PrimaryPart and st.carrying.model:GetPivot().Position
		dropCarried(player, "dropped")
		if at then
			FX:FireAllClients("burst", at, Config.Colors.Blue)
		end
	end
end)

-- ---------- expand your base: two more pedestals at a time ----------
Expand.OnServerEvent:Connect(function(player)
	local st = state[player]
	local d = PlayerData.get(player)
	if not (st and d and st.base) then
		return
	end
	local cost = Config.ExpandCosts[(st.base.unlocked - Config.PedestalsPerBase) / 2 + 1]
	if not cost then
		tell(player, "Your base is as big as it gets!", "info")
		return
	end
	if d.stardust < cost then
		tell(player, "Expanding costs " .. addCommas(cost) .. " Stardust. You need " .. addCommas(cost - d.stardust) .. " more.", "bad")
		return
	end
	d.stardust -= cost
	d.pedestals = math.min(Config.MaxPedestals, d.pedestals + 2)
	st.base.unlocked = d.pedestals
	pedestalLooks(st.base)
	refreshStats(player)
	FX:FireAllClients("confetti", st.base.cf.Position + Vector3.new(0, 4, 0))
	tell(player, "Base expanded! You have " .. d.pedestals .. " pedestals now.", "good")
end)

-- ---------- the pet that follows you (each screen draws it; Pets.client.lua) ----------
SetPet.OnServerEvent:Connect(function(player, key)
	local st = state[player]
	local d = PlayerData.get(player)
	if not (st and d) then
		return
	end
	if key == nil or key == "" then
		player:SetAttribute("Pet", nil)
		d.pet = nil
		return
	end
	if typeof(key) ~= "string" or not st.base then
		return
	end
	for _, rec in pairs(st.base.slots) do
		if rec.crit.key == key then
			player:SetAttribute("Pet", key)
			d.pet = key
			tell(player, rec.crit.name .. " is following you now!", "good")
			return
		end
	end
	tell(player, "That critter needs to be in your base to be your pet.", "info")
end)

-- ---------- Black Hole Night: lights out, the Void Creeper roams, hide in a locker ----------
local Lighting = game:GetService("Lighting")
local hidden = {} -- [player] = locker
local lockerUser = {} -- [locker] = player

local function unhide(player)
	local lk = hidden[player]
	if not lk then
		return
	end
	hidden[player] = nil
	lockerUser[lk] = nil
	lk.strip.Color = Config.Colors.Blue
	lk.prompt.ActionText = "Hide"
	local ch = player.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.Anchored = false
		ch:PivotTo(lk.front)
	end
end

for _, lk in ipairs(map.lockers or {}) do
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Hide"
	prompt.ObjectText = "Locker"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 7
	prompt.RequiresLineOfSight = false
	prompt.Parent = lk.body
	lk.prompt = prompt
	prompt.Triggered:Connect(function(player)
		if hidden[player] == lk then
			unhide(player)
			return
		end
		if lockerUser[lk] then
			tell(player, "Someone's already hiding in there!", "info")
			return
		end
		if hidden[player] then
			unhide(player)
		end
		local ch = player.Character
		local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
		if not hrp then
			return
		end
		hidden[player] = lk
		lockerUser[lk] = player
		ch:PivotTo(lk.inside)
		hrp.Anchored = true
		lk.strip.Color = Config.Colors.Orange
		prompt.ActionText = "Come out"
		tell(player, "You're hiding! Press E again to come out.", "info")
	end)
end

task.spawn(function() -- a hider who reset or respawned frees their locker
	while true do
		task.wait(1)
		for player, lk in pairs(hidden) do
			local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if not (hrp and hrp.Anchored) then
				hidden[player] = nil
				lockerUser[lk] = nil
				lk.strip.Color = Config.Colors.Blue
				lk.prompt.ActionText = "Hide"
			end
		end
	end
end)

Players.PlayerRemoving:Connect(function(player)
	local lk = hidden[player]
	if lk then
		lockerUser[lk] = nil
		hidden[player] = nil
		lk.strip.Color = Config.Colors.Blue
		lk.prompt.ActionText = "Hide"
	end
end)

local function buildCreeper(at)
	local m = Instance.new("Model")
	m.Name = "VoidCreeper"
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Shape = Enum.PartType.Ball
	body.Size = Vector3.new(7, 7, 7)
	body.Color = Color3.fromRGB(40, 20, 60)
	body.Material = Enum.Material.SmoothPlastic
	body.Anchored = true
	body.CanCollide = false
	body.CanQuery = false
	body.CFrame = at
	body.Parent = m
	m.PrimaryPart = body
	local function bit(name, size, color, offset, neon)
		local p = Instance.new("Part")
		p.Name = name
		p.Shape = Enum.PartType.Ball
		p.Size = size
		p.Color = color
		p.Material = neon and Enum.Material.Neon or Enum.Material.SmoothPlastic
		p.Anchored = false
		p.CanCollide = false
		p.CanQuery = false
		p.Massless = true
		p.CFrame = body.CFrame * offset
		local w = Instance.new("WeldConstraint")
		w.Part0 = body
		w.Part1 = p
		w.Parent = p
		p.Parent = m
	end
	for _, side in ipairs({ -1, 1 }) do -- big goofy glowing eyes
		bit("Eye", Vector3.new(1.8, 2.2, 1), Color3.fromRGB(240, 255, 255), CFrame.new(side * 1.3, 0.9, -3.0), true)
		bit("Pupil", Vector3.new(0.7, 0.9, 0.4), Color3.fromRGB(150, 60, 255), CFrame.new(side * 1.3, 0.8, -3.45), true)
	end
	bit("Mouth", Vector3.new(3, 0.8, 0.6), Color3.fromRGB(150, 60, 255), CFrame.new(0, -1.4, -3.1), true)
	for i = 1, 3 do -- a wobbly tail of shrinking blobs
		bit("Tail" .. i, Vector3.new(4.5, 4.5, 4.5) * (1 - i * 0.22), Color3.fromRGB(55, 28, 80), CFrame.new(0, -0.8 * i, 3 + i * 2.2))
	end
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(170, 80, 255)
	light.Range = 22
	light.Brightness = 3
	light.Parent = body
	local smoke = Instance.new("ParticleEmitter")
	smoke.Color = ColorSequence.new(Color3.fromRGB(90, 40, 140), Color3.fromRGB(20, 10, 30))
	smoke.Size = NumberSequence.new(2.5, 5)
	smoke.Transparency = NumberSequence.new(0.4, 1)
	smoke.Lifetime = NumberRange.new(1, 1.8)
	smoke.Rate = 20
	smoke.Speed = NumberRange.new(1, 3)
	smoke.Parent = body
	local tag = Instance.new("BillboardGui")
	tag.Size = UDim2.fromOffset(220, 40)
	tag.StudsOffsetWorldSpace = Vector3.new(0, 6, 0)
	tag.LightInfluence = 0
	tag.Parent = body
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = Color3.fromRGB(200, 140, 255)
	l.TextStrokeTransparency = 0.2
	l.Text = "Void Creeper"
	l.Parent = tag
	m.Parent = stationFolder
	return m
end

local nightLighting = { Ambient = Color3.fromRGB(28, 16, 48), OutdoorAmbient = Color3.fromRGB(34, 20, 60), Brightness = 0.25 }
local function setNight(on)
	local cc = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
	if on then
		Lighting:SetAttribute("DayAmbient", Lighting.Ambient)
		Lighting:SetAttribute("DayOutdoor", Lighting.OutdoorAmbient)
		Lighting:SetAttribute("DayBrightness", Lighting.Brightness)
		TweenService:Create(Lighting, TweenInfo.new(2.5), nightLighting):Play()
		if cc then
			TweenService:Create(cc, TweenInfo.new(2.5), { TintColor = Color3.fromRGB(190, 160, 255) }):Play()
		end
	else
		TweenService:Create(Lighting, TweenInfo.new(2.5), {
			Ambient = Lighting:GetAttribute("DayAmbient") or Color3.fromRGB(70, 80, 115),
			OutdoorAmbient = Lighting:GetAttribute("DayOutdoor") or Color3.fromRGB(90, 100, 140),
			Brightness = Lighting:GetAttribute("DayBrightness") or 1.2,
		}):Play()
		if cc then
			TweenService:Create(cc, TweenInfo.new(2.5), { TintColor = Color3.new(1, 1, 1) }):Play()
		end
	end
end

-- inside any base, with some room to spare (2026-10-18, Matthew: "Void creepers should not be allowed in your base")
local function inAnyBase(pos, margin)
	for _, b in ipairs(map.bases) do
		local p = b.cf:PointToObjectSpace(pos)
		if math.abs(p.X) < b.halfW + margin and math.abs(p.Z) < b.halfD + margin then
			return true
		end
	end
	return false
end

local function blackHoleNight()
	workspace:SetAttribute("BlackHoleUntil", now() + Config.NightSeconds)
	tellAll("BLACK HOLE NIGHT! The Void Creeper is loose. Hide in a locker or run!", "cosmic")
	FX:FireAllClients("night", Config.NightSeconds)
	setNight(true)
	local creeper = buildCreeper(CFrame.new(-60, 40, 0))
	local pos = Vector3.new(-60, 40, 0)
	local ignore = {} -- [player] = time it can chase them again
	local pauseUntil = 0
	local wander = Vector3.new(0, 5, 0)
	local t0 = os.clock()
	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		if os.clock() - t0 > Config.NightSeconds then
			return
		end
		local t = os.clock()
		-- chase the nearest player who isn't hiding
		local target, best = nil, math.huge
		for player in pairs(state) do
			local hrp = rootOf(player)
			if hrp and not hidden[player] and (ignore[player] or 0) < t and not inAnyBase(hrp.Position, 0) then
				local dist = (hrp.Position - pos).Magnitude
				if dist < best then
					target, best = hrp, dist
				end
			end
		end
		local goal
		if target and best < 160 then
			goal = Vector3.new(target.Position.X, 4.5, target.Position.Z)
		else
			if (wander - pos).Magnitude < 4 or inAnyBase(wander, 4) then
				wander = Vector3.new(rng:NextNumber(-200, 200), 4.5, rng:NextNumber(-130, 130))
			end
			goal = wander
		end
		if t > pauseUntil then
			local step = goal - pos
			local speed = (pos.Y > 6) and 30 or Config.CreeperSpeed -- swoops down fast at the start
			if step.Magnitude > 0.1 then
				local move = step.Unit * math.min(step.Magnitude, speed * dt)
				-- never into a base: slide along its wall instead, or turn away
				if not inAnyBase(pos + move, 3) then
					pos += move
				elseif not inAnyBase(pos + Vector3.new(move.X, 0, 0), 3) then
					pos += Vector3.new(move.X, 0, 0)
				elseif not inAnyBase(pos + Vector3.new(0, 0, move.Z), 3) then
					pos += Vector3.new(0, 0, move.Z)
				else
					wander = Vector3.new(rng:NextNumber(-200, 200), 4.5, rng:NextNumber(-130, 130))
				end
			end
		end
		local look = target and Vector3.new(target.Position.X, pos.Y, target.Position.Z) or (pos + Vector3.new(0, 0, -1))
		if (look - pos).Magnitude < 0.1 then
			look = pos + Vector3.new(0, 0, -1)
		end
		creeper:PivotTo(CFrame.lookAt(pos + Vector3.new(0, math.sin(t * 4) * 0.6, 0), look))
		-- boop! anyone it reaches drops what they carry and is sent back to their base
		for player, st in pairs(state) do
			local hrp = rootOf(player)
			if hrp and not hidden[player] and (ignore[player] or 0) < t and not inAnyBase(hrp.Position, 0) and (hrp.Position - pos).Magnitude <= Config.CreeperReach then
				ignore[player] = t + 6
				pauseUntil = t + 1.5
				if st.carrying then
					dropCarried(player, "creeper")
				end
				FX:FireClient(player, "booped")
				tell(player, "The Void Creeper booped you back to your base!", "bad")
				if st.base and player.Character then
					player.Character:PivotTo(st.base.cf * CFrame.new(0, 4, -10))
				end
			end
		end
	end)
	task.wait(Config.NightSeconds)
	conn:Disconnect()
	creeper:Destroy()
	setNight(false)
	workspace:SetAttribute("BlackHoleUntil", 0)
	tellAll("The lights are back on. The Void Creeper has gone... for now.", "good")
end

if Config.BlackHoleNight then
	task.spawn(function()
		task.wait(Config.NightFirst)
		while true do
			blackHoleNight()
			task.wait(Config.NightEvery)
		end
	end)
end

-- ---------- punching, critters on the floor, Parker Bots (2026-10-18, Matthew; named Parker Bots the same day) ----------
local Punch = remote("Punch")
local floorItems = {} -- [model] = { crit, owner, slot, expires }
local bots = {}

local function sendHome(player)
	local st = state[player]
	if st and st.base and player.Character then
		player.Character:PivotTo(st.base.cf * CFrame.new(0, 4, -10))
	end
end

local function slotFor(base, want)
	if want and want <= base.unlocked and not base.slots[want] then
		return want
	end
	return freeSlot(base)
end

-- an unclaimed critter on the floor goes back to whoever it belonged to
local function returnToOwner(item)
	local owner = item.owner
	local ost = owner and state[owner]
	local od = owner and PlayerData.get(owner)
	if not (ost and ost.base and od) then
		return false
	end
	local slot = slotFor(ost.base, item.slot)
	if not slot then
		return false
	end
	placeOnPedestal(ost.base, slot, item.crit)
	od.slots[tostring(slot)] = item.crit.key
	refreshStats(owner)
	tell(owner, "Your " .. item.crit.name .. " came back home!", "good")
	return true
end

local function putOnFloor(model, crit, owner, slot, pos)
	local body = model.PrimaryPart
	local w = body:FindFirstChild("CarryWeld")
	if w then
		w:Destroy()
	end
	body.Anchored = true
	model:PivotTo(CFrame.new(pos.X, 1.2 + radiusOf(crit.def), pos.Z))
	CritterModels.setInfo(model, "Knocked loose! Grab it!")
	local item = { model = model, crit = crit, owner = owner, slot = slot, expires = os.clock() + Config.Punch.floorSeconds }
	floorItems[model] = item
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Grab"
	prompt.ObjectText = crit.name
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = body
	prompt.Triggered:Connect(function(who)
		if floorItems[model] ~= item then
			return
		end
		local st = state[who]
		if not st then
			return
		end
		if st.carrying then
			tell(who, "Your hands are full!", "bad")
			return
		end
		if who == item.owner and st.base then -- your own critter: straight back home
			local s2 = slotFor(st.base, item.slot)
			if s2 then
				floorItems[model] = nil
				local at = model:GetPivot().Position
				model:Destroy()
				placeOnPedestal(st.base, s2, crit)
				local od = PlayerData.get(who)
				if od then
					od.slots[tostring(s2)] = crit.key
				end
				refreshStats(who)
				FX:FireAllClients("confetti", at)
				tell(who, "You got your " .. crit.name .. " back! It's home again.", "good")
				return
			end
		end
		if not (st.base and freeSlot(st.base)) then
			tell(who, "Your base is full!", "bad")
			return
		end
		floorItems[model] = nil
		if not attach(who, model, crit, { owner = item.owner, slot = item.slot }) then
			floorItems[model] = item
			return
		end
		tell(who, "Grabbed " .. crit.name .. "! Get it to your base!", "good")
	end)
end

-- returns true when the victim was carrying something and it fell
local function knockOff(victim)
	local st = state[victim]
	local c = st and st.carrying
	if not c then
		return false
	end
	local hrp = rootOf(victim)
	clearCarry(victim)
	local owner = (c.from and c.from.owner) or victim -- a bought one still belongs to the buyer
	local pos = hrp and (hrp.Position - hrp.CFrame.LookVector * 3) or c.model:GetPivot().Position
	putOnFloor(c.model, c.crit, owner, c.from and c.from.slot or nil, pos)
	return true
end

task.spawn(function()
	while true do
		task.wait(1)
		local t = os.clock()
		for model, item in pairs(floorItems) do
			if t > item.expires then
				floorItems[model] = nil
				returnToOwner(item)
				model:Destroy()
			end
		end
	end
end)

-- ---------- the Gear Bay: buying gear, and handing it out every time you spawn (2026-10-18, Matthew) ----------
local GearTools = require(script.Parent.GearTools)

local function hasTool(player, id)
	for _, holder in ipairs({ player:FindFirstChildOfClass("Backpack"), player.Character }) do
		if holder then
			for _, t in ipairs(holder:GetChildren()) do
				if t:IsA("Tool") and t:GetAttribute("GearId") == id then
					return true
				end
			end
		end
	end
	return false
end

local function giveGear(player)
	local d = PlayerData.get(player)
	local ch = player.Character
	if not (d and ch) then
		return
	end
	for _, g in ipairs(Config.Gear) do
		if d.gear[g.id] then
			player:SetAttribute("Owns_" .. g.id, true) -- the Gear Bay prompts read this on your screen
			if g.kind == "weapon" then
				local backpack = player:FindFirstChildOfClass("Backpack")
				if backpack and not hasTool(player, g.id) then
					local t = GearTools.tool(g.id)
					if t then
						t.Parent = backpack
					end
				end
			elseif g.id == "boots" then
				ch:SetAttribute("JetBoots", g.boost) -- every screen draws the flames; your own screen does the boost
				local hum = ch:FindFirstChildOfClass("Humanoid")
				if hum then
					hum.UseJumpPower = false
					hum.JumpHeight = g.jumpHeight
				end
				GearTools.fitBoots(ch)
			end
		end
	end
end

local function onGearCharacter(player, ch)
	task.spawn(function()
		ch:WaitForChild("Humanoid", 10)
		local t0 = os.clock()
		while player.Parent and ch.Parent and os.clock() - t0 < 10 and not (PlayerData.get(player) and player:HasAppearanceLoaded()) do
			task.wait(0.25) -- wait for the save to load and the avatar's body parts to settle, so the boots stay on
		end
		if player.Parent and ch.Parent then
			giveGear(player)
		end
	end)
end
local function hookGear(player)
	player.CharacterAdded:Connect(function(ch)
		onGearCharacter(player, ch)
	end)
	if player.Character then
		onGearCharacter(player, player.Character)
	end
end
Players.PlayerAdded:Connect(hookGear)
for _, p in ipairs(Players:GetPlayers()) do
	hookGear(p)
end

for id, stand in pairs(map.gearStands or {}) do
	local def = Config.gearById(id)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Buy (" .. addCommas(def.price) .. " ★)"
	prompt.ObjectText = def.name
	prompt.HoldDuration = 0.4
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("GearId", id)
	prompt.Parent = stand
	prompt.Triggered:Connect(function(player)
		local d = PlayerData.get(player)
		if not d then
			return
		end
		if d.gear[id] then
			giveGear(player)
			tell(player, def.kind == "weapon" and ("Your " .. def.name .. " is in your backpack.") or ("Your " .. def.name .. " are on!"), "info")
			return
		end
		if d.stardust < def.price then
			tell(player, "The " .. def.name .. " costs " .. addCommas(def.price) .. " Stardust. Keep collecting!", "bad")
			return
		end
		d.stardust -= def.price
		d.gear[id] = true
		refreshStats(player)
		giveGear(player)
		sfx("gear", nil, player)
		FX:FireAllClients("confetti", stand.Position + Vector3.new(0, 5, 0))
		if def.kind == "weapon" then
			tell(player, "You got the " .. def.name .. "! Pick it in your backpack, then use it with Q, a click, or the " .. def.button .. " button.", "good")
		else
			tell(player, "You got the " .. def.name .. "! Jump, then jump again in the air for a rocket boost.", "good")
		end
	end)
end

-- the nearest player or Parker Bot within reach and roughly in front
local function findTarget(player, hrp, reach, minDot)
	local look = hrp.CFrame.LookVector
	local best, bestD, kind, pos = nil, math.huge, nil, nil
	for other in pairs(state) do
		local oh = other ~= player and not hidden[other] and rootOf(other)
		if oh then
			local v = oh.Position - hrp.Position
			local d = v.Magnitude
			if d <= reach and d < bestD and (d < 1.5 or v.Unit:Dot(look) > minDot) then
				best, bestD, kind, pos = other, d, "player", oh.Position
			end
		end
	end
	for _, bot in ipairs(bots) do
		local v = bot.pos - hrp.Position
		local d = v.Magnitude
		if d <= reach + 2 and d < bestD and (d < 1.5 or v.Unit:Dot(look) > minDot - 0.1) then
			best, bestD, kind, pos = bot, d, "bot", bot.pos
		end
	end
	return best, kind, pos
end

-- what a landed hit does, from a fist, the glove or a star bolt
local function hit(player, hrp, best, kind, knockMul, stun)
	local d = PlayerData.get(player)
	local power = d and d.upgrades.stun or 0 -- Stun Power level (2026-10-18)
	if kind == "bot" then
		stun += power
		best.stunUntil = os.clock() + stun
		FX:FireAllClients("pow", best.pos)
		tell(player, "Parker Bot stunned!", "good")
		return
	end
	local oh = rootOf(best)
	if not oh then
		return
	end
	FX:FireAllClients("pow", oh.Position)
	local dir = (oh.Position - hrp.Position) * Vector3.new(1, 0, 1)
	if dir.Magnitude < 0.1 then
		dir = hrp.CFrame.LookVector
	end
	FX:FireClient(best, "knock", dir.Unit * knockMul)
	local och = best.Character
	if och then -- slowed for a moment, with stars round their head; longer with Stun Power
		local secs = Config.StunBase + power * Config.StunPerLevel
		och:SetAttribute("StunnedUntil", now() + secs)
		FX:FireAllClients("dizzy", best, secs)
	end
	if knockOff(best) then
		tell(best, player.DisplayName .. " knocked your critter loose!", "bad")
		tell(player, "Knocked it loose! Grab it!", "good")
	end
end

local lastPunch = {}
Punch.OnServerEvent:Connect(function(player)
	local ch = player.Character
	local tool = ch and ch:FindFirstChildOfClass("Tool")
	local gid = tool and tool:GetAttribute("GearId")
	local g = gid and Config.gearById(gid)
	local d = PlayerData.get(player)
	if g and not (d and d.gear[gid]) then
		g, gid = nil, nil
	end
	local t = os.clock()
	if (lastPunch[player] or 0) + (g and g.cooldown or Config.Punch.cooldown) > t then
		return
	end
	lastPunch[player] = t
	local hrp = rootOf(player)
	if not hrp or hidden[player] then
		return
	end
	local look = hrp.CFrame.LookVector

	if gid == "blaster" then -- a star bolt at whoever is in front, stopped by walls and locked doors
		local best, kind, pos = findTarget(player, hrp, g.range, 0.85)
		local muzzle = tool:FindFirstChild("Handle") and tool.Handle:FindFirstChild("Muzzle")
		local from = muzzle and muzzle.WorldPosition or (hrp.Position + look * 3)
		local to = pos or (from + look * g.range)
		local ignore = { map.critterFolder }
		for p in pairs(state) do
			if p.Character then
				table.insert(ignore, p.Character)
			end
		end
		for _, bot in ipairs(bots) do
			table.insert(ignore, bot.model)
		end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = ignore
		local ray = workspace:Raycast(from, to - from, params)
		if ray then
			to, best = ray.Position, nil
		end
		FX:FireAllClients("blast", player, from, to, best ~= nil)
		if best then
			hit(player, hrp, best, kind, g.knock, g.stun)
		end
		return
	end

	local best, kind = findTarget(player, hrp, g and g.reach or Config.Punch.reach, 0.2)
	FX:FireAllClients("swing", hrp.Position + look * 3, player, gid or "fist")
	if best then
		hit(player, hrp, best, kind, g and g.knock or 1, g and g.stun or Config.Bots.stunSeconds)
	end
end)

-- the patrol route: along both walkways, up and back down every lane to a base
local route = {}
local lanes = { -171, -57, 57, 171 }
for _, side in ipairs({ 1, -1 }) do
	local xs = side == 1 and lanes or { 171, 57, -57, -171 }
	for _, x in ipairs(xs) do
		table.insert(route, Vector3.new(x, 3.5, 22 * side))
		table.insert(route, Vector3.new(x, 3.5, 62 * side))
		table.insert(route, Vector3.new(x, 3.5, 22 * side))
	end
end

local function buildBot(i, at)
	local m = Instance.new("Model")
	m.Name = "ParkerBot" .. i
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Size = Vector3.new(3, 3.2, 2.6)
	body.Color = Color3.fromRGB(88, 96, 122)
	body.Material = Enum.Material.Metal
	body.Anchored = true
	body.CanCollide = false
	body.CanQuery = false
	body.CFrame = CFrame.new(at)
	body.Parent = m
	m.PrimaryPart = body
	local function bit(name, size, color, offset, opts)
		opts = opts or {}
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color
		p.Material = opts.neon and Enum.Material.Neon or Enum.Material.Metal
		if opts.ball then
			p.Shape = Enum.PartType.Ball
		elseif opts.cyl then
			p.Shape = Enum.PartType.Cylinder
		end
		p.Anchored = false
		p.CanCollide = false
		p.CanQuery = false
		p.Massless = true
		p.CFrame = body.CFrame * offset
		local w = Instance.new("WeldConstraint")
		w.Part0 = body
		w.Part1 = p
		w.Parent = p
		p.Parent = m
		return p
	end
	bit("Head", Vector3.new(2.4, 1.6, 2.2), Color3.fromRGB(110, 118, 146), CFrame.new(0, 2.4, 0))
	local eye = bit("Visor", Vector3.new(2.0, 0.55, 0.2), Color3.fromRGB(255, 80, 80), CFrame.new(0, 2.5, -1.12), { neon = true })
	bit("Antenna", Vector3.new(0.2, 1, 0.2), Color3.fromRGB(60, 64, 82), CFrame.new(0, 3.7, 0))
	local siren = bit("Siren", Vector3.new(0.7, 0.7, 0.7), Color3.fromRGB(80, 140, 255), CFrame.new(0, 4.3, 0), { neon = true, ball = true })
	bit("Badge", Vector3.new(1.2, 0.8, 0.12), Config.Colors.Orange, CFrame.new(0, 0.4, -1.32), { neon = true })
	for _, side in ipairs({ -1, 1 }) do
		bit("Arm", Vector3.new(0.6, 2.2, 0.6), Color3.fromRGB(70, 76, 98), CFrame.new(side * 1.85, 0, 0) * CFrame.Angles(0, 0, side * 0.2))
	end
	local jet = bit("Thruster", Vector3.new(0.6, 1.8, 1.8), Config.Colors.Blue, CFrame.new(0, -1.9, 0) * CFrame.Angles(0, 0, math.rad(90)), { neon = true, cyl = true })
	local flame = Instance.new("ParticleEmitter")
	flame.Color = ColorSequence.new(Config.Colors.Blue)
	flame.LightEmission = 1
	flame.Size = NumberSequence.new(0.8, 0)
	flame.Lifetime = NumberRange.new(0.2, 0.4)
	flame.Rate = 30
	flame.Speed = NumberRange.new(4, 6)
	flame.EmissionDirection = Enum.NormalId.Left -- after the quarter turn the cylinder's -X points down
	flame.Parent = jet
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 90, 90)
	light.Range = 14
	light.Parent = siren
	local tag = Instance.new("BillboardGui")
	tag.Size = UDim2.fromOffset(160, 34)
	tag.StudsOffsetWorldSpace = Vector3.new(0, 5.5, 0)
	tag.MaxDistance = 70
	tag.LightInfluence = 0
	tag.Parent = body
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = Color3.fromRGB(255, 120, 120)
	l.TextStrokeTransparency = 0.2
	l.Text = "Parker Bot"
	l.Parent = tag
	m.Parent = stationFolder
	return { model = m, eye = eye, siren = siren, light = light, label = l }
end

for i = 1, Config.Bots.count do
	local wp = math.floor((i - 1) * #route / Config.Bots.count) + 1
	local b = buildBot(i, route[wp])
	b.pos, b.wp, b.look, b.stunUntil, b.phase = route[wp], wp % #route + 1, Vector3.new(0, 0, -1), 0, i * 2
	table.insert(bots, b)
end

RunService.Heartbeat:Connect(function(dt)
	local t = os.clock()
	for _, bot in ipairs(bots) do
		local stunned = t < bot.stunUntil
		local chasing = nil
		if not stunned then
			local goal, speed
			local bd = Config.Bots.sight
			for player, st in pairs(state) do
				local hrp = rootOf(player)
				if st.carrying and hrp and not hidden[player] then
					local safe = false
					for _, b in ipairs(map.bases) do
						if insideBase(b, hrp.Position) then
							safe = true
						end
					end
					local d = (hrp.Position - bot.pos).Magnitude
					if not safe and d < bd then
						chasing, bd = player, d
					end
				end
			end
			if chasing and bot.target ~= chasing then
				sfx("bot", bot.pos)
			end
			bot.target = chasing
			if chasing then
				local hp = rootOf(chasing).Position
				goal, speed = Vector3.new(hp.X, 3.5, hp.Z), Config.Bots.chaseSpeed
				if bd <= Config.Bots.reach then -- caught: it takes the critter and zaps them home
					bot.stunUntil = t + 1.5
					dropCarried(chasing, "bot")
					sendHome(chasing)
					FX:FireClient(chasing, "zapped")
					tell(chasing, "A Parker Bot took your critter and zapped you back to base!", "bad")
				end
			else
				local wp = route[bot.wp]
				goal, speed = wp, Config.Bots.speed
				if (wp - bot.pos).Magnitude < 2 then
					bot.wp = bot.wp % #route + 1
				end
			end
			local step = goal - bot.pos
			if step.Magnitude > 0.05 then
				bot.pos += step.Unit * math.min(step.Magnitude, speed * dt)
				bot.look = Vector3.new(step.X, 0, step.Z).Magnitude > 0.05 and Vector3.new(step.X, 0, step.Z).Unit or bot.look
			end
		end
		local wobble = stunned and CFrame.Angles(math.sin(t * 20) * 0.15, 0, math.cos(t * 17) * 0.15) or CFrame.new()
		bot.model:PivotTo(CFrame.lookAt(bot.pos + Vector3.new(0, math.sin(t * 3 + bot.phase) * 0.3, 0), bot.pos + bot.look) * wobble)
		local red, blue = Color3.fromRGB(255, 60, 60), Color3.fromRGB(80, 140, 255)
		bot.siren.Color = stunned and Color3.fromRGB(90, 90, 100) or (chasing and ((math.floor(t * 6) % 2 == 0) and red or blue) or blue)
		bot.eye.Color = stunned and Color3.fromRGB(80, 80, 90) or red
		bot.label.Text = stunned and "Parker Bot (stunned!)" or (chasing and "Parker Bot: STOP!" or "Parker Bot")
	end
end)

-- ---------- the Moon Rover (2026-10-18, Matthew: "make it so you can drive the rover") ----------
-- Walk up and press E (or tap Drive) to get in; WASD or the joystick drives, Jump gets out. The driver's own screen steers it
-- (Rover.client.lua), so it feels instant. No critters in the rover: it's faster than the Parker Bots, so stealing by rover
-- would be too easy. Left alone away from its spot, it drives itself home after a while.
local PhysicsService = game:GetService("PhysicsService")
pcall(function()
	PhysicsService:RegisterCollisionGroup("Rover")
	PhysicsService:RegisterCollisionGroup("Players")
	PhysicsService:CollisionGroupSetCollidable("Rover", "Players", false) -- it never runs anyone over
end)
local function playerGroup(ch)
	for _, p in ipairs(ch:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CollisionGroup = "Players"
		end
	end
	ch.DescendantAdded:Connect(function(p)
		if p:IsA("BasePart") then
			p.CollisionGroup = "Players"
		end
	end)
end
local function hookGroup(player)
	player.CharacterAdded:Connect(playerGroup)
	if player.Character then
		playerGroup(player.Character)
	end
end
Players.PlayerAdded:Connect(hookGroup)
for _, p in ipairs(Players:GetPlayers()) do
	hookGroup(p)
end

local rover = map.rover
local roverSeat = rover and rover:FindFirstChild("DriverSeat")
if rover and roverSeat and rover.PrimaryPart then
	local hull = rover.PrimaryPart
	local home = rover:GetPivot()
	local lv = hull:FindFirstChildOfClass("LinearVelocity")
	local turn = hull:FindFirstChildOfClass("AlignOrientation")
	for _, p in ipairs(rover:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CollisionGroup = "Rover"
		end
	end
	pcall(function()
		hull:SetNetworkOwner(nil)
	end)
	local lastUsed = os.clock()

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Drive"
	prompt.ObjectText = "Moon Rover"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = roverSeat
	prompt.Triggered:Connect(function(player)
		local st = state[player]
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if not hum or roverSeat.Occupant then
			return
		end
		if st and st.carrying then
			tell(player, "No critters in the rover! Take it to your base first.", "bad")
			return
		end
		roverSeat:Sit(hum)
	end)

	local function stop()
		if lv then
			lv.VectorVelocity = Vector3.zero
		end
		if turn then
			local _, yaw = hull.CFrame:ToEulerAnglesYXZ()
			turn.CFrame = CFrame.Angles(0, yaw, 0)
		end
	end
	roverSeat:GetPropertyChangedSignal("Occupant"):Connect(function()
		local hum = roverSeat.Occupant
		local player = hum and Players:GetPlayerFromCharacter(hum.Parent)
		if player then
			prompt.Enabled = false
			pcall(function()
				hull:SetNetworkOwner(player)
			end)
			tell(player, "You're driving the Moon Rover! Steer with WASD or the joystick. Jump to get out.", "good")
		else
			prompt.Enabled = true
			lastUsed = os.clock()
			pcall(function()
				hull:SetNetworkOwner(nil)
			end)
			stop()
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.5)
			local hum = roverSeat.Occupant
			local player = hum and Players:GetPlayerFromCharacter(hum.Parent)
			if player and state[player] and state[player].carrying then -- picked something up while driving
				hum.Sit = false
				tell(player, "No critters in the rover! Out you hop.", "bad")
			end
			local far = (hull.Position - home.Position).Magnitude > 8
			if hull.Position.Y < -30 or (not hum and far and os.clock() - lastUsed > 30) then
				stop()
				rover:PivotTo(home)
				hull.AssemblyLinearVelocity = Vector3.zero
				hull.AssemblyAngularVelocity = Vector3.zero
				local _, yaw = home:ToEulerAnglesYXZ()
				if turn then
					turn.CFrame = CFrame.Angles(0, yaw, 0)
				end
				lastUsed = os.clock()
			end
		end
	end)
end

-- ---------- Low Gravity (2026-10-18, Matthew: "add a low gravity event, like we have the meteor shower and the black hole") ----------
local NORMAL_GRAVITY = workspace.Gravity
local lowGravOn = false
local function lowGravity()
	if lowGravOn then
		return false
	end
	lowGravOn = true
	workspace.Gravity = Config.LowGravityValue
	workspace:SetAttribute("LowGravityUntil", now() + Config.LowGravitySeconds)
	tellAll("LOW GRAVITY! Everyone floats. Jump!", "cosmic")
	FX:FireAllClients("lowgrav", Config.LowGravitySeconds)
	task.delay(Config.LowGravitySeconds, function()
		workspace.Gravity = NORMAL_GRAVITY
		lowGravOn = false
		tellAll("Gravity is back to normal.", "info")
	end)
	return true
end
if Config.LowGravity then
	task.spawn(function()
		task.wait(Config.LowGravityFirst)
		while true do
			lowGravity()
			task.wait(Config.LowGravityEvery)
		end
	end)
end

-- ---------- rocket launches (2026-10-18, Matthew: "can the rockets launch into the sky?") ----------
-- Anyone can press LAUNCH. Every screen counts down and flies the rocket itself (FX.client.lua); the server only keeps
-- time, so a new rocket is back on the pad Config.RocketBackAfter seconds after liftoff.
local rocketBusy = {}
local function launchRocket(m)
	if rocketBusy[m] then
		return false
	end
	rocketBusy[m] = true
	FX:FireAllClients("launch", m, Config.RocketCountdown)
	task.delay(Config.RocketCountdown + Config.RocketBackAfter, function()
		FX:FireAllClients("rocketback", m)
		rocketBusy[m] = nil
	end)
	return true
end
for _, m in ipairs(map.rockets or {}) do
	local button = m:FindFirstChild("LaunchConsole")
	if button then
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Launch!"
		prompt.ObjectText = "Rocket"
		prompt.HoldDuration = 0.3
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt.Parent = button
		prompt.Triggered:Connect(function(player)
			if launchRocket(m) then
				tellAll(player.DisplayName .. " is launching a rocket! " .. Config.RocketCountdown .. "... ", "cosmic")
			else
				tell(player, "That rocket is already on its way. A new one will be on the pad soon!", "info")
			end
		end)
	end
end

-- ---------- Captain Nolan (2026-10-18): hat, name tag, a greeting, and his control panel ----------
local function isCaptain(player)
	if Config.ExclusiveUserId ~= 0 and player.UserId == Config.ExclusiveUserId then
		return true
	end
	return Config.CaptainInStudio and RunService:IsStudio()
end

local function captainHat(ch, real)
	local head = ch:WaitForChild("Head", 10)
	if not head or ch:FindFirstChild("CaptainHat") then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "CaptainHat"
	folder.Parent = ch
	local hs = head.Size.Y / 1.2 -- the hat fits the head it sits on
	local function bit(name, size, color, offset, opts)
		opts = opts or {}
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size * hs
		p.Color = color
		p.Material = opts.neon and Enum.Material.Neon or Enum.Material.SmoothPlastic
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.CastShadow = false
		if opts.cyl then
			p.Shape = Enum.PartType.Cylinder
		end
		if opts.ball then
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = p
		end
		p.CFrame = head.CFrame * offset
		local w = Instance.new("WeldConstraint")
		w.Part0 = head
		w.Part1 = p
		w.Parent = p
		p.Parent = folder
		return p
	end
	local up = CFrame.Angles(0, 0, math.rad(90)) -- stand a cylinder upright
	local y = 0.62 * hs
	bit("Crown", Vector3.new(0.5, 1.3, 1.3), Color3.fromRGB(28, 40, 86), CFrame.new(0, y + 0.1 * hs, 0) * up, { cyl = true })
	bit("CapTop", Vector3.new(0.16, 1.5, 1.5), Color3.fromRGB(245, 246, 252), CFrame.new(0, y + 0.42 * hs, -0.05 * hs) * CFrame.Angles(math.rad(-8), 0, 0) * up, { cyl = true })
	bit("CapBand", Vector3.new(0.14, 1.34, 1.34), Config.Colors.Orange, CFrame.new(0, y - 0.05 * hs, 0) * up, { cyl = true, neon = true })
	bit("Brim", Vector3.new(1.2, 0.12, 0.75), Color3.fromRGB(20, 22, 34), CFrame.new(0, y - 0.12 * hs, -0.58 * hs) * CFrame.Angles(math.rad(12), 0, 0), { ball = true })
	bit("Badge", Vector3.new(0.34, 0.34, 0.1), Color3.fromRGB(255, 205, 70), CFrame.new(0, y + 0.12 * hs, -0.66 * hs), { ball = true, neon = true })
	local tag = Instance.new("BillboardGui")
	tag.Name = "CaptainTag"
	tag.Size = UDim2.fromOffset(240, 40)
	tag.StudsOffsetWorldSpace = Vector3.new(0, 3.2, 0)
	tag.MaxDistance = 120
	tag.LightInfluence = 0
	tag.Parent = head
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = Config.Colors.Orange
	l.TextStrokeTransparency = 0.2
	l.Text = real and ("★ " .. Config.CommanderName .. " ★") or "★ Captain (Studio test) ★"
	l.Parent = tag
end

local function hookCaptain(player)
	if not isCaptain(player) then
		return
	end
	local real = player.UserId == Config.ExclusiveUserId
	player:SetAttribute("Captain", true)
	player.CharacterAdded:Connect(function(ch)
		captainHat(ch, real)
	end)
	if player.Character then
		task.spawn(captainHat, player.Character, real)
	end
	task.delay(3, function() -- after the title screen
		if player.Parent then
			FX:FireAllClients("captain", real and Config.CommanderName or "Captain")
			if real then
				tellAll(Config.CommanderName .. " has arrived on the station! Captain on deck!", "cosmic")
			end
		end
	end)
end
Players.PlayerAdded:Connect(hookCaptain)
for _, p in ipairs(Players:GetPlayers()) do
	hookCaptain(p)
end

-- the light themes the Captain can switch between
local themes = {
	{ name = "Normal", tint = Color3.new(1, 1, 1) },
	{ name = "Sunset Orange", tint = Color3.fromRGB(255, 214, 178) },
	{ name = "Ocean Blue", tint = Color3.fromRGB(186, 218, 255) },
	{ name = "Party Pink", tint = Color3.fromRGB(255, 196, 232) },
	{ name = "Alien Green", tint = Color3.fromRGB(200, 255, 200) },
}
local themeIndex = 1

-- the control panel in front of his statue: five big buttons, only the Captain sees or can press them
local panelAt = CFrame.new(140, 0, 0) * CFrame.Angles(0, math.rad(90), 0) -- its front faces the statue
local panel = Instance.new("Model")
panel.Name = "CaptainPanel"
panel.Parent = stationFolder
local function panelPart(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.Metal
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = panel
	return p
end
panelPart({ Name = "Desk", Size = Vector3.new(14, 3.2, 3.4), Color = Color3.fromRGB(70, 78, 104), CFrame = panelAt * CFrame.new(0, 1.6, 0) })
panelPart({ Name = "DeskTop", Size = Vector3.new(14.4, 0.4, 3.8), Color = Color3.fromRGB(40, 44, 62), CFrame = panelAt * CFrame.new(0, 3.3, 0) * CFrame.Angles(math.rad(-12), 0, 0) })
local screen = panelPart({ Name = "Screen", Size = Vector3.new(12, 3.2, 0.4), Color = Config.Colors.Dark, CFrame = panelAt * CFrame.new(0, 6, 1.4) })
local sg = Instance.new("SurfaceGui")
sg.Face = Enum.NormalId.Front
sg.LightInfluence = 0
sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
sg.PixelsPerStud = 40
sg.Parent = screen
local sl = Instance.new("TextLabel")
sl.Size = UDim2.fromScale(1, 1)
sl.BackgroundTransparency = 1
sl.Font = Enum.Font.FredokaOne
sl.TextScaled = true
sl.TextColor3 = Config.Colors.Orange
sl.Text = "CAPTAIN'S CONTROLS"
sl.Parent = sg

local lastUse = {}
local buttons = {
	{ id = "shower", label = "Meteor Shower", key = Enum.KeyCode.E, color = Config.Colors.Blue },
	{ id = "night", label = "Black Hole Night", key = Enum.KeyCode.R, color = Color3.fromRGB(170, 110, 255) },
	{ id = "lights", label = "Change Lights", key = Enum.KeyCode.T, color = Color3.fromRGB(255, 220, 90) },
	{ id = "rain", label = "Rain Stardust", key = Enum.KeyCode.Y, color = Config.Colors.Orange },
	{ id = "launch", label = "Launch Rockets", key = Enum.KeyCode.U, color = Color3.fromRGB(255, 70, 70) },
	{ id = "lowgrav", label = "Low Gravity", key = Enum.KeyCode.H, color = Color3.fromRGB(140, 255, 170) },
}
local function press(player, id)
	if not isCaptain(player) then
		return
	end
	local t = os.clock()
	local cd = Config.CaptainCooldowns[id] or 5
	if (lastUse[id] or 0) + cd > t then
		tell(player, "Recharging: " .. math.ceil(lastUse[id] + cd - t) .. "s", "info")
		return
	end
	if id == "shower" then
		if showerOn then
			tell(player, "Stars are already falling!", "info")
			return
		end
		task.spawn(meteorShower)
	elseif id == "night" then
		if (workspace:GetAttribute("BlackHoleUntil") or 0) > now() then
			tell(player, "It's already Black Hole Night!", "info")
			return
		end
		task.spawn(blackHoleNight)
	elseif id == "lights" then
		if (workspace:GetAttribute("BlackHoleUntil") or 0) > now() then
			tell(player, "Wait for Black Hole Night to end first.", "info")
			return
		end
		themeIndex = themeIndex % #themes + 1
		local cc = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
		if cc then
			TweenService:Create(cc, TweenInfo.new(1.2), { TintColor = themes[themeIndex].tint }):Play()
		end
		tellAll("Captain's orders: " .. themes[themeIndex].name .. " lights!", "good")
	elseif id == "rain" then
		tellAll("The Captain made it rain Stardust! Grab them!", "cosmic")
		FX:FireAllClients("sfx", "shower")
		task.spawn(function()
			for _ = 1, 24 do
				meteorStar()
				task.wait(0.15)
			end
		end)
	elseif id == "lowgrav" then
		if not lowGravity() then
			tell(player, "Everyone is already floating!", "info")
			return
		end
	elseif id == "launch" then
		local any = false
		for _, m in ipairs(map.rockets or {}) do
			any = launchRocket(m) or any
		end
		if not any then
			tell(player, "The rockets are already flying!", "info")
			return
		end
		tellAll("Captain's orders: launch all rockets!", "cosmic")
	end
	lastUse[id] = t
end
for i, b in ipairs(buttons) do
	local x = (i - 3.5) * 2.3
	local btn = panelPart({ Name = "Button_" .. b.id, Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 2, 2), Color = b.color, Material = Enum.Material.Neon,
		CFrame = panelAt * CFrame.new(x, 3.6, -0.3) * CFrame.Angles(math.rad(-12), 0, 0) * CFrame.Angles(0, 0, math.rad(90)) })
	local light = Instance.new("PointLight")
	light.Color = b.color
	light.Range = 6
	light.Parent = btn
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = b.label
	prompt.ObjectText = "Captain's Controls"
	prompt.KeyboardKeyCode = b.key
	prompt.HoldDuration = 0.2
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow -- all five show at once (tap them on a tablet)
	prompt.UIOffset = Vector2.new(0, (i - 3.5) * -52)
	prompt:SetAttribute("CaptainOnly", true)
	prompt:SetAttribute("Reach", 9)
	prompt.Parent = btn
	prompt.Triggered:Connect(function(player)
		press(player, b.id)
	end)
end

-- ---------- quicker star pickups (2026-10-18, Matthew: "picking up the stars was delayed and laggy" in the Roblox app) ----------
-- Your own screen grabs a star the moment you touch it (FX.client.lua) and tells the server, which checks you were close
-- (with room for lag) and pays out. The four-times-a-second check above still catches anything this misses.
local GrabStar = remote("GrabStar")
GrabStar.OnServerEvent:Connect(function(player, s)
	if typeof(s) ~= "Instance" then
		return
	end
	local info = stars[s]
	local hrp = rootOf(player)
	if info and hrp and s.Parent and s:GetAttribute("Ready") and (s.Position - hrp.Position).Magnitude <= Config.Stars.pickupDistance + 8 then
		collect(player, s, info)
	end
end)

-- ---------- character upgrades at the Upgrade Lab (2026-10-18) ----------
local function applyUpgrades(player)
	local d = PlayerData.get(player)
	local ch = player.Character
	if not d then
		return
	end
	for _, u in ipairs(Config.Upgrades) do
		player:SetAttribute("Up_" .. u.id, d.upgrades[u.id] or 0) -- the Upgrade Lab prompts read these on your screen
	end
	for _, f in ipairs(Config.Furniture) do
		player:SetAttribute("OwnsF_" .. f.id, d.furniture[f.id] == true)
	end
	if ch then
		ch:SetAttribute("SpeedLevel", d.upgrades.speed or 0) -- Sprint.client.lua adds the speed
		ch:SetAttribute("DoubleJump", (d.upgrades.jump or 0) > 0) -- Gear.client.lua allows the extra jump
	end
end
local function hookUpgrades(player)
	player.CharacterAdded:Connect(function()
		task.spawn(function()
			local t0 = os.clock()
			while player.Parent and not PlayerData.get(player) and os.clock() - t0 < 10 do
				task.wait(0.25)
			end
			applyUpgrades(player)
		end)
	end)
	if player.Character then
		task.spawn(function()
			local t0 = os.clock()
			while player.Parent and not PlayerData.get(player) and os.clock() - t0 < 10 do
				task.wait(0.25)
			end
			applyUpgrades(player)
		end)
	end
end
Players.PlayerAdded:Connect(hookUpgrades)
for _, p in ipairs(Players:GetPlayers()) do
	hookUpgrades(p)
end

for id, pad in pairs(map.upgradePads or {}) do
	local u = Config.upgradeById(id)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Upgrade"
	prompt.ObjectText = u.name
	prompt.HoldDuration = 0.4
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("UpgradeId", id)
	prompt.Parent = pad
	prompt.Triggered:Connect(function(player)
		local d = PlayerData.get(player)
		if not d then
			return
		end
		local lv = d.upgrades[id] or 0
		if lv >= #u.prices then
			tell(player, u.name .. " is already maxed out!", "info")
			return
		end
		local price = u.prices[lv + 1]
		if d.stardust < price then
			tell(player, u.name .. (#u.prices > 1 and (" level " .. (lv + 1)) or "") .. " costs " .. addCommas(price) .. " Stardust. Keep collecting!", "bad")
			return
		end
		d.stardust -= price
		d.upgrades[id] = lv + 1
		refreshStats(player)
		applyUpgrades(player)
		sfx("upgrade", nil, player)
		FX:FireAllClients("confetti", pad.Position + Vector3.new(0, 5, 0))
		if id == "jump" then
			tell(player, "Double Jump! Press jump again in the air.", "good")
		else
			tell(player, u.name .. " level " .. (lv + 1) .. "!" .. (lv + 1 < #u.prices and "" or " That's the top level."), "good")
		end
	end)
end

-- ---------- furniture (2026-10-18): bought at Space Furniture, placed in your base wherever you get one ----------
local Furniture = require(script.Parent.Furniture)
local arcadeLast = {} -- [player] = os.clock() of their last prize

local function furnitureFolder(base)
	local f = base.root:FindFirstChild("Furniture")
	if not f then
		f = Instance.new("Folder")
		f.Name = "Furniture"
		f.Parent = base.root
	end
	return f
end

local function useFurniture(base, id, player, key)
	if id == "telescope" then
		FX:FireClient(player, "telescope")
	elseif id == "disco" then
		if player ~= base.owner then
			tell(player, "Only " .. base.owner.DisplayName .. " can start the party here!", "info")
			return
		end
		base.root:SetAttribute("Disco", not base.root:GetAttribute("Disco"))
		sfx("click", key.Position)
	elseif id == "arcade" then
		if player ~= base.owner then
			tell(player, "This is " .. base.owner.DisplayName .. "'s arcade. Get your own at Space Furniture!", "info")
			return
		end
		local t = os.clock()
		if (arcadeLast[player] or 0) + Config.ArcadeCooldown > t then
			tell(player, "The arcade is recharging: " .. math.ceil(arcadeLast[player] + Config.ArcadeCooldown - t) .. "s", "info")
			return
		end
		arcadeLast[player] = t
		local d = PlayerData.get(player)
		if not d then
			return
		end
		local jackpot = math.random() < 0.1
		local prize = math.max(15, math.floor(incomeOf(state[player]) * math.random(5, 20))) * (jackpot and 3 or 1)
		d.stardust += prize
		refreshStats(player)
		sfx("arcade", key.Position)
		FX:FireClient(player, "pop", key.Position + Vector3.new(0, 4, 0), (jackpot and "JACKPOT! +" or "+") .. addCommas(prize) .. " ★")
		if jackpot then
			FX:FireAllClients("confetti", key.Position + Vector3.new(0, 5, 0))
		end
	end
end

local PROMPTS = { arcade = "Play", telescope = "Look", disco = "Party lights" }
local function placeFurniture(base)
	local f = furnitureFolder(base)
	f:ClearAllChildren()
	base.root:SetAttribute("Disco", false)
	local d = base.owner and PlayerData.get(base.owner)
	if not d then
		return
	end
	for _, def in ipairs(Config.Furniture) do
		if d.furniture[def.id] and Furniture.SLOTS[def.id] then
			local _, key = Furniture.build(def.id, base.cf * Furniture.SLOTS[def.id], f, false)
			if key and PROMPTS[def.id] then
				local p = Instance.new("ProximityPrompt")
				p.ActionText = PROMPTS[def.id]
				p.ObjectText = def.name
				p.HoldDuration = 0
				p.MaxActivationDistance = def.id == "disco" and 14 or 9
				p.RequiresLineOfSight = false
				p.Parent = key
				p.Triggered:Connect(function(player)
					useFurniture(base, def.id, player, key)
				end)
			end
		end
	end
end

for _, base in ipairs(map.bases) do
	base.root:GetAttributeChangedSignal("OwnerUserId"):Connect(function()
		if base.owner then
			placeFurniture(base)
		else
			furnitureFolder(base):ClearAllChildren()
			base.root:SetAttribute("Disco", false)
		end
	end)
	if base.owner then
		placeFurniture(base)
	end
end

for id, stand in pairs(map.furnitureStands or {}) do
	local def = Config.furnitureById(id)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Buy (" .. addCommas(def.price) .. " ★)"
	prompt.ObjectText = def.name
	prompt.HoldDuration = 0.4
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("FurnitureId", id)
	prompt.Parent = stand
	prompt.Triggered:Connect(function(player)
		local d = PlayerData.get(player)
		local st = state[player]
		if not d then
			return
		end
		if d.furniture[id] then
			tell(player, "Your " .. def.name .. " is already in your base!", "info")
			return
		end
		if d.stardust < def.price then
			tell(player, "The " .. def.name .. " costs " .. addCommas(def.price) .. " Stardust. Keep collecting!", "bad")
			return
		end
		d.stardust -= def.price
		d.furniture[id] = true
		refreshStats(player)
		applyUpgrades(player)
		if st and st.base then
			placeFurniture(st.base)
		end
		sfx("gear", nil, player)
		FX:FireAllClients("confetti", stand.Position + Vector3.new(0, 5, 0))
		tell(player, "The " .. def.name .. " is in your base now! " .. def.blurb, "good")
	end)
end

-- ---------- every second: income; four times a second: home and catch checks ----------
task.spawn(function()
	while true do
		task.wait(1)
		for player, st in pairs(state) do
			local d = PlayerData.get(player)
			local income = incomeOf(st)
			if d and income > 0 then
				d.stardust += income
				refreshStats(player)
			end
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(0.25)
		for player, st in pairs(state) do
			local c = st.carrying
			local hrp = rootOf(player)
			if c and hrp and st.base then
				local p = st.base.cf:PointToObjectSpace(hrp.Position)
				if math.abs(p.X) < st.base.halfW and math.abs(p.Z) < st.base.halfD then
					bringHome(player)
				elseif c.from and c.from.owner and c.from.owner ~= player then
					local ohrp = rootOf(c.from.owner)
					if ohrp and (ohrp.Position - hrp.Position).Magnitude <= Config.CatchDistance then
						local owner = c.from.owner
						dropCarried(player, "caught")
						tell(owner, "You caught " .. player.DisplayName .. "!", "good")
					end
				end
			end
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(Config.AutosaveEvery)
		PlayerData.saveAll()
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[-- Builds the whole station from code when the server starts: deck, launch pad, six bases, the Commander statue, sky.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local Config = require(ReplicatedStorage.Shared.Config)
local CritterModels = require(ReplicatedStorage.Shared.CritterModels)

local C = Config.Colors
local MapBuilder = {}

local function part(parent, props)
	local p = Instance.new(props.ClassName or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		if k ~= "ClassName" then
			p[k] = v
		end
	end
	-- lag on the iPad (2026-10-25): glowing, see-through, small and paper-thin pieces cast no shadow. Nobody notices those shadows, but
	-- the tablet still draws every one. A piece can still ask for a shadow with CastShadow = true.
	if props.CastShadow == nil then
		local sz = props.Size
		if props.Material == Enum.Material.Neon or (props.Transparency or 0) > 0 or (sz and (math.max(sz.X, sz.Y, sz.Z) < 2 or math.min(sz.X, sz.Y, sz.Z) <= 0.3)) then
			p.CastShadow = false
		end
	end
	p.Parent = parent
	return p
end

local function surfaceText(target, face, text, color, size)
	local g = Instance.new("SurfaceGui")
	g.Face = face
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = size or 40
	g.LightInfluence = 0
	g.Parent = target
	local l = Instance.new("TextLabel")
	l.Name = "Label"
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = color
	l.Text = text
	l.Parent = g
	return l
end

-- a floating sign (2026-10-18, Matthew: "a better way to do the labels... more visual clarity"): a dark rounded panel with a
-- coloured outline, sized in studs so it shrinks with distance instead of crowding the screen. w and h are as before (pixels
-- at the old size); 24 of them make a stud.
local function billboard(parent, offset, text, color, w, h)
	local holder = part(parent, { Name = "BillboardHolder", Size = Vector3.new(1, 1, 1), Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false, CFrame = CFrame.new(offset) })
	local g = Instance.new("BillboardGui")
	g.Size = UDim2.fromScale((w or 600) / 24, (h or 120) / 24)
	g.LightInfluence = 0
	g.MaxDistance = 600
	g.Parent = holder
	local panel = Instance.new("Frame")
	panel.Size = UDim2.fromScale(1, 1)
	panel.BackgroundColor3 = C.Dark
	panel.BackgroundTransparency = 0.15
	panel.Parent = g
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.3, 0)
	corner.Parent = panel
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = 3
	stroke.Parent = panel
	local l = Instance.new("TextLabel")
	l.Name = "Label"
	l.AnchorPoint = Vector2.new(0.5, 0.5)
	l.Position = UDim2.fromScale(0.5, 0.5)
	l.Size = UDim2.fromScale(0.9, 0.78)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = color
	l.Text = text
	l.Parent = panel
	return l, holder
end

local function setupSky()
	Lighting.ClockTime = 0
	Lighting.Brightness = 1.6 -- brighter than the first build, toned back down the same day (Matthew: "everything comes off reflective")
	Lighting.Ambient = Color3.fromRGB(110, 118, 154)
	Lighting.OutdoorAmbient = Color3.fromRGB(126, 136, 174)
	Lighting.ExposureCompensation = 0
	Lighting.EnvironmentSpecularScale = 0.2 -- the glare: metal and plastic mirrored the sky and lights
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.GlobalShadows = true
	Lighting.FogEnd = 100000
	for _, c in ipairs(Lighting:GetChildren()) do
		if c:IsA("Sky") or c:IsA("Atmosphere") then
			c:Destroy()
		end
	end
	local sky = Instance.new("Sky")
	sky.StarCount = 5000
	sky.CelestialBodiesShown = false
	sky.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.35
	bloom.Size = 30
	bloom.Threshold = 1.7
	bloom.Parent = Lighting
end

local function planets(folder)
	part(folder, { Name = "OrangePlanet", Shape = Enum.PartType.Ball, Size = Vector3.new(160, 160, 160), Color = C.Orange, Material = Enum.Material.Neon, CFrame = CFrame.new(-420, 160, 380), CanCollide = false })
	local blue = part(folder, { Name = "BluePlanet", Shape = Enum.PartType.Ball, Size = Vector3.new(110, 110, 110), Color = C.Blue, Material = Enum.Material.Neon, CFrame = CFrame.new(460, 120, -360), CanCollide = false })
	part(folder, { Name = "Ring", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2, 220, 220), Color = C.Trim, Material = Enum.Material.Neon, Transparency = 0.4, CFrame = blue.CFrame * CFrame.Angles(0, 0, math.rad(80)) * CFrame.Angles(math.rad(15), 0, 0), CanCollide = false })
	part(folder, { Name = "Moon", Shape = Enum.PartType.Ball, Size = Vector3.new(50, 50, 50), Color = Color3.fromRGB(205, 205, 215), Material = Enum.Material.Slate, CFrame = CFrame.new(150, 140, 420), CanCollide = false })

	-- more space out the windows (2026-10-18, Matthew: "a little more space related things"): Earth, Mars, a striped giant
	local function blob(parent, center, radius, dir, size, color, material, transparency)
		local p = part(parent, { Name = "Patch", Size = size, Color = color, Material = material or Enum.Material.SmoothPlastic, Transparency = transparency or 0, CanCollide = false, CastShadow = false,
			CFrame = CFrame.lookAt(center, center + dir) * CFrame.new(0, 0, -(radius - size.Z * 0.3)) })
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
		return p
	end
	local rng = Random.new(2026)
	local earthAt, er = Vector3.new(-90, 75, -520), 70
	part(folder, { Name = "Earth", Shape = Enum.PartType.Ball, Size = Vector3.new(er * 2, er * 2, er * 2), Color = Color3.fromRGB(40, 110, 225), CFrame = CFrame.new(earthAt), CanCollide = false })
	for _ = 1, 9 do -- green and sandy continents, then white clouds, mostly on the side facing the station
		local dir = (Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.8, 0.8), rng:NextNumber(0.2, 1))).Unit
		blob(folder, earthAt, er, dir, Vector3.new(rng:NextNumber(28, 52), rng:NextNumber(20, 40), 10), rng:NextNumber() < 0.75 and Color3.fromRGB(70, 170, 80) or Color3.fromRGB(210, 190, 120))
	end
	for _ = 1, 8 do
		local dir = (Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-1, 1), rng:NextNumber(0, 1))).Unit
		blob(folder, earthAt, er + 2, dir, Vector3.new(rng:NextNumber(24, 44), rng:NextNumber(6, 12), 6), Color3.fromRGB(250, 252, 255), Enum.Material.SmoothPlastic, 0.15)
	end
	part(folder, { Name = "EarthGlow", Shape = Enum.PartType.Ball, Size = Vector3.new(er * 2 + 8, er * 2 + 8, er * 2 + 8), Color = Color3.fromRGB(150, 210, 255), Material = Enum.Material.Neon, Transparency = 0.88, CFrame = CFrame.new(earthAt), CanCollide = false })

	local marsAt, mr = Vector3.new(540, 50, 140), 34
	part(folder, { Name = "Mars", Shape = Enum.PartType.Ball, Size = Vector3.new(mr * 2, mr * 2, mr * 2), Color = Color3.fromRGB(205, 92, 58), Material = Enum.Material.Slate, CFrame = CFrame.new(marsAt), CanCollide = false })
	for _ = 1, 7 do
		local dir = (Vector3.new(rng:NextNumber(-1, 0), rng:NextNumber(-0.8, 0.8), rng:NextNumber(-1, 1))).Unit
		blob(folder, marsAt, mr, dir, Vector3.new(rng:NextNumber(6, 14), rng:NextNumber(6, 14), 3), Color3.fromRGB(150, 62, 40), Enum.Material.Slate)
	end
	blob(folder, marsAt, mr + 0.5, Vector3.new(0, 1, 0), Vector3.new(26, 26, 4), Color3.fromRGB(245, 245, 250)) -- the ice cap

	-- the striped giant: thin discs a touch wider than the planet at each height show as bands round it
	local gasAt, gr = Vector3.new(-560, 110, -120), 95
	part(folder, { Name = "GasGiant", Shape = Enum.PartType.Ball, Size = Vector3.new(gr * 2, gr * 2, gr * 2), Color = Color3.fromRGB(226, 196, 150), CFrame = CFrame.new(gasAt), CanCollide = false })
	local bands = { Color3.fromRGB(196, 140, 96), Color3.fromRGB(240, 222, 190), Color3.fromRGB(176, 120, 84), Color3.fromRGB(232, 206, 160) }
	for i, y in ipairs({ -60, -38, -16, 8, 30, 52, 70 }) do
		local r = math.sqrt(gr * gr - y * y) + 0.8
		part(folder, { Name = "Band", Shape = Enum.PartType.Cylinder, Size = Vector3.new(9, r * 2, r * 2), Color = bands[(i - 1) % #bands + 1], CanCollide = false, CastShadow = false,
			CFrame = CFrame.new(gasAt + Vector3.new(0, y, 0)) * CFrame.Angles(0, 0, math.rad(90)) })
	end
	blob(folder, gasAt, gr + 1.5, Vector3.new(1, -0.25, 0.35).Unit, Vector3.new(34, 18, 6), Color3.fromRGB(200, 90, 60)) -- the big red spot

	-- overhead, now the roof is open (2026-10-18): a ringed planet, a small purple one and a far blue one
	local satAt = CFrame.new(380, 230, 260)
	part(folder, { Name = "RingedPlanet", Shape = Enum.PartType.Ball, Size = Vector3.new(110, 110, 110), Color = Color3.fromRGB(236, 210, 150), CFrame = satAt, CanCollide = false })
	for i, r in ipairs({ 250, 215, 185 }) do
		part(folder, { Name = "PlanetRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, r, r), Color = (i == 2) and Color3.fromRGB(210, 180, 130) or Color3.fromRGB(245, 228, 190),
			Material = Enum.Material.Neon, Transparency = 0.45 + i * 0.1, CanCollide = false, CastShadow = false, CFrame = satAt * CFrame.Angles(0, 0, math.rad(90)) * CFrame.Angles(math.rad(22), 0, math.rad(12)) })
	end
	part(folder, { Name = "PurplePlanet", Shape = Enum.PartType.Ball, Size = Vector3.new(64, 64, 64), Color = Color3.fromRGB(170, 120, 230), CFrame = CFrame.new(-260, 280, -380), CanCollide = false })
	part(folder, { Name = "PurpleMoon", Shape = Enum.PartType.Ball, Size = Vector3.new(16, 16, 16), Color = Color3.fromRGB(220, 210, 240), Material = Enum.Material.Slate, CFrame = CFrame.new(-205, 300, -360), CanCollide = false })
	part(folder, { Name = "FarBluePlanet", Shape = Enum.PartType.Ball, Size = Vector3.new(50, 50, 50), Color = Color3.fromRGB(90, 160, 255), Material = Enum.Material.Neon, CFrame = CFrame.new(-60, 380, 420), CanCollide = false })
end

-- a base faces the launch pad: its front (local -Z) points at z = 0
local function buildBase(folder, index, position, facingRotation)
	local root = Instance.new("Model")
	root.Name = "Base" .. index
	root:SetAttribute("BaseIndex", index)
	root:SetAttribute("OwnerUserId", 0)
	root:SetAttribute("ShieldUntil", 0)
	root:SetAttribute("CooldownUntil", 0)
	root.Parent = folder
	local cf = CFrame.new(position) * CFrame.Angles(0, facingRotation, 0)
	local W, D = 56, 44
	local floor = part(root, { Name = "Floor", Size = Vector3.new(W, 1, D), Color = C.DeckLine, CFrame = cf * CFrame.new(0, 0.5, 0) })
	root.PrimaryPart = floor
	-- orange edge lights, with a gap at the entrance
	part(root, { Name = "EdgeBack", Size = Vector3.new(W, 0.3, 0.6), Color = C.Orange, Material = Enum.Material.Neon, CFrame = cf * CFrame.new(0, 1.1, D / 2) })
	for _, side in ipairs({ -1, 1 }) do
		part(root, { Name = "EdgeSide", Size = Vector3.new(0.6, 0.3, D), Color = C.Orange, Material = Enum.Material.Neon, CFrame = cf * CFrame.new(side * W / 2, 1.1, 0) })
		part(root, { Name = "EdgeFront", Size = Vector3.new((W - 18) / 2, 0.3, 0.6), Color = C.Orange, Material = Enum.Material.Neon, CFrame = cf * CFrame.new(side * (W / 4 + 4.5), 1.1, -D / 2) })
	end
	-- solid walls up to the roof (2026-10-18, Matthew: "the bases need some walls"): metal below, a window band above,
	-- and a front wall either side of an 18-stud doorway with big windows so friends can see your critters
	local WH, DOOR = 14, 18
	local metal, metalDark = Color3.fromRGB(128, 136, 156), Color3.fromRGB(72, 78, 98)
	local function wall(name, size, at, windowed)
		part(root, { Name = name, Size = Vector3.new(size.X, 6, size.Z), Color = metal, Material = Enum.Material.Metal, CFrame = at * CFrame.new(0, 3 + 1, 0) })
		part(root, { Name = name .. "Trim", Size = Vector3.new(size.X + 0.05, 0.5, size.Z + 0.1), Color = C.Orange, Material = Enum.Material.Neon, CFrame = at * CFrame.new(0, 7.2, 0) })
		if windowed then
			part(root, { Name = name .. "Window", Size = Vector3.new(size.X, WH - 8, size.Z * 0.5), Color = C.Blue, Material = Enum.Material.Glass, Transparency = 0.65, CastShadow = false, CFrame = at * CFrame.new(0, 7.5 + (WH - 8) / 2, 0) })
		else
			part(root, { Name = name .. "Upper", Size = Vector3.new(size.X, WH - 8, size.Z), Color = metalDark, Material = Enum.Material.Metal, CFrame = at * CFrame.new(0, 7.5 + (WH - 8) / 2, 0) })
		end
		part(root, { Name = name .. "Cap", Size = Vector3.new(size.X + 0.2, 0.8, size.Z + 0.3), Color = metalDark, Material = Enum.Material.Metal, CFrame = at * CFrame.new(0, WH + 1.4, 0) })
	end
	wall("WallBack", Vector3.new(W + 2, 0, 1.2), cf * CFrame.new(0, 0, D / 2 + 0.6), true)
	for _, side in ipairs({ -1, 1 }) do
		wall("WallSide", Vector3.new(1.2, 0, D + 2), cf * CFrame.new(side * (W / 2 + 0.6), 0, 0), side == 1)
		local segW = (W - DOOR) / 2 + 1
		wall("WallFront", Vector3.new(segW, 0, 1.2), cf * CFrame.new(side * (DOOR / 2 + segW / 2), 0, -D / 2 - 0.6), true)
	end
	-- light strips along the inside of the back wall
	part(root, { Name = "WallGlow", Size = Vector3.new(W - 4, 0.4, 0.3), Color = C.Blue, Material = Enum.Material.Neon, CFrame = cf * CFrame.new(0, 2.2, D / 2 - 0.1) })
	-- tiled floor with an orange border
	for tx = -2, 1 do
		for tz = -2, 1 do
			part(root, { Name = "FloorTile", Size = Vector3.new(W / 4 - 0.4, 0.1, D / 4 - 0.4), Color = ((tx + tz) % 2 == 0) and Color3.fromRGB(150, 158, 178) or Color3.fromRGB(138, 146, 166),
				Material = Enum.Material.Metal, CFrame = cf * CFrame.new((tx + 0.5) * W / 4, 1.05, (tz + 0.5) * D / 4) })
		end
	end
	-- the airlock shield fills the doorway: visible only while it is on
	-- the door (2026-10-18): an energy door, red and solid while locked, open (invisible, walk-through) while unlocked
	local shield = part(root, { Name = "Shield", Size = Vector3.new(DOOR, WH - 1, 1), Color = Color3.fromRGB(255, 70, 80), Material = Enum.Material.ForceField, Transparency = 1, CanCollide = false, CanQuery = false, CFrame = cf * CFrame.new(0, 1 + (WH - 1) / 2, -D / 2 - 0.6) })
	-- the metal gate (2026-10-18, Matthew: "a metal gate that drops down from the top when the door gets locked"): a rolling
	-- shutter stored in a housing over the doorway; every screen rolls it down or up when the base's ShieldUntil changes
	-- (Station.client.lua). The invisible Shield above is what actually blocks the way.
	local gateTop = WH - 0.4
	part(root, { Name = "GateHousing", Size = Vector3.new(DOOR + 1.6, 2.2, 2.4), Color = metalDark, Material = Enum.Material.Metal, CFrame = cf * CFrame.new(0, gateTop + 1.1, -D / 2 - 0.6) })
	local shutter = part(root, { Name = "Shutter", Size = Vector3.new(DOOR, 0.2, 0.35), Color = Color3.fromRGB(158, 164, 178), Material = Enum.Material.Metal, -- (was CorrugatedSteel, which Roblox does not have: it stopped the whole server)
		CanCollide = false, CanQuery = false, CFrame = cf * CFrame.new(0, gateTop - 0.1, -D / 2 - 0.6) })
	shutter:SetAttribute("Full", gateTop - 1)
	part(root, { Name = "ShutterBar", Size = Vector3.new(DOOR, 0.5, 0.55), Color = Color3.fromRGB(255, 196, 60), CanCollide = false, CanQuery = false,
		CFrame = cf * CFrame.new(0, gateTop - 0.45, -D / 2 - 0.6) })
	-- status lamps either side of the door: green = open, red = locked (Main.server.lua sets them)
	local lamps = {}
	for _, side in ipairs({ -1, 1 }) do
		table.insert(lamps, part(root, { Name = "DoorLamp", Shape = Enum.PartType.Ball, Size = Vector3.new(1.6, 1.6, 1.6), Color = Color3.fromRGB(80, 230, 120), Material = Enum.Material.Neon, CFrame = cf * CFrame.new(side * (DOOR / 2 + 2.2), 10, -D / 2 - 1.6) }))
	end
	-- the owner's name on the back wall and floating over the entrance
	local signPart = part(root, { Name = "Sign", Size = Vector3.new(30, 5, 0.6), Color = C.Dark, CFrame = cf * CFrame.new(0, 10.5, D / 2 + 0.5) })
	local signLabel = surfaceText(signPart, Enum.NormalId.Front, "Free base", C.Orange, 30)
	local nameLabel = billboard(root, (cf * CFrame.new(0, 19.5, -D / 2)).Position, "Free base", C.Blue, 420, 80) -- above the gate housing
	-- eight pedestals in two rows at the back half
	local pedestals = {}
	local i = 0
	for _, z in ipairs({ 6, 15, -4 }) do -- the third (front) row is the expansion: pedestals 9 to 12
		for _, x in ipairs({ -18, -6, 6, 18 }) do
			i += 1
			local base = cf * CFrame.new(x, 1, z)
			local ped = part(root, { Name = "Pedestal" .. i, Shape = Enum.PartType.Cylinder, Size = Vector3.new(2, 7, 7), Color = C.Trim, CFrame = base * CFrame.new(0, 1, 0) * CFrame.Angles(0, 0, math.rad(90)) })
			local ring = part(root, { Name = "PedestalRing" .. i, Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 7.4, 7.4), Color = C.Blue, Material = Enum.Material.Neon, CFrame = base * CFrame.new(0, 0.3, 0) * CFrame.Angles(0, 0, math.rad(90)) })
			pedestals[i] = { top = base * CFrame.new(0, 2, 0), part = ped, ring = ring }   -- critters face the entrance
		end
	end
	-- the airlock console just inside the entrance
	local console = part(root, { Name = "AirlockConsole", Size = Vector3.new(3, 4, 2), Color = C.Blue, Material = Enum.Material.SmoothPlastic, CFrame = cf * CFrame.new(-W / 2 + 4, 3, -D / 2 + 5) })
	part(root, { Name = "ConsoleScreen", Size = Vector3.new(2.6, 1.4, 0.2), Color = C.Orange, Material = Enum.Material.Neon, CFrame = console.CFrame * CFrame.new(0, 1.2, -1.05) })
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Lock / Unlock"
	prompt.ObjectText = "Base Door"
	prompt.HoldDuration = 0.2
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = console
	return {
		index = index, root = root, cf = cf, halfW = W / 2, halfD = D / 2,
		unlocked = Config.PedestalsPerBase, -- pedestals this base can use (more after Expand Base)
		shield = shield, doorLamps = lamps, signLabel = signLabel, nameLabel = nameLabel,
		pedestals = pedestals, consolePrompt = prompt, slots = {}, owner = nil,
		shieldUntil = 0, cooldownUntil = 0,
	}
end

local function commanderStatue(folder, at)
	local m = Instance.new("Model")
	m.Name = "CommanderStatue"
	m.Parent = folder
	local base = part(m, { Name = "Plinth", Size = Vector3.new(14, 4, 14), Color = C.Trim, CFrame = at * CFrame.new(0, 2, 0) })
	local plaque = part(m, { Name = "Plaque", Size = Vector3.new(12, 3, 0.4), Color = C.Dark, CFrame = at * CFrame.new(0, 2, -7.2) })
	surfaceText(plaque, Enum.NormalId.Front, Config.CommanderName .. "\nStation Commander", C.Orange, 50)
	local suit, glass = C.Orange, C.Blue
	for _, side in ipairs({ -1, 1 }) do
		part(m, { Name = "Leg", Size = Vector3.new(1.8, 5, 2), Color = Color3.fromRGB(235, 235, 240), CFrame = at * CFrame.new(side * 1.1, 6.5, 0) })
		part(m, { Name = "Arm", Size = Vector3.new(1.6, 4.6, 1.8), Color = suit, CFrame = at * CFrame.new(side * 3.2, 11, 0) * CFrame.Angles(0, 0, side * 0.12) })
	end
	part(m, { Name = "Torso", Size = Vector3.new(4.6, 5, 2.4), Color = suit, CFrame = at * CFrame.new(0, 11.5, 0) })
	part(m, { Name = "Badge", Shape = Enum.PartType.Ball, Size = Vector3.new(1, 1, 1), Color = glass, Material = Enum.Material.Neon, CFrame = at * CFrame.new(-1.2, 12.6, -1.25) })
	part(m, { Name = "Helmet", Shape = Enum.PartType.Ball, Size = Vector3.new(4.4, 4.4, 4.4), Color = Color3.fromRGB(240, 240, 245), CFrame = at * CFrame.new(0, 16, 0) })
	part(m, { Name = "Visor", Size = Vector3.new(3, 1.8, 0.6), Color = glass, Material = Enum.Material.Glass, Transparency = 0.2, CFrame = at * CFrame.new(0, 16.2, -1.9) })
	-- Nolan's friends gather round the Commander: Hammy and Zuzu on the plinth, Matt and Sunny Sprout on the deck in front
	for _, spot in ipairs({ { "hammy", CFrame.new(4.6, 0, -3), 200 }, { "zuzu", CFrame.new(-4.6, 0, -3), 160 }, { "matt", CFrame.new(5, -4, -10), 190 }, { "sunnysprout", CFrame.new(-5, -4, -10), 170 } }) do
		local def = Config.critterById(spot[1])
		if def then
			local r = 1.5 * CritterModels.scaleFor(def)
			local friend = CritterModels.build(def, at * spot[2] * CFrame.new(0, 4 + r, 0) * CFrame.Angles(0, math.rad(spot[3]), 0))
			friend.Name = def.name .. "Statue"
			local tag = friend.PrimaryPart:FindFirstChild("Tag")
			if tag then
				tag.MaxDistance = 40
				local info = tag:FindFirstChild("Info")
				if info then
					info.Text = "Nolan's friend"
				end
			end
			friend.Parent = m
		end
	end
	return m
end

-- returns everything the game logic needs to know about the map
function MapBuilder.build()
	setupSky()
	local station = Instance.new("Folder")
	station.Name = "Station"
	station.Parent = workspace
	part(station, { Name = "Deck", Size = Vector3.new(460, 2, 300), Color = C.Deck, Material = Enum.Material.Metal, CFrame = CFrame.new(0, -1, 0) }) -- tiles and walkways go on top (Decor.lua)

	-- the critter launch pad: a moving walkway down the middle
	local padStart, padEnd, padY = -64, 64, 1
	part(station, { Name = "LaunchPad", Size = Vector3.new(padEnd - padStart + 6, 1, 12), Color = C.Dark, CFrame = CFrame.new(0, 0.5, 0) })
	for _, z in ipairs({ -6.4, 6.4 }) do
		part(station, { Name = "PadLight", Size = Vector3.new(padEnd - padStart + 6, 0.4, 0.6), Color = C.Blue, Material = Enum.Material.Neon, CFrame = CFrame.new(0, 1.2, z) })
	end
	billboard(station, Vector3.new(0, 33, 0), "CRITTER LAUNCH TUNNEL", C.Blue, 520, 70) -- the tunnel itself is built in Decor.lua
	billboard(station, Vector3.new(0, 48, 0), Config.GameTitle, C.Orange, 900, 130)

	local bases = {}
	local i = 0
	for _, row in ipairs({ { z = 95, rot = 0 }, { z = -95, rot = math.pi } }) do
		for _, x in ipairs({ -171, -57, 57, 171 }) do -- 8 bases (2026-10-18: bigger map)
			i += 1
			bases[i] = buildBase(station, i, Vector3.new(x, 0, row.z), row.rot)
		end
	end

	commanderStatue(station, CFrame.new(118, 0, 0) * CFrame.Angles(0, math.rad(-90), 0))

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(-112, 0.5, 0) * CFrame.Angles(0, math.rad(-90), 0) -- you arrive facing the launch tunnel (2026-10-18)
	spawn.Color = C.Blue
	spawn.Material = Enum.Material.Neon
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Parent = station

	local deco = Instance.new("Folder")
	deco.Name = "Space"
	deco.Parent = station
	planets(deco)

	local critters = Instance.new("Folder")
	critters.Name = "Critters"
	critters.Parent = station

	local lockers, gearStands, rover, rockets, furnitureStands, upgradePads = require(script.Parent.Decor).build(station, bases)
	-- signs over the places to go (2026-10-18)
	billboard(station, Vector3.new(0, 21, -38), "GEAR BAY", C.Orange, 300, 64)
	billboard(station, Vector3.new(0, 21, 38), "SPACE FURNITURE", Color3.fromRGB(255, 150, 210), 380, 64)
	billboard(station, Vector3.new(-104, 17, 40), "UPGRADE LAB", Color3.fromRGB(140, 255, 170), 320, 64)
	billboard(station, Vector3.new(-104, 12, -46), "MOON ROVER", C.Blue, 300, 60) -- the hangar shell, tunnel, props, asteroids and the hiding lockers (2026-10-18)

	return { bases = bases, padStart = padStart, padEnd = padEnd, padY = padY, critterFolder = critters, lockers = lockers, gearStands = gearStands, rover = rover, rockets = rockets, furnitureStands = furnitureStands, upgradePads = upgradePads }
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">PlayerData</string>
          <string name="Source"><![CDATA[-- Saves each player's Stardust and critters between visits (Roblox DataStores).
-- In Studio, saving needs: Game Settings > Security > "Enable Studio Access to API Services". Without it the game still runs; it just doesn't save.
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local PlayerData = {}
local cache = {}
local store = nil
pcall(function()
	store = DataStoreService:GetDataStore("StarStation_v1")
end)

local function default()
	return { stardust = Config.StartStardust, slots = {}, caught = 0, found = {}, pet = nil, pedestals = Config.PedestalsPerBase, gear = {}, furniture = {}, upgrades = {} } -- found: the Collection Book; pet: the critter that follows you; gear: what you bought in the Gear Bay
end

-- keep only what the game understands, so a bad save can't break anything
local function clean(d)
	if typeof(d) ~= "table" then
		return default()
	end
	local out = default()
	if typeof(d.stardust) == "number" and d.stardust >= 0 then
		out.stardust = math.floor(d.stardust)
	end
	if typeof(d.caught) == "number" then
		out.caught = math.floor(d.caught)
	end
	if typeof(d.found) == "table" then
		for key, v in pairs(d.found) do
			if v == true and Config.fromKey(key) then
				out.found[key] = true
			end
		end
	end
	if typeof(d.pedestals) == "number" then
		out.pedestals = math.clamp(math.floor(d.pedestals), Config.PedestalsPerBase, Config.MaxPedestals)
	end
	if typeof(d.gear) == "table" then
		for id, v in pairs(d.gear) do
			if v == true and Config.gearById(id) then
				out.gear[id] = true
			end
		end
	end
	if typeof(d.furniture) == "table" then
		for id, v in pairs(d.furniture) do
			if v == true and Config.furnitureById(id) then
				out.furniture[id] = true
			end
		end
	end
	if typeof(d.upgrades) == "table" then -- levels, capped at what each upgrade has
		for id, lv in pairs(d.upgrades) do
			local u = Config.upgradeById(id)
			if u and typeof(lv) == "number" then
				out.upgrades[id] = math.clamp(math.floor(lv), 0, #u.prices)
			end
		end
	end
	if typeof(d.pet) == "string" and Config.fromKey(d.pet) then
		out.pet = d.pet
	end
	if typeof(d.slots) == "table" then
		for k, id in pairs(d.slots) do
			local n = tonumber(k)
			if n and n >= 1 and n <= Config.MaxPedestals and Config.fromKey(id) then   -- "cometcat" or "cometcat:golden"
				out.slots[tostring(n)] = id
			end
		end
	end
	return out
end

local function key(player)
	return "p_" .. player.UserId
end

function PlayerData.load(player)
	local raw = nil
	if store then
		for _ = 1, 3 do
			local ok, res = pcall(function()
				return store:GetAsync(key(player))
			end)
			if ok then
				raw = res
				break
			end
			task.wait(1)
		end
	end
	local d = clean(raw)
	cache[player] = d
	return d
end

function PlayerData.get(player)
	return cache[player]
end

function PlayerData.save(player)
	local d = cache[player]
	if not (store and d) then
		return false
	end
	local ok = pcall(function()
		store:SetAsync(key(player), d)
	end)
	return ok
end

function PlayerData.release(player)
	PlayerData.save(player)
	cache[player] = nil
end

function PlayerData.saveAll()
	for player in pairs(cache) do
		PlayerData.save(player)
	end
end

return PlayerData
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="12">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="13">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="14">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="15">
          <Properties>
            <string name="Name">Audio</string>
            <string name="Source"><![CDATA[-- Music (2026-10-18, Matthew: "is there any sound involved in this?"): a looping space track, a spooky drone instead
-- during Black Hole Night, and a music button (top right) to turn the music off and on. Sound effects are in FX.client.lua.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local FX = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("FX")
local player = Players.LocalPlayer
local C = Config.Colors

local function track(def, looped)
	local s = Instance.new("Sound")
	s.SoundId = "rbxassetid://" .. def.id
	s.Volume = def.volume or 0.3
	s.Looped = looped
	s.Parent = SoundService
	return s
end
local music = track(Config.Sounds.music, true)
local night = track(Config.Sounds.night, true)
local musicOn = true
local isNight = false

local function fade(s, to, secs)
	TweenService:Create(s, TweenInfo.new(secs or 1.5), { Volume = to }):Play()
end

local function refresh()
	if musicOn and not isNight then
		if not music.IsPlaying then
			music.Volume = 0
			music:Play()
		end
		fade(music, Config.Sounds.music.volume)
	else
		fade(music, 0, 0.8)
	end
	if isNight and musicOn then
		if not night.IsPlaying then
			night.Volume = 0
			night:Play()
		end
		fade(night, Config.Sounds.night.volume)
	else
		fade(night, 0, 1.5)
	end
end

FX.OnClientEvent:Connect(function(kind, a)
	if kind == "night" then
		isNight = true
		refresh()
		task.delay(a or Config.NightSeconds, function()
			isNight = false
			refresh()
		end)
	end
end)

-- the music button
local gui = Instance.new("ScreenGui")
gui.Name = "MusicButton"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")
local btn = Instance.new("TextButton")
btn.AnchorPoint = Vector2.new(1, 0)
btn.Position = UDim2.new(1, -16, 0, 60)
btn.Size = UDim2.fromOffset(150, 46)
btn.BackgroundColor3 = C.Dark
btn.BackgroundTransparency = 0.2
btn.Font = Enum.Font.FredokaOne
btn.TextScaled = true
btn.TextColor3 = C.Blue
btn.Text = "♪ Music: On"
btn.Parent = gui
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = btn
local pad = Instance.new("UIPadding")
pad.PaddingLeft, pad.PaddingRight, pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 10), UDim.new(0, 10), UDim.new(0, 6), UDim.new(0, 6)
pad.Parent = btn
btn.Activated:Connect(function()
	musicOn = not musicOn
	btn.Text = musicOn and "♪ Music: On" or "♪ Music: Off"
	btn.TextColor3 = musicOn and C.Blue or Color3.fromRGB(150, 150, 165)
	refresh()
end)

refresh()
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="16">
          <Properties>
            <string name="Name">Book</string>
            <string name="Source"><![CDATA[-- The Critter Collection Book: every critter in the game, the ones you've found in colour and the rest as "???",
-- which Golden and Rainbow versions you've had, and a button to make one of your critters your pet.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local CritterModels = require(ReplicatedStorage.Shared.CritterModels)
local SetPet = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("SetPet")

local player = Players.LocalPlayer
local C = Config.Colors

local gui = Instance.new("ScreenGui")
gui.Name = "CollectionBook"
gui.ResetOnSpawn = false
gui.DisplayOrder = 3
gui.Parent = player:WaitForChild("PlayerGui")

local function corner(o, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 12)
	c.Parent = o
end

local function text(parent, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = Color3.new(1, 1, 1)
	for k, v in pairs(props) do
		l[k] = v
	end
	l.Parent = parent
	return l
end

-- the button that opens it (bottom left)
local open = Instance.new("TextButton")
open.Name = "BookButton"
open.AnchorPoint = Vector2.new(0, 1)
local UIS = game:GetService("UserInputService")
if UIS.TouchEnabled and not UIS.KeyboardEnabled then -- clear of the joystick on a tablet (2026-10-18)
	open.AnchorPoint = Vector2.new(0, 0)
	open.Position = UDim2.new(0, 16, 0, 156)
else
	open.Position = UDim2.new(0, 16, 1, -24)
end
open.Size = UDim2.fromOffset(190, 70)
open.BackgroundColor3 = C.Orange
open.Font = Enum.Font.FredokaOne
open.TextScaled = true
open.TextColor3 = C.Dark
open.Text = "Collection Book"
open.Parent = gui
corner(open, 16)
local op = Instance.new("UIPadding")
op.PaddingLeft, op.PaddingRight, op.PaddingTop, op.PaddingBottom = UDim.new(0, 12), UDim.new(0, 12), UDim.new(0, 10), UDim.new(0, 10)
op.Parent = open

local panel = Instance.new("Frame")
panel.Name = "Book"
panel.AnchorPoint = Vector2.new(0.5, 0.5)
panel.Position = UDim2.fromScale(0.5, 0.5)
panel.Size = UDim2.fromScale(0.86, 0.82)
panel.BackgroundColor3 = C.Dark
panel.Visible = false
panel.Parent = gui
corner(panel, 18)
local limit = Instance.new("UISizeConstraint")
limit.MaxSize = Vector2.new(1000, 680)
limit.Parent = panel
local stroke = Instance.new("UIStroke")
stroke.Color = C.Blue
stroke.Thickness = 3
stroke.Parent = panel

text(panel, { Position = UDim2.new(0, 20, 0, 12), Size = UDim2.new(0.6, 0, 0, 44), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Orange, Text = "Critter Collection" })
local counter = text(panel, { Position = UDim2.new(0, 20, 0, 56), Size = UDim2.new(0.6, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Blue, Font = Enum.Font.GothamBold, Text = "" })
local close = Instance.new("TextButton")
close.AnchorPoint = Vector2.new(1, 0)
close.Position = UDim2.new(1, -16, 0, 16)
close.Size = UDim2.fromOffset(110, 46)
close.BackgroundColor3 = C.Blue
close.Font = Enum.Font.FredokaOne
close.TextScaled = true
close.TextColor3 = C.Dark
close.Text = "Close"
close.Parent = panel
corner(close, 12)

local scroll = Instance.new("ScrollingFrame")
scroll.Position = UDim2.new(0, 16, 0, 96)
scroll.Size = UDim2.new(1, -32, 1, -112)
scroll.BackgroundTransparency = 1
scroll.BorderSizePixel = 0
scroll.ScrollBarThickness = 8
scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
scroll.CanvasSize = UDim2.new()
scroll.Parent = panel
local grid = Instance.new("UIGridLayout")
grid.CellSize = UDim2.fromOffset(170, 236)
grid.CellPadding = UDim2.fromOffset(12, 12)
grid.SortOrder = Enum.SortOrder.LayoutOrder
grid.Parent = scroll

local function setOf(attr)
	local s = {}
	for key in string.gmatch(player:GetAttribute(attr) or "", "[^,]+") do
		s[key] = true
	end
	return s
end

local function viewport(parent, def, mut, silhouette)
	local vp = Instance.new("ViewportFrame")
	vp.Size = UDim2.new(1, -12, 0, 118)
	vp.Position = UDim2.new(0, 6, 0, 6)
	vp.BackgroundColor3 = Color3.fromRGB(28, 34, 56)
	vp.Ambient = Color3.fromRGB(190, 195, 215)
	vp.LightColor = Color3.fromRGB(255, 245, 230)
	vp.LightDirection = Vector3.new(-1, -1, 1)
	vp.Parent = parent
	corner(vp, 10)
	local s = CritterModels.scaleFor(def)
	local m = CritterModels.build(def, CFrame.Angles(0, math.rad(25), 0), mut)
	local tag = m.PrimaryPart:FindFirstChild("Tag")
	if tag then
		tag:Destroy()
	end
	if silhouette then
		for _, p in ipairs(m:GetDescendants()) do
			if p:IsA("BasePart") then
				p.Color = Color3.fromRGB(14, 16, 26)
				p.Material = Enum.Material.SmoothPlastic
			elseif p:IsA("Light") or p:IsA("ParticleEmitter") then
				p:Destroy()
			end
		end
	end
	m.Parent = vp
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	cam.CFrame = CFrame.lookAt(Vector3.new(0, 1.6 * s, -9 * s), Vector3.new(0, 0.5 * s, 0))
	cam.Parent = vp
	vp.CurrentCamera = cam
end

local function species()
	local list = {}
	for _, def in ipairs(Config.Critters) do
		if def.enabled ~= false then
			table.insert(list, def)
		end
	end
	table.sort(list, function(a, b)
		local ra, rb = Config.Rarities[a.rarity].order, Config.Rarities[b.rarity].order
		if ra ~= rb then
			return ra < rb
		end
		return a.price < b.price
	end)
	return list
end

local function refresh()
	for _, ch in ipairs(scroll:GetChildren()) do
		if ch:IsA("Frame") then
			ch:Destroy()
		end
	end
	local found, owned = setOf("Found"), setOf("Owned")
	local pet = player:GetAttribute("Pet")
	local list = species()
	local nFound = 0
	for i, def in ipairs(list) do
		local has = found[def.id] or found[def.id .. ":golden"] or found[def.id .. ":rainbow"]
		if has then
			nFound += 1
		end
		local rarity = Config.Rarities[def.rarity]
		local card = Instance.new("Frame")
		card.LayoutOrder = i
		card.BackgroundColor3 = Color3.fromRGB(36, 42, 66)
		card.Parent = scroll
		corner(card, 12)
		local cs = Instance.new("UIStroke")
		cs.Color = has and rarity.color or Color3.fromRGB(70, 76, 96)
		cs.Thickness = 2
		cs.Parent = card
		-- show the best version they've had: Rainbow, then Golden, then plain
		local showMut = found[def.id .. ":rainbow"] and Config.mutationById("rainbow") or (found[def.id .. ":golden"] and Config.mutationById("golden") or nil)
		viewport(card, def, showMut, not has)
		text(card, { Position = UDim2.new(0, 6, 0, 128), Size = UDim2.new(1, -12, 0, 24), Text = has and def.name or "???" })
		text(card, { Position = UDim2.new(0, 6, 0, 152), Size = UDim2.new(1, -12, 0, 18), Font = Enum.Font.GothamBold, TextColor3 = rarity.color, Text = def.rarity .. (has and ("  ·  +" .. def.income .. "/s") or "") })
		-- which special versions they've had
		for j, mid in ipairs({ "golden", "rainbow" }) do
			local got = found[def.id .. ":" .. mid]
			local chip = text(card, { Position = UDim2.new((j - 1) * 0.5, 6, 0, 174), Size = UDim2.new(0.5, -9, 0, 20), Font = Enum.Font.GothamBold,
				TextColor3 = got and C.Dark or Color3.fromRGB(110, 116, 136), BackgroundTransparency = 0,
				BackgroundColor3 = got and (mid == "golden" and Color3.fromRGB(255, 205, 70) or Color3.fromRGB(200, 150, 255)) or Color3.fromRGB(46, 52, 76),
				Text = mid == "golden" and "Golden" or "Rainbow" })
			corner(chip, 8)
		end
		-- make it your pet, if one is in your base right now
		local ownKey = owned[def.id .. ":rainbow"] and (def.id .. ":rainbow") or (owned[def.id .. ":golden"] and (def.id .. ":golden") or (owned[def.id] and def.id or nil))
		if ownKey then
			local isPet = pet and Config.fromKey(pet) == def
			local b = Instance.new("TextButton")
			b.Position = UDim2.new(0, 6, 0, 200)
			b.Size = UDim2.new(1, -12, 0, 28)
			b.BackgroundColor3 = isPet and C.Orange or C.Blue
			b.Font = Enum.Font.FredokaOne
			b.TextScaled = true
			b.TextColor3 = C.Dark
			b.Text = isPet and "Following you (tap to stop)" or "Make my pet"
			b.Parent = card
			corner(b, 8)
			b.Activated:Connect(function()
				SetPet:FireServer(isPet and "" or ownKey)
			end)
		end
	end
	counter.Text = "Found " .. nFound .. " of " .. #list .. " critters"
end

open.Activated:Connect(function()
	panel.Visible = not panel.Visible
	if panel.Visible then
		refresh()
	end
end)
close.Activated:Connect(function()
	panel.Visible = false
end)
for _, attr in ipairs({ "Found", "Owned", "Pet" }) do
	player:GetAttributeChangedSignal(attr):Connect(function()
		if panel.Visible then
			refresh()
		end
	end)
end
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="17">
          <Properties>
            <string name="Name">FX</string>
            <string name="Source"><![CDATA[-- The "juice", drawn on this player's screen only: sounds, punch and weapon animations, sparkles and confetti, pop-up numbers, the steal alarm, a guide beam
-- home while carrying, "+income" over your base, bobbing critters, spinning stars, and rainbow critters cycling colour.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage.Shared.Config)
local FX = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("FX")
local player = Players.LocalPlayer
local C = Config.Colors

local station = workspace:WaitForChild("Station", 30)
if not station then
	return
end
local critters = station:WaitForChild("Critters", 30)
local starsFolder = station:WaitForChild("Stars", 30)

local fxFolder = Instance.new("Folder")
fxFolder.Name = "LocalFX"
fxFolder.Parent = workspace

local function anchorAt(pos)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(1, 1, 1)
	p.CFrame = CFrame.new(pos)
	p.Parent = fxFolder
	return p
end

local function burst(pos, color, count, colors)
	local p = anchorAt(pos)
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Color = colors or ColorSequence.new(color or C.Orange)
	e.LightEmission = 1
	e.Size = NumberSequence.new(0.6, 0)
	e.Lifetime = NumberRange.new(0.5, 1)
	e.Speed = NumberRange.new(8, 16)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Rate = 0
	e.Parent = p
	e:Emit(count or 30)
	Debris:AddItem(p, 2)
end

local function pop(pos, text, color)
	local p = anchorAt(pos)
	local g = Instance.new("BillboardGui")
	g.Size = UDim2.fromOffset(160, 50)
	g.AlwaysOnTop = true
	g.LightInfluence = 0
	g.Parent = p
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = color or C.Orange
	l.TextStrokeTransparency = 0.2
	l.Text = text
	l.Parent = g
	TweenService:Create(p, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = CFrame.new(pos + Vector3.new(0, 6, 0)) }):Play()
	TweenService:Create(l, TweenInfo.new(1.1), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(p, 1.2)
end

-- ---------- screen overlays: the steal alarm and the meteor shower ----------
local gui = Instance.new("ScreenGui")
gui.Name = "FXOverlay"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 5
gui.Parent = player:WaitForChild("PlayerGui")
local flash = Instance.new("Frame")
flash.Size = UDim2.fromScale(1, 1)
flash.BackgroundColor3 = Color3.fromRGB(255, 40, 60)
flash.BackgroundTransparency = 1
flash.BorderSizePixel = 0
flash.Parent = gui
local big = Instance.new("TextLabel")
big.AnchorPoint = Vector2.new(0.5, 0.5)
big.Position = UDim2.fromScale(0.5, 0.3)
big.Size = UDim2.fromScale(0.6, 0.12)
big.BackgroundTransparency = 1
big.Font = Enum.Font.FredokaOne
big.TextScaled = true
big.TextColor3 = Color3.new(1, 1, 1)
big.TextStrokeTransparency = 0
big.TextTransparency = 1
big.TextStrokeTransparency = 1
big.Parent = gui

local function shout(text, color, seconds)
	big.Text = text
	big.TextColor3 = color
	big.TextTransparency = 0
	big.TextStrokeTransparency = 0
	task.delay(seconds or 2, function()
		TweenService:Create(big, TweenInfo.new(0.5), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	end)
end

local function alarm(baseIndex)
	shout("THIEF!", Color3.fromRGB(255, 90, 100), 2.5)
	for i = 1, 4 do
		task.delay((i - 1) * 0.5, function()
			flash.BackgroundTransparency = 0.6
			TweenService:Create(flash, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
		end)
	end
	for _, m in ipairs(station:GetChildren()) do
		if m:IsA("Model") and m:GetAttribute("BaseIndex") == baseIndex then
			local shield = m:FindFirstChild("Shield")
			if shield then
				local red = shield:Clone()
				red.Name = "AlarmGlow"
				red.Color = Color3.fromRGB(255, 50, 70)
				red.Material = Enum.Material.Neon
				red.Transparency = 0.6
				red.Parent = fxFolder
				TweenService:Create(red, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 4, true), { Transparency = 1 }):Play()
				Debris:AddItem(red, 4.5)
			end
		end
	end
end

-- ---------- sounds (2026-10-18): ids and volumes live in Config.Sounds ----------
local SoundService = game:GetService("SoundService")
local function sfx(name, pos)
	local def = Config.Sounds[name]
	if not def then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = "rbxassetid://" .. def.id
	s.Volume = def.volume or 0.5
	s.PlaybackSpeed = def.pitch or 1
	local holder = s
	if pos then -- in the world: louder close by
		local p = anchorAt(pos)
		s.RollOffMinDistance = 14
		s.RollOffMaxDistance = 160
		s.Parent = p
		holder = p
	else
		s.Parent = SoundService
	end
	s:Play()
	if def.stopAfter then
		task.delay(def.stopAfter, function()
			if s.Parent then
				s:Stop()
			end
		end)
	end
	Debris:AddItem(holder, math.max(def.stopAfter or 0, 8))
end

-- ---------- arm animations (2026-10-18, Matthew: "a punching animation", "animations to the weapons") ----------
-- Punch and glove swings are Roblox animations played by the puncher's own screen (HUD.client.lua); this joint code is
-- kept for the blaster's small recoil.
local restC0 = {} -- [joint] = its resting frame
local armTweens = {} -- [joint] = which swing owns it right now
-- Finds a body joint and the property that bends it. Older avatars join parts with a Motor6D (bend its C0); newer ones
-- (Roblox's avatar joint upgrade, 2026-10-18 fix: the arm didn't move) use an AnimationConstraint, which bends by
-- turning the attachment it hangs from on the body.
local function joint(char, name, r6Name, bodyPart)
	local m
	for _, d in ipairs(char:GetDescendants()) do
		if (d.Name == name or d.Name == r6Name) and (d:IsA("Motor6D") or d:IsA("AnimationConstraint")) then
			m = d
			break
		end
	end
	if not m then
		return nil
	end
	local r15 = m.Name == name
	if m:IsA("Motor6D") then
		return m, "C0", r15
	end
	-- turn the attachment on the body side (UpperTorso for the shoulder); if that one is Attachment1, turn it the other way
	local a0, a1 = m.Attachment0, m.Attachment1
	if a1 and a1.Parent and a1.Parent.Name == bodyPart then
		return a1, "CFrame", r15, true
	end
	if a0 then
		return a0, "CFrame", r15, false
	end
	return nil
end

local warned = false
-- steps: a list of { angle forward (radians), twist of the body, seconds }; ends back at rest
local function animate(char, steps)
	local shoulder, prop, r15, flipS = joint(char, "RightShoulder", "Right Shoulder", "UpperTorso")
	if not shoulder then
		if not warned then
			warned = true
			local seen = {}
			for _, d in ipairs(char:GetDescendants()) do
				if d:IsA("JointInstance") or d:IsA("Constraint") then
					table.insert(seen, d.Name .. " (" .. d.ClassName .. ")")
				end
			end
			warn("[Star Station] no shoulder joint found for the punch animation. Joints: " .. table.concat(seen, ", "))
		end
		return
	end
	local waist, wprop, flipW = nil, nil, false
	if r15 then
		waist, wprop, _, flipW = joint(char, "Waist", "", "LowerTorso")
	end
	local function turn(rot, flip)
		return flip and rot:Inverse() or rot
	end
	restC0[shoulder] = restC0[shoulder] or shoulder[prop]
	if waist then
		restC0[waist] = restC0[waist] or waist[wprop]
	end
	local token = {}
	armTweens[shoulder] = token
	local function go(obj, p, goal, secs)
		TweenService:Create(obj, TweenInfo.new(secs, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { [p] = goal }):Play()
	end
	task.spawn(function()
		for _, st in ipairs(steps) do
			if armTweens[shoulder] ~= token or not shoulder.Parent then
				return
			end
			local angle, twist, secs = st[1], st[2], st[3]
			go(shoulder, prop, restC0[shoulder] * turn(r15 and CFrame.Angles(angle, 0, 0) or CFrame.Angles(0, 0, angle), flipS), secs)
			if waist then
				go(waist, wprop, restC0[waist] * turn(CFrame.Angles(0, twist, 0), flipW), secs)
			end
			task.wait(secs)
		end
		if armTweens[shoulder] == token and shoulder.Parent then
			go(shoulder, prop, restC0[shoulder], 0.25)
			if waist then
				go(waist, wprop, restC0[waist], 0.25)
			end
		end
	end)
end

local function heldTool(char, id)
	local t = char and char:FindFirstChildOfClass("Tool")
	return t and t:GetAttribute("GearId") == id and t or nil
end

-- the glove shoots out on its spring and snaps back
local function springGlove(tool)
	local handle = tool:FindFirstChild("Handle")
	local gj = handle and handle:FindFirstChild("GloveJoint")
	local sj = handle and handle:FindFirstChild("SpringJoint")
	local rod = sj and sj.Part1
	if not (gj and sj and rod) then
		return
	end
	restC0[gj] = restC0[gj] or gj.C0
	restC0[sj] = restC0[sj] or sj.C0
	restC0[rod] = restC0[rod] or rod.Size
	local reach = 4.2
	local out = TweenInfo.new(0.09, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	local back = TweenInfo.new(0.28, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
	task.delay(0.1, function()
		TweenService:Create(gj, out, { C0 = CFrame.new(0, 0, -reach) * restC0[gj] }):Play()
		TweenService:Create(sj, out, { C0 = CFrame.new(0, 0, -reach / 2) * restC0[sj] }):Play()
		TweenService:Create(rod, out, { Size = restC0[rod] + Vector3.new(reach, 0, 0) }):Play()
		task.wait(0.16)
		TweenService:Create(gj, back, { C0 = restC0[gj] }):Play()
		TweenService:Create(sj, back, { C0 = restC0[sj] }):Play()
		TweenService:Create(rod, back, { Size = restC0[rod] }):Play()
	end)
end

local function swing(pos, who, style)
	local char = who and who.Character
	if style == "glove" then
		sfx("glove", pos)
		if char then
			local tool = heldTool(char, "glove")
			if tool then
				springGlove(tool)
			end
		end
		burst(pos + (char and char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart.CFrame.LookVector * 4 or Vector3.zero), Color3.fromRGB(255, 255, 255), 12)
	else
		sfx("swing", pos)
		burst(pos, Color3.fromRGB(255, 255, 255), 8)
	end
end

-- the Star Blaster: kick, a flash at the muzzle, a glowing bolt flying to where it lands
local function blast(who, from, to, landed)
	local char = who and who.Character
	sfx("blaster", from)
	if char then
		animate(char, { { 0.4, 0, 0.05 }, { 0.4, 0, 0.08 } }) -- recoil
		local tool = heldTool(char, "blaster")
		local crystal = tool and tool:FindFirstChild("Crystal")
		local flashLight = crystal and crystal:FindFirstChild("Flash")
		if flashLight then
			flashLight.Brightness = 6
			TweenService:Create(flashLight, TweenInfo.new(0.25), { Brightness = 0 }):Play()
		end
	end
	burst(from, C.Orange, 10)
	local dist = (to - from).Magnitude
	local bolt = Instance.new("Part")
	bolt.Name = "StarBolt"
	bolt.Shape = Enum.PartType.Ball
	bolt.Size = Vector3.new(1.1, 1.1, 1.1)
	bolt.Color = C.Orange
	bolt.Material = Enum.Material.Neon
	bolt.Anchored = true
	bolt.CanCollide = false
	bolt.CanQuery = false
	bolt.CanTouch = false
	bolt.CFrame = CFrame.new(from)
	bolt.Parent = fxFolder
	local glowLight = Instance.new("PointLight")
	glowLight.Color = C.Orange
	glowLight.Range = 10
	glowLight.Brightness = 3
	glowLight.Parent = bolt
	local trail = Instance.new("Part") -- a streak behind it that stretches as it flies
	trail.Anchored = true
	trail.CanCollide = false
	trail.CanQuery = false
	trail.CanTouch = false
	trail.Material = Enum.Material.Neon
	trail.Color = C.Blue
	trail.Transparency = 0.3
	trail.Size = Vector3.new(0.35, 0.35, 0.1)
	trail.Parent = fxFolder
	local secs = math.max(0.08, dist / 220)
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local a = math.clamp((os.clock() - t0) / secs, 0, 1)
		local at = from:Lerp(to, a)
		bolt.CFrame = CFrame.new(at)
		local tail = from:Lerp(to, math.max(0, a - 0.35))
		local len = (at - tail).Magnitude
		if len > 0.05 then
			trail.Size = Vector3.new(0.35, 0.35, len)
			trail.CFrame = CFrame.lookAt((at + tail) / 2, at)
		end
		if a >= 1 then
			conn:Disconnect()
			bolt:Destroy()
			trail:Destroy()
			burst(to, landed and C.Orange or C.Blue, landed and 30 or 14)
			sfx("bolt", to)
		end
	end)
end

-- ---------- rocket launches (2026-10-18): countdown, liftoff with fire and smoke, up through the roof and away ----------
-- Only this screen moves the parts, so it's smooth for everyone; the server says when to launch and when it's back.
local rocketHome = {} -- [part] = { cframe, transparency }
local rocketFlights = {} -- [model] = true while flying
local function flyingParts(m)
	local list = {}
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") and not p:GetAttribute("Stays") then
			rocketHome[p] = rocketHome[p] or { p.CFrame, p.Transparency }
			table.insert(list, p)
		end
	end
	return list
end

local function launch(m, countdown)
	if not (m and m.Parent) or rocketFlights[m] then
		return
	end
	rocketFlights[m] = true
	local parts = flyingParts(m)
	local pad = m:FindFirstChild("LaunchPadBase")
	local padPos = pad and pad.Position or m:GetPivot().Position
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local near = hrp and (hrp.Position - padPos).Magnitude < 260
	task.spawn(function()
		for i = countdown, 1, -1 do
			if near then
				shout(tostring(i), C.Orange, 0.7)
			end
			sfx("countdown", padPos)
			task.wait(1)
		end
		if not rocketFlights[m] then
			return
		end
		if near then
			shout("LIFTOFF!", Color3.fromRGB(255, 120, 90), 2)
		end
		sfx("liftoff", padPos)
		sfx("roar", padPos)
		-- engines to full, and a cloud of smoke rolling out across the pad
		local emitters = {}
		for _, p in ipairs(parts) do
			for _, e in ipairs(p:GetChildren()) do
				if e:IsA("ParticleEmitter") then
					emitters[e] = { e.Rate, e.Speed, e.Lifetime }
					e.Rate = 260
					e.Speed = NumberRange.new(18, 30)
					e.Lifetime = NumberRange.new(0.5, 0.9)
				end
			end
		end
		local smokeAt = anchorAt(padPos + Vector3.new(0, 1.5, 0))
		local smoke = Instance.new("ParticleEmitter")
		smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
		smoke.Color = ColorSequence.new(Color3.fromRGB(235, 235, 240))
		smoke.Size = NumberSequence.new(4, 12)
		smoke.Transparency = NumberSequence.new(0.3, 1)
		smoke.Lifetime = NumberRange.new(2, 3.5)
		smoke.Speed = NumberRange.new(10, 18)
		smoke.SpreadAngle = Vector2.new(80, 10)
		smoke.EmissionDirection = Enum.NormalId.Front
		smoke.Rate = 0
		smoke.Parent = smokeAt
		for k = 0, 7 do -- puff it out in every direction
			smokeAt.CFrame = CFrame.new(smokeAt.Position) * CFrame.Angles(0, k * math.pi / 4, 0)
			smoke:Emit(12)
		end
		smoke.Rate = 40
		task.delay(3, function()
			smoke.Rate = 0
		end)
		Debris:AddItem(smokeAt, 7)
		-- climb: slow at first, then faster and faster, with a little shake on the way off the pad
		local t0, flight = os.clock(), 7
		local conn
		conn = RunService.RenderStepped:Connect(function()
			local t = os.clock() - t0
			if not rocketFlights[m] then
				conn:Disconnect()
				return
			end
			local h = 14 * t * t
			local shake = t < 1.5 and Vector3.new(math.sin(t * 60) * 0.15, 0, math.cos(t * 53) * 0.15) or Vector3.zero
			for _, p in ipairs(parts) do
				p.CFrame = rocketHome[p][1] + Vector3.new(0, h, 0) + shake
			end
			if t >= flight then
				conn:Disconnect()
				for _, p in ipairs(parts) do
					p.Transparency = 1
				end
				for e, old in pairs(emitters) do
					e.Rate, e.Speed, e.Lifetime = old[1], old[2], old[3]
					e.Enabled = false
				end
			end
		end)
	end)
end

local function rocketBack(m)
	if not m then
		return
	end
	rocketFlights[m] = nil
	local pad = m:FindFirstChild("LaunchPadBase")
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") and rocketHome[p] then
			p.CFrame = rocketHome[p][1]
			p.Transparency = rocketHome[p][2]
			for _, e in ipairs(p:GetChildren()) do
				if e:IsA("ParticleEmitter") then
					e.Enabled = true
				end
			end
		end
	end
	if pad then
		burst(pad.Position + Vector3.new(0, 8, 0), C.Blue, 40)
	end
end

-- ---------- grabbing stars on your own screen first (2026-10-18, Matthew: pickups were delayed and laggy) ----------
-- The moment you touch a star it vanishes with a sparkle and a ding here, and the server is told; it checks and pays.
-- If the server says no (someone else got it), it comes back after two seconds.
local GrabStar = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("GrabStar", 30)
local claimed = {} -- [star] = os.clock() when we grabbed it
local function hideStar(s, hide)
	s.LocalTransparencyModifier = hide and 1 or 0
	for _, d in ipairs(s:GetDescendants()) do
		if d:IsA("ParticleEmitter") or d:IsA("Light") or d:IsA("BillboardGui") then
			d.Enabled = not hide
		end
	end
end
RunService.Heartbeat:Connect(function()
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not (hrp and starsFolder and GrabStar) then
		return
	end
	local reach, now0 = Config.Stars.pickupDistance, os.clock()
	for _, s in ipairs(starsFolder:GetChildren()) do
		local c = claimed[s]
		if c then
			if now0 - c > 2 and s.Parent then -- the server didn't take it: show it again
				claimed[s] = nil
				hideStar(s, false)
			end
		elseif s:IsA("BasePart") and s:GetAttribute("Ready") and (s.Position - hrp.Position).Magnitude <= reach then
			claimed[s] = now0
			hideStar(s, true)
			burst(s.Position, s.Color, 24)
			sfx("star", s.Position)
			GrabStar:FireServer(s)
		end
	end
	for s in pairs(claimed) do
		if not s.Parent then
			claimed[s] = nil
		end
	end
end)

-- ---------- dizzy stars over a stunned player's head ----------
local function dizzy(who, secs)
	local head = who and who.Character and who.Character:FindFirstChild("Head")
	if not head then
		return
	end
	local g = Instance.new("BillboardGui")
	g.Size = UDim2.fromScale(4, 1.4)
	g.StudsOffsetWorldSpace = Vector3.new(0, 2.2, 0)
	g.LightInfluence = 0
	g.AlwaysOnTop = true
	g.Parent = head
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = Color3.fromRGB(255, 230, 90)
	l.TextStrokeTransparency = 0.3
	l.Text = "★  ★  ★"
	l.Parent = g
	TweenService:Create(l, TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Rotation = 12 }):Play()
	Debris:AddItem(g, secs)
end

-- ---------- Low Gravity on this screen: a shout, a whoosh, and sparkles drifting up round you ----------
local function lowGrav(secs)
	shout("LOW GRAVITY!", Color3.fromRGB(140, 255, 170), 3)
	sfx("lowgrav")
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if hrp then
		local e = Instance.new("ParticleEmitter")
		e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		e.Color = ColorSequence.new(Color3.fromRGB(140, 255, 170), C.Blue)
		e.LightEmission = 1
		e.Size = NumberSequence.new(0.4, 0)
		e.Lifetime = NumberRange.new(1.5, 2.5)
		e.Speed = NumberRange.new(1, 3)
		e.Acceleration = Vector3.new(0, 3, 0)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Rate = 14
		e.Parent = hrp
		Debris:AddItem(e, secs)
	end
end

-- ---------- the telescope: the camera flies out to Earth and the ringed planet, then comes back ----------
local function telescope()
	local cam = workspace.CurrentCamera
	if cam.CameraType == Enum.CameraType.Scriptable then
		return
	end
	local space = station:FindFirstChild("Space")
	local function at(name, fallback)
		local p = space and space:FindFirstChild(name)
		return p and p.Position or fallback
	end
	local stops = { at("Earth", Vector3.new(-90, 75, -520)), at("RingedPlanet", Vector3.new(380, 230, 260)), at("GasGiant", Vector3.new(-560, 110, -120)) }
	local start, fov = cam.CFrame, cam.FieldOfView
	cam.CameraType = Enum.CameraType.Scriptable
	shout("TELESCOPE", C.Blue, 1.5)
	task.spawn(function()
		for _, target in ipairs(stops) do
			local from = cam.CFrame.Position
			local eye = target + (from - target).Unit * 260
			local tw = TweenService:Create(cam, TweenInfo.new(1.6, Enum.EasingStyle.Sine), { CFrame = CFrame.lookAt(eye, target), FieldOfView = 40 })
			tw:Play()
			tw.Completed:Wait()
			task.wait(1.6)
		end
		local back = TweenService:Create(cam, TweenInfo.new(1.2, Enum.EasingStyle.Sine), { CFrame = start, FieldOfView = fov })
		back:Play()
		back.Completed:Wait()
		cam.CameraType = Enum.CameraType.Custom
	end)
end

-- ---------- a little screen shake for the Meteor Shower (2026-10-25, Matthew) ----------
-- Small on purpose so it cannot make anyone feel sick: the camera slides a few tenths of a stud (it never turns) and settles in
-- about half a second. Runs just after Roblox's own camera each frame, so it never fights it, and leaves the telescope alone.
-- Sizes and the off switch are in Config.ScreenShake.
local SS = Config.ScreenShake
local shakeAmp = 0
local function shake(amount)
	if SS and SS.enabled and amount > 0 then
		shakeAmp = math.min(SS.max, shakeAmp + amount)
	end
end
RunService:BindToRenderStep("StarStationShake", Enum.RenderPriority.Camera.Value + 1, function(dt)
	if shakeAmp < 0.005 then
		shakeAmp = 0
		return
	end
	local cam = workspace.CurrentCamera
	if cam and cam.CameraType ~= Enum.CameraType.Scriptable then
		local t = os.clock() * SS.speed
		local cf = cam.CFrame
		cam.CFrame = cf + cf.RightVector * (math.noise(t, 1.7) * 2 * shakeAmp) + cf.UpVector * (math.noise(t, 9.3) * 2 * shakeAmp)
	end
	shakeAmp *= math.exp(-SS.decay * dt)
end)
-- a meteor landed: the sparkle burst, and a bump if it came down near you
local function meteorLanded(pos)
	burst(pos, C.Blue)
	local cam = workspace.CurrentCamera
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local from = hrp and hrp.Position or (cam and cam.CFrame.Position)
	if SS and from then
		local d = (pos - from).Magnitude
		if d < SS.radius then
			shake(SS.meteor * (1 - d / SS.radius))
		end
	end
end

FX.OnClientEvent:Connect(function(kind, a, b, c, d)
	if kind == "burst" then
		burst(a, b)
	elseif kind == "confetti" then
		sfx("home", a)
		burst(a, nil, 60, ColorSequence.new({ ColorSequenceKeypoint.new(0, C.Orange), ColorSequenceKeypoint.new(0.5, C.Blue), ColorSequenceKeypoint.new(1, C.Orange) }))
	elseif kind == "pop" then
		pop(a, b) -- the ding plays when you grab the star, not when the server answers
	elseif kind == "alarm" then
		alarm(a)
		sfx("alarm")
	elseif kind == "shower" then
		shout("METEOR SHOWER!", C.Blue, 3)
		sfx("shower")
		shake(SS and SS.start or 0)
	elseif kind == "meteor" then
		meteorLanded(a)
	elseif kind == "swing" then
		swing(a, b, c)
	elseif kind == "blast" then
		blast(a, b, c, d)
	elseif kind == "sfx" then
		sfx(a, b)
	elseif kind == "launch" then
		launch(a, b)
	elseif kind == "rocketback" then
		rocketBack(a)
	elseif kind == "dizzy" then
		dizzy(a, b)
	elseif kind == "lowgrav" then
		lowGrav(a)
	elseif kind == "telescope" then
		telescope()
	elseif kind == "captain" then
		shout("CAPTAIN ON DECK!", C.Orange, 3)
		sfx("captain")
	elseif kind == "pow" then
		burst(a, C.Orange, 40)
		pop(a + Vector3.new(0, 3, 0), "POW!", C.Orange)
		sfx("pow", a)
	elseif kind == "knock" then -- you were punched: fly back a bit
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if hrp then
			hrp.AssemblyLinearVelocity = a * Config.Punch.knock + Vector3.new(0, 28, 0)
		end
		flash.BackgroundColor3 = Color3.fromRGB(255, 160, 60)
		flash.BackgroundTransparency = 0.6
		local tw = TweenService:Create(flash, TweenInfo.new(0.4), { BackgroundTransparency = 1 })
		tw:Play()
		tw.Completed:Connect(function() flash.BackgroundColor3 = Color3.fromRGB(255, 40, 60) end)
	elseif kind == "zapped" then
		shout("ZAPPED!", Color3.fromRGB(255, 120, 120), 1.5)
		sfx("zapped")
	elseif kind == "night" then
		shout("BLACK HOLE NIGHT!", Color3.fromRGB(200, 140, 255), 3)
	elseif kind == "booped" then
		shout("BOOP!", Color3.fromRGB(200, 140, 255), 1.5)
		sfx("booped")
		flash.BackgroundColor3 = Color3.fromRGB(120, 50, 200)
		flash.BackgroundTransparency = 0.4
		local tw = TweenService:Create(flash, TweenInfo.new(0.8), { BackgroundTransparency = 1 })
		tw:Play()
		tw.Completed:Connect(function()
			flash.BackgroundColor3 = Color3.fromRGB(255, 40, 60)
		end)
	end
end)

-- ---------- your base: where it is, a guide beam home, "+income" above it ----------
local function myBase()
	for _, m in ipairs(station:GetChildren()) do
		if m:IsA("Model") and m:GetAttribute("OwnerUserId") == player.UserId then
			return m
		end
	end
	return nil
end

local beam, a0, a1 = nil, nil, nil
local function updateBeam()
	local carrying = player:GetAttribute("Carrying")
	local base = myBase()
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if carrying and base and base.PrimaryPart and hrp then
		if not beam then
			a0 = Instance.new("Attachment")
			a0.Name = "GuideFrom"
			a1 = Instance.new("Attachment")
			a1.Name = "GuideTo"
			beam = Instance.new("Beam")
			beam.Color = ColorSequence.new(C.Orange, C.Blue)
			beam.LightEmission = 1
			beam.Width0, beam.Width1 = 0.8, 2.4
			beam.FaceCamera = true
			beam.Transparency = NumberSequence.new(0.2, 0.5)
			beam.TextureSpeed = 2
			beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
			beam.Parent = fxFolder
		end
		a0.Parent = hrp
		a1.Parent = base.PrimaryPart
		a1.Position = Vector3.new(0, 2, 0)
		beam.Attachment0, beam.Attachment1 = a0, a1
		beam.Enabled = true
	elseif beam then
		beam.Enabled = false
	end
end
player:GetAttributeChangedSignal("Carrying"):Connect(updateBeam)
player.CharacterAdded:Connect(function()
	task.wait(0.5)
	updateBeam()
end)

task.spawn(function()
	while true do
		task.wait(1)
		local income = player:GetAttribute("Income") or 0
		local base = myBase()
		if income > 0 and base and base.PrimaryPart then
			local s = tostring(income):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
			pop(base.PrimaryPart.Position + Vector3.new(0, 9, 8), "+" .. s .. " ★", C.Orange)
		end
	end
end)

-- ---------- moving things: bobbing critters, spinning stars, rainbow colours ----------
local bobbers = {} -- [model] = { origin = CFrame, phase = number }
local starOrigins = {} -- [part] = CFrame
local rainbows = {} -- [model] = true

local function track(m)
	if not m:IsA("Model") then
		return
	end
	if m:GetAttribute("Rainbow") then
		rainbows[m] = true
	end
end
for _, m in ipairs(critters:GetChildren()) do
	track(m)
end
critters.ChildAdded:Connect(track)

local keep = { Eye = true, Pupil = true, Nose = true, Smile = true }
-- lag on the iPad (2026-10-25): only critters near the camera bob (far ones are too small to see it), and rainbow colours
-- change 20 times a second instead of every frame, from a list of parts made once per critter
local BOB_RANGE = 140 -- studs from the camera
local RAINBOW_EVERY = 1 / 20
local rainbowParts = {} -- [model] = { parts to recolour }
local rainbowClock = 0
local t = 0
RunService.RenderStepped:Connect(function(dt)
	t += dt
	local cam = workspace.CurrentCamera
	local camPos = cam and cam.CFrame.Position or Vector3.zero
	-- critters on pedestals bob gently (left alone the moment the server moves them)
	for _, m in ipairs(critters:GetChildren()) do
		local body = m:IsA("Model") and m.PrimaryPart
		if body and body.Anchored and m:GetAttribute("OnPedestal") and (bobbers[m] or (body.Position - camPos).Magnitude < BOB_RANGE) then
			local rec = bobbers[m]
			if not rec then
				rec = { origin = m:GetPivot(), phase = math.random() * 6 }
				bobbers[m] = rec
			end
			if (rec.origin.Position - camPos).Magnitude < BOB_RANGE then
				m:PivotTo(rec.origin * CFrame.new(0, math.sin(t * 2 + rec.phase) * 0.35, 0) * CFrame.Angles(0, math.sin(t * 0.8 + rec.phase) * 0.25, 0))
			end
		elseif bobbers[m] then
			bobbers[m] = nil
		end
	end
	for m in pairs(bobbers) do
		if not m.Parent then
			bobbers[m] = nil
		end
	end
	-- stars spin and bob once they've landed
	if starsFolder then
		for _, s in ipairs(starsFolder:GetChildren()) do
			if s:IsA("BasePart") and s:GetAttribute("Ready") then
				local o = starOrigins[s]
				if not o then
					o = s.CFrame
					starOrigins[s] = o
				end
				s.CFrame = o * CFrame.new(0, math.sin(t * 3 + o.Position.X) * 0.4, 0)
			end
		end
		for s in pairs(starOrigins) do
			if not s.Parent then
				starOrigins[s] = nil
			end
		end
	end
	-- rainbow critters cycle through the colours
	rainbowClock += dt
	if rainbowClock < RAINBOW_EVERY then
		return
	end
	rainbowClock = 0
	for m in pairs(rainbows) do
		if m.Parent then
			local h = (t * 0.25) % 1
			local body = m.PrimaryPart
			local by, bh = body and body.Position.Y or 0, body and body.Size.Y or 1
			local list = rainbowParts[m]
			if not list then
				list = {}
				for _, p in ipairs(m:GetDescendants()) do
					if p:IsA("BasePart") and not keep[p.Name] then
						table.insert(list, p)
					end
				end
				rainbowParts[m] = list
			end
			for _, p in ipairs(list) do
				-- the hue shifts with height, so a Rainbow critter wears a whole rainbow at once, top to bottom (2026-10-18)
				p.Color = Color3.fromHSV((h + (p.Position.Y - by) / bh * 0.35) % 1, 0.55, 1)
			end
			local tag = m.PrimaryPart and m.PrimaryPart:FindFirstChild("Tag")
			local nameL = tag and tag:FindFirstChild("CritterName")
			if nameL then
				nameL.TextColor3 = Color3.fromHSV(h, 0.6, 1)
			end
		else
			rainbows[m] = nil
			rainbowParts[m] = nil
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="18">
          <Properties>
            <string name="Name">Gear</string>
            <string name="Source"><![CDATA[-- Gear on this player's screen (2026-10-18): the Jet Boots' mid-air rocket boost for you, jet flames under everyone
-- wearing them, and the Gear Bay prompts saying "Take" instead of "Buy" for gear you already own.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage.Shared.Config)
local player = Players.LocalPlayer
local C = Config.Colors

-- ---------- your boost: press jump again while in the air, once per jump ----------
local boosted, jumpedAt = false, 0
local function hookCharacter(ch)
	local hum = ch:WaitForChild("Humanoid", 10)
	if not hum then
		return
	end
	boosted = false
	hum.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Jumping then
			jumpedAt = os.clock()
		elseif new == Enum.HumanoidStateType.Landed or new == Enum.HumanoidStateType.Running then
			boosted = false
		end
	end)
end
player.CharacterAdded:Connect(hookCharacter)
if player.Character then
	task.spawn(hookCharacter, player.Character)
end

UserInputService.JumpRequest:Connect(function()
	local ch = player.Character
	-- Jet Boots give a rocket boost; Double Jump (an upgrade) a plain second jump (2026-10-18)
	local power = ch and (ch:GetAttribute("JetBoots") or (ch:GetAttribute("DoubleJump") and 52))
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if not (power and hum and hrp) or boosted then
		return
	end
	if hum:GetState() ~= Enum.HumanoidStateType.Freefall or os.clock() - jumpedAt < 0.2 then
		return
	end
	boosted = true
	local v = hrp.AssemblyLinearVelocity
	hrp.AssemblyLinearVelocity = Vector3.new(v.X * 1.2, power, v.Z * 1.2)
	ch:SetAttribute("BoostedAt", os.clock()) -- only this screen reads it; others see the flames from the speed
	local def = ch:GetAttribute("JetBoots") and Config.Sounds.boost or Config.Sounds.swing
	if def then
		local s = Instance.new("Sound")
		s.SoundId = "rbxassetid://" .. def.id
		s.Volume = def.volume or 0.5
		s.Parent = SoundService
		s:Play()
		task.delay(def.stopAfter or 1, function()
			s:Destroy()
		end)
	end
end)

-- ---------- jet flames under anyone wearing Jet Boots, while they're rising ----------
local flames = {} -- [nozzle part] = ParticleEmitter
local function flameFor(nozzle)
	local e = flames[nozzle]
	if e and e.Parent then
		return e
	end
	e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(Color3.fromRGB(255, 240, 170), C.Orange)
	e.LightEmission = 1
	e.Size = NumberSequence.new(0.7, 0)
	e.Lifetime = NumberRange.new(0.15, 0.3)
	e.Rate = 60
	e.Speed = NumberRange.new(6, 10)
	e.EmissionDirection = Enum.NormalId.Bottom
	e.Enabled = false
	e.Parent = nozzle
	flames[nozzle] = e
	return e
end

RunService.RenderStepped:Connect(function()
	for _, p in ipairs(Players:GetPlayers()) do
		local ch = p.Character
		local boots = ch and ch:GetAttribute("JetBoots") and ch:FindFirstChild("JetBoots")
		local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
		if boots and hrp then
			local rising = hrp.AssemblyLinearVelocity.Y > 6
			for _, part in ipairs(boots:GetChildren()) do
				if part:GetAttribute("JetNozzle") then
					flameFor(part).Enabled = rising
				end
			end
		end
	end
end)

-- ---------- Gear Bay prompts: "Take" for gear you own ----------
ProximityPromptService.PromptShown:Connect(function(prompt)
	-- the Upgrade Lab: your next level and its price, or MAXED
	local uid = prompt:GetAttribute("UpgradeId")
	local u = uid and Config.upgradeById(uid)
	if u then
		local lv = player:GetAttribute("Up_" .. uid) or 0
		if lv >= #u.prices then
			prompt.ActionText = "MAXED"
		else
			local n = tostring(u.prices[lv + 1]):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
			prompt.ActionText = (#u.prices > 1 and ("Level " .. (lv + 1) .. " ") or "Buy ") .. "(" .. n .. " ★)"
		end
	end
	local fid = prompt:GetAttribute("FurnitureId")
	if fid and player:GetAttribute("OwnsF_" .. fid) then
		prompt.ActionText = "In your base"
	end
	local id = prompt:GetAttribute("GearId")
	local def = id and Config.gearById(id)
	if def and player:GetAttribute("Owns_" .. id) then
		prompt.ActionText = def.kind == "weapon" and "In your backpack" or "Owned"
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="19">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[-- What each player sees: the title screen, their Stardust, the airlock button, messages, and a marker over their own base.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local Notify = remotes:WaitForChild("Notify")
local UIS = game:GetService("UserInputService")
-- a tablet or phone: Roblox puts its joystick bottom-left and Jump bottom-right, so our buttons move clear of both (2026-10-18)
local TOUCH = UIS.TouchEnabled and not UIS.KeyboardEnabled
local ShieldRequest = remotes:WaitForChild("ShieldRequest")

local player = Players.LocalPlayer
local C = Config.Colors

local gui = Instance.new("ScreenGui")
gui.Name = "StarStationHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

local function corner(obj, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 12)
	c.Parent = obj
end

local function label(parent, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = Color3.new(1, 1, 1)
	for k, v in pairs(props) do
		l[k] = v
	end
	l.Parent = parent
	return l
end

-- ---------- Stardust counter (top left) ----------
local panel = Instance.new("Frame")
panel.Name = "Stardust"
panel.Position = UDim2.new(0, 16, 0, 60)
panel.Size = UDim2.fromOffset(260, 86)
panel.BackgroundColor3 = C.Dark
panel.BackgroundTransparency = 0.15
panel.Parent = gui
corner(panel, 16)
local stroke = Instance.new("UIStroke")
stroke.Color = C.Orange
stroke.Thickness = 2
stroke.Parent = panel
local dustL = label(panel, { Position = UDim2.new(0, 14, 0, 6), Size = UDim2.new(1, -28, 0, 46), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Orange, Text = "★ 0" })
local incomeL = label(panel, { Position = UDim2.new(0, 14, 0, 52), Size = UDim2.new(1, -28, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Blue, Font = Enum.Font.GothamBold, Text = "+0 Stardust / second" })

local function commas(n)
	local s = tostring(math.floor(n or 0))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (out:gsub("^,", ""))
end

local function refreshDust()
	dustL.Text = "★ " .. commas(player:GetAttribute("Stardust"))
	incomeL.Text = "+" .. commas(player:GetAttribute("Income")) .. " Stardust / second"
end
player:GetAttributeChangedSignal("Stardust"):Connect(refreshDust)
player:GetAttributeChangedSignal("Income"):Connect(refreshDust)
refreshDust()

-- ---------- airlock button (bottom right) ----------
local shieldBtn = Instance.new("TextButton")
shieldBtn.Name = "Door"
shieldBtn.AnchorPoint = Vector2.new(1, 1)
shieldBtn.Position = TOUCH and UDim2.new(1, -16, 1, -250) or UDim2.new(1, -16, 1, -24)
shieldBtn.Size = UDim2.fromOffset(230, 70)
shieldBtn.BackgroundColor3 = C.Blue
shieldBtn.Font = Enum.Font.FredokaOne
shieldBtn.TextScaled = true
shieldBtn.TextColor3 = C.Dark
shieldBtn.Text = "Lock Door"
shieldBtn.Parent = gui
corner(shieldBtn, 16)
local pad = Instance.new("UIPadding")
pad.PaddingLeft = UDim.new(0, 12)
pad.PaddingRight = UDim.new(0, 12)
pad.PaddingTop = UDim.new(0, 10)
pad.PaddingBottom = UDim.new(0, 10)
pad.Parent = shieldBtn
shieldBtn.Activated:Connect(function()
	ShieldRequest:FireServer()
end)

-- ---------- expand base button (above the airlock) ----------
local Expand = remotes:WaitForChild("Expand")
local expandBtn = Instance.new("TextButton")
expandBtn.Name = "ExpandBase"
expandBtn.AnchorPoint = Vector2.new(1, 1)
expandBtn.Position = TOUCH and UDim2.new(1, -16, 1, -330) or UDim2.new(1, -16, 1, -104)
expandBtn.Size = UDim2.fromOffset(230, 52)
expandBtn.BackgroundColor3 = C.Orange
expandBtn.Font = Enum.Font.FredokaOne
expandBtn.TextScaled = true
expandBtn.TextColor3 = C.Dark
expandBtn.Parent = gui
corner(expandBtn, 14)
local ep = Instance.new("UIPadding")
ep.PaddingLeft, ep.PaddingRight, ep.PaddingTop, ep.PaddingBottom = UDim.new(0, 10), UDim.new(0, 10), UDim.new(0, 8), UDim.new(0, 8)
ep.Parent = expandBtn
local function refreshExpand()
	local cost = player:GetAttribute("NextExpand") or 0
	if cost > 0 then
		expandBtn.Text = "Expand Base: " .. commas(cost) .. " ★"
		expandBtn.AutoButtonColor = true
		expandBtn.BackgroundColor3 = C.Orange
	else
		expandBtn.Text = "Base is full size"
		expandBtn.BackgroundColor3 = Color3.fromRGB(120, 128, 150)
	end
end
player:GetAttributeChangedSignal("NextExpand"):Connect(refreshExpand)
refreshExpand()
expandBtn.Activated:Connect(function()
	Expand:FireServer()
end)

-- ---------- drop what you are carrying (G), to grab something better (2026-10-18) ----------
local Drop = remotes:WaitForChild("Drop")
local dropBtn = Instance.new("TextButton")
dropBtn.Name = "Drop"
dropBtn.AnchorPoint = Vector2.new(0.5, 1)
dropBtn.Position = UDim2.new(0.5, 0, 1, -122) -- above the sprint bar and the backpack bar (2026-10-18)
dropBtn.Size = UDim2.fromOffset(240, 54)
dropBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 60)
dropBtn.Font = Enum.Font.FredokaOne
dropBtn.TextScaled = true
dropBtn.TextColor3 = Color3.new(1, 1, 1)
dropBtn.Visible = false
dropBtn.Parent = gui
corner(dropBtn, 14)
local dp = Instance.new("UIPadding")
dp.PaddingLeft, dp.PaddingRight, dp.PaddingTop, dp.PaddingBottom = UDim.new(0, 10), UDim.new(0, 10), UDim.new(0, 8), UDim.new(0, 8)
dp.Parent = dropBtn
local function refreshDrop()
	local c = player:GetAttribute("Carrying")
	dropBtn.Visible = c ~= nil
	if c then
		dropBtn.Text = "Drop " .. c .. " (G)"
	end
end
player:GetAttributeChangedSignal("Carrying"):Connect(refreshDrop)
refreshDrop()
dropBtn.Activated:Connect(function()
	Drop:FireServer()
end)
UIS.InputBegan:Connect(function(input, typing)
	if not typing and input.KeyCode == Enum.KeyCode.G and player:GetAttribute("Carrying") then
		Drop:FireServer()
	end
end)

local function myBase()
	local station = workspace:FindFirstChild("Station")
	if not station then
		return nil
	end
	for _, m in ipairs(station:GetChildren()) do
		if m:IsA("Model") and m:GetAttribute("OwnerUserId") == player.UserId then
			return m
		end
	end
	return nil
end

-- ---------- "YOUR BASE" marker, only on your own screen ----------
local marker = nil
local function updateMarker()
	local base = myBase()
	if marker and (not base or marker.Adornee ~= base.PrimaryPart) then
		marker:Destroy()
		marker = nil
	end
	if base and base.PrimaryPart and not marker then
		marker = Instance.new("BillboardGui")
		marker.Name = "YourBaseMarker"
		marker.Adornee = base.PrimaryPart
		marker.Size = UDim2.fromOffset(260, 70)
		marker.StudsOffsetWorldSpace = Vector3.new(0, 24, 0)
		marker.AlwaysOnTop = true
		marker.LightInfluence = 0
		marker.Parent = gui
		label(marker, { Size = UDim2.fromScale(1, 1), TextColor3 = C.Orange, TextStrokeTransparency = 0.2, Text = "▼ YOUR BASE ▼" })
	end
end

-- ---------- punch (2026-10-18): Q, a click, or the PUNCH button. Knocks a carried critter loose, stuns a Parker Bot ----------
local Punch = remotes:WaitForChild("Punch")
local lastPunch = 0
-- holding a Gear Bay weapon turns a punch into that weapon (2026-10-18): the server checks what is in your hand
local function heldTool()
	local ch = player.Character
	return ch and ch:FindFirstChildOfClass("Tool")
end
-- the arm swing (2026-10-18, Matthew: still no arm movement): Roblox's own sword slash and lunge, the animations its default
-- avatar code uses, played on your character. Your character's animations show for everyone, so nothing else is needed.
local ARM_ANIMS = {
	R15 = { slash = 522635514, lunge = 522638767 },
	R6 = { slash = 129967390, lunge = 129967478 },
}
local armTracks = {} -- [Animator] = { slash = track, lunge = track }
local function swingArm(kind, speed)
	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if not animator then
		return
	end
	local set = armTracks[animator]
	if not set then
		set = {}
		armTracks[animator] = set
	end
	local track = set[kind]
	if not track then
		local ids = hum.RigType == Enum.HumanoidRigType.R15 and ARM_ANIMS.R15 or ARM_ANIMS.R6
		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://" .. ids[kind]
		local ok, t = pcall(function()
			return animator:LoadAnimation(anim)
		end)
		if not ok then
			return
		end
		track = t
		track.Priority = Enum.AnimationPriority.Action
		set[kind] = track
	end
	track:Play(0.05, 1, speed or 1)
end

local function punch()
	local tool = heldTool()
	if os.clock() - lastPunch < (tool and tool:GetAttribute("Cooldown") or Config.Punch.cooldown) then
		return
	end
	lastPunch = os.clock()
	Punch:FireServer()
	local gid = tool and tool:GetAttribute("GearId")
	if gid == "glove" then
		swingArm("lunge", 1.4)
	elseif gid ~= "blaster" then
		swingArm("slash", 1.7)
	end
end
UIS.InputBegan:Connect(function(input, typing)
	if typing then
		return
	end
	if input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.ButtonX or input.UserInputType == Enum.UserInputType.MouseButton1 then
		punch()
	end
end)
if UIS.TouchEnabled then
	local pb = Instance.new("TextButton")
	pb.Name = "Punch"
	pb.AnchorPoint = Vector2.new(1, 1)
	pb.Position = UDim2.new(1, -180, 1, -40)
	pb.Size = UDim2.fromOffset(100, 100)
	pb.BackgroundColor3 = Color3.fromRGB(230, 90, 70)
	pb.Font = Enum.Font.FredokaOne
	pb.TextScaled = true
	pb.TextColor3 = Color3.new(1, 1, 1)
	pb.Text = "PUNCH"
	pb.Parent = gui
	corner(pb, 50)
	local pp = Instance.new("UIPadding")
	pp.PaddingLeft, pp.PaddingRight = UDim.new(0, 14), UDim.new(0, 14)
	pp.Parent = pb
	pb.Activated:Connect(punch)
	-- the button says what it does: PUNCH, or BOING / ZAP while you hold a weapon
	local function relabel()
		local tool = heldTool()
		pb.Text = tool and (tool:GetAttribute("Button") or "USE") or "PUNCH"
		pb.BackgroundColor3 = (tool and tool:GetAttribute("GearId") == "blaster") and Color3.fromRGB(70, 140, 230) or Color3.fromRGB(230, 90, 70)
	end
	local function watch(ch)
		ch.ChildAdded:Connect(relabel)
		ch.ChildRemoved:Connect(relabel)
		relabel()
	end
	player.CharacterAdded:Connect(watch)
	if player.Character then
		watch(player.Character)
	end
end
-- a tap on the screen while holding a weapon (how tablets use tools) fires it too
local hooked = {}
local function hookTools(ch)
	ch.ChildAdded:Connect(function(t)
		if t:IsA("Tool") and not hooked[t] then
			hooked[t] = true
			t.Activated:Connect(punch)
		end
	end)
end
player.CharacterAdded:Connect(hookTools)
if player.Character then
	hookTools(player.Character)
end

RunService.Heartbeat:Connect(function()
	local base = myBase()
	local t = workspace:GetServerTimeNow()
	if base then
		local su, cu = base:GetAttribute("ShieldUntil") or 0, base:GetAttribute("CooldownUntil") or 0
		if su > t then
			shieldBtn.Text = "Unlock Door (" .. math.ceil(su - t) .. "s)"
			shieldBtn.BackgroundColor3 = C.Orange
		elseif cu > t then
			shieldBtn.Text = "Lock again in " .. math.ceil(cu - t) .. "s"
			shieldBtn.BackgroundColor3 = Color3.fromRGB(120, 128, 150)
		else
			shieldBtn.Text = "Lock Door"
			shieldBtn.BackgroundColor3 = C.Blue
		end
	end
	updateMarker()
end)

-- ---------- hide "Steal" on your own critters ----------
-- the Captain's control panel shows only for the Captain (2026-10-18)
local captainPrompts = {}
local function captainReach(obj)
	obj.MaxActivationDistance = player:GetAttribute("Captain") and (obj:GetAttribute("Reach") or 9) or 0
end
player:GetAttributeChangedSignal("Captain"):Connect(function()
	for _, p in ipairs(captainPrompts) do
		captainReach(p)
	end
end)
local function checkPrompt(obj)
	if obj:IsA("ProximityPrompt") and obj:GetAttribute("CaptainOnly") then
		table.insert(captainPrompts, obj)
		captainReach(obj)
	end
	if obj:IsA("ProximityPrompt") then
		if obj:GetAttribute("OwnerUserId") == player.UserId then
			obj.MaxActivationDistance = 0 -- no Steal on your own critters (the server never changes this, so it stays hidden)
		end
		local only = obj:GetAttribute("OnlyFor")
		if only and only ~= player.UserId then
			obj.MaxActivationDistance = 0 -- Sell shows only for the owner
		end
	end
end
for _, d in ipairs(workspace:GetDescendants()) do
	checkPrompt(d)
end
workspace.DescendantAdded:Connect(checkPrompt)

-- ---------- messages (top middle) ----------
local toasts = Instance.new("Frame")
toasts.Name = "Messages"
toasts.AnchorPoint = Vector2.new(0.5, 0)
toasts.Position = UDim2.new(0.5, 0, 0, 70)
toasts.Size = UDim2.fromOffset(560, 300)
toasts.BackgroundTransparency = 1
toasts.Parent = gui
local list = Instance.new("UIListLayout")
list.Padding = UDim.new(0, 8)
list.HorizontalAlignment = Enum.HorizontalAlignment.Center
list.SortOrder = Enum.SortOrder.LayoutOrder
list.Parent = toasts

local KIND = {
	info = { bg = C.Dark, fg = Color3.new(1, 1, 1) },
	good = { bg = Color3.fromRGB(40, 110, 80), fg = Color3.new(1, 1, 1) },
	bad = { bg = Color3.fromRGB(150, 50, 60), fg = Color3.new(1, 1, 1) },
	rare = { bg = Color3.fromRGB(150, 110, 20), fg = Color3.new(1, 1, 1) },
	cosmic = { bg = Color3.fromRGB(170, 60, 140), fg = Color3.new(1, 1, 1) },
}
local order = 0
Notify.OnClientEvent:Connect(function(text, kind)
	local k = KIND[kind] or KIND.info
	order += 1
	local f = Instance.new("TextLabel")
	f.LayoutOrder = order
	f.Size = UDim2.fromOffset(540, 46)
	f.BackgroundColor3 = k.bg
	f.BackgroundTransparency = 0.1
	f.Font = Enum.Font.FredokaOne
	f.TextScaled = true
	f.TextColor3 = k.fg
	f.Text = text
	f.Parent = toasts
	corner(f, 12)
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, 12)
	p.PaddingRight = UDim.new(0, 12)
	p.PaddingTop = UDim.new(0, 6)
	p.PaddingBottom = UDim.new(0, 6)
	p.Parent = f
	task.delay(kind == "cosmic" and 6 or 3.5, function()
		local tw = TweenService:Create(f, TweenInfo.new(0.4), { BackgroundTransparency = 1, TextTransparency = 1 })
		tw:Play()
		tw.Completed:Wait()
		f:Destroy()
	end)
	while #toasts:GetChildren() > 6 do -- keep the stack short
		for _, ch in ipairs(toasts:GetChildren()) do
			if ch:IsA("TextLabel") then
				ch:Destroy()
				break
			end
		end
	end
end)

-- ---------- title screen ----------
local title = Instance.new("Frame")
title.Name = "TitleScreen"
title.Size = UDim2.fromScale(1, 1)
title.BackgroundColor3 = C.Dark
title.ZIndex = 10
title.Parent = gui
local grad = Instance.new("UIGradient")
grad.Color = ColorSequence.new(Color3.fromRGB(20, 26, 48), Color3.fromRGB(10, 12, 22))
grad.Rotation = 90
grad.Parent = title
label(title, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.34), Size = UDim2.fromScale(0.8, 0.16), TextColor3 = C.Orange, ZIndex = 11, Text = Config.GameTitle })
label(title, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.48), Size = UDim2.fromScale(0.7, 0.06), TextColor3 = C.Blue, Font = Enum.Font.GothamBold, ZIndex = 11,
	Text = "Grab space critters. Guard your base. Catch the thieves!" })
local play = Instance.new("TextButton")
play.AnchorPoint = Vector2.new(0.5, 0.5)
play.Position = UDim2.fromScale(0.5, 0.65)
play.Size = UDim2.fromOffset(260, 80)
play.BackgroundColor3 = C.Blue
play.Font = Enum.Font.FredokaOne
play.TextScaled = true
play.TextColor3 = C.Dark
play.Text = "PLAY"
play.ZIndex = 11
play.Parent = title
corner(play, 20)
play.Activated:Connect(function()
	local tw = TweenService:Create(title, TweenInfo.new(0.5), { BackgroundTransparency = 1 })
	for _, ch in ipairs(title:GetChildren()) do
		if ch:IsA("TextLabel") or ch:IsA("TextButton") then
			ch.Visible = false
		end
	end
	tw:Play()
	tw.Completed:Wait()
	title:Destroy()
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="20">
          <Properties>
            <string name="Name">Pets</string>
            <string name="Source"><![CDATA[-- Draws every player's pet (the critter they picked in the Collection Book) floating along beside them.
-- Purely on each screen: it costs the server nothing and never affects the game.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local CritterModels = require(ReplicatedStorage.Shared.CritterModels)

local folder = Instance.new("Folder")
folder.Name = "Pets"
folder.Parent = workspace

local pets = {} -- [player] = { key, model, phase }

local function buildPet(key, owner)
	local def, mut = Config.fromKey(key)
	if not def then
		return nil
	end
	local m = CritterModels.build(def, CFrame.new(0, -500, 0), mut)
	local body = m.PrimaryPart
	local tag = body:FindFirstChild("Tag")
	if tag then
		local nameL = tag:FindFirstChild("CritterName")
		local info = tag:FindFirstChild("Info")
		if info then
			info.Text = owner.DisplayName .. "'s pet"
		end
		if nameL then
			nameL.Text = m.Name
		end
		tag.MaxDistance = 40
		tag.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
	end
	pcall(function()
		m:ScaleTo(0.6)
	end)
	m.Parent = folder
	return m
end

local keep = { Eye = true, Pupil = true, Nose = true }
local t = 0
RunService.RenderStepped:Connect(function(dt)
	t += dt
	for _, p in ipairs(Players:GetPlayers()) do
		local key = p:GetAttribute("Pet")
		local rec = pets[p]
		if (rec and rec.key) ~= key then
			if rec and rec.model then
				rec.model:Destroy()
			end
			pets[p] = nil
			rec = nil
			if key then
				rec = { key = key, model = buildPet(key, p), phase = math.random() * 6 }
				pets[p] = rec
			end
		end
		local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		if rec and rec.model and hrp then
			local target = hrp.CFrame * CFrame.new(3.4, 1.4 + math.sin(t * 3 + rec.phase) * 0.45, 3)
			local current = rec.model:GetPivot()
			if (current.Position - target.Position).Magnitude > 40 then
				rec.model:PivotTo(target) -- teleported: catch up at once
			else
				rec.model:PivotTo(current:Lerp(target, math.clamp(dt * 7, 0, 1)))
			end
			if rec.model:GetAttribute("Rainbow") then
				local h = (t * 0.25) % 1
				for _, part in ipairs(rec.model:GetDescendants()) do
					if part:IsA("BasePart") and not keep[part.Name] then
						part.Color = Color3.fromHSV(h, 0.55, 1)
					end
				end
			end
		end
	end
	for p, rec in pairs(pets) do
		if not p.Parent then
			if rec.model then
				rec.model:Destroy()
			end
			pets[p] = nil
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="21">
          <Properties>
            <string name="Name">Rover</string>
            <string name="Source"><![CDATA[-- Driving the Moon Rover (2026-10-18): while you sit in its seat, your screen steers it. WASD / arrow keys or the
-- tablet joystick come through the VehicleSeat as Throttle and Steer; the server hands you the rover while you drive.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local MAX_SPEED = 32 -- a bit faster than sprinting (27)
local REVERSE_SPEED = 14
local TURN_RATE = 1.9 -- radians per second at full lock
local ACCEL = 30 -- studs per second, per second

local speed, yaw, driving = 0, 0, nil

RunService.RenderStepped:Connect(function(dt)
	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	local seat = hum and hum.SeatPart
	if not (seat and seat:IsA("VehicleSeat") and seat:GetAttribute("Rover")) then
		driving, speed = nil, 0
		return
	end
	local rover = seat.Parent
	local hull = rover and rover.PrimaryPart
	local lv = hull and hull:FindFirstChildOfClass("LinearVelocity")
	local turn = hull and hull:FindFirstChildOfClass("AlignOrientation")
	if not (lv and turn) then
		return
	end
	if driving ~= seat then -- just got in: start from where it's pointing
		driving = seat
		local _, y = hull.CFrame:ToEulerAnglesYXZ()
		yaw, speed = y, 0
	end
	local throttle, steer = seat.ThrottleFloat, seat.SteerFloat
	local target = throttle > 0 and throttle * MAX_SPEED or throttle * REVERSE_SPEED
	if speed < target then
		speed = math.min(target, speed + ACCEL * dt)
	elseif speed > target then
		speed = math.max(target, speed - ACCEL * 1.5 * dt)
	end
	-- steer like a car: turning needs some speed, and flips when reversing
	local grip = math.clamp(math.abs(speed) / 8, 0.35, 1) * (speed < -0.5 and -1 or 1)
	yaw -= steer * TURN_RATE * grip * dt
	local heading = CFrame.Angles(0, yaw, 0)
	turn.CFrame = heading
	lv.VectorVelocity = heading.LookVector * speed
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="22">
          <Properties>
            <string name="Name">Spin</string>
            <string name="Source"><![CDATA[-- Turns everything marked with a "SpinSpeed" attribute (degrees per second) on this player's screen only,
-- and sends a shooting star across the sky now and then. Nothing here touches the game rules.
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local station = workspace:WaitForChild("Station", 30)
if not station then
	return
end
local decor = station:WaitForChild("Decor", 30)
if not decor then
	return
end

local spinners = {}
for _, obj in ipairs(decor:GetDescendants()) do
	if (obj:IsA("BasePart") or obj:IsA("Model")) and obj:GetAttribute("SpinSpeed") then
		table.insert(spinners, { obj = obj, speed = math.rad(obj:GetAttribute("SpinSpeed")) })
	end
end
for _, obj in ipairs(decor:GetChildren()) do -- asteroids are models in the folder itself
	if obj:IsA("Model") and obj:GetAttribute("SpinSpeed") and obj.PrimaryPart then
		local seen = false
		for _, s in ipairs(spinners) do
			if s.obj == obj then
				seen = true
			end
		end
		if not seen then
			table.insert(spinners, { obj = obj, speed = math.rad(obj:GetAttribute("SpinSpeed")) })
		end
	end
end

-- the belt stripes in the launch tunnel travel with the critters and loop back to the start
local belt = {}
for _, obj in ipairs(decor:GetDescendants()) do
	if obj:IsA("BasePart") and obj:GetAttribute("Belt") then
		table.insert(belt, obj)
	end
end
local Config = require(game:GetService("ReplicatedStorage").Shared.Config)
RunService.RenderStepped:Connect(function(dt)
	for _, s in ipairs(belt) do
		local p = s.Position
		local x = p.X + Config.ConveyorSpeed * dt
		if x > 64 then
			x -= 129
		end
		s.CFrame = CFrame.new(x, p.Y, p.Z)
	end
end)

-- turn around the world's up axis through the object's own centre, keeping its tilt
local function turn(cf, a)
	return CFrame.new(cf.Position) * CFrame.Angles(0, a, 0) * (cf - cf.Position)
end

RunService.RenderStepped:Connect(function(dt)
	for _, s in ipairs(spinners) do
		local o = s.obj
		if o.Parent then
			if o:IsA("Model") then
				o:PivotTo(turn(o:GetPivot(), s.speed * dt))
			else
				o.CFrame = turn(o.CFrame, s.speed * dt)
			end
		end
	end
end)

-- things that bob up and down (the UFO) and lights that blink (rocket beacons) (2026-10-18)
local bobbers, blinkers = {}, {}
for _, obj in ipairs(decor:GetDescendants()) do
	if obj:IsA("Model") and obj:GetAttribute("Bob") then
		table.insert(bobbers, { obj = obj, h = obj:GetAttribute("Bob"), last = 0 })
	elseif obj:IsA("BasePart") and obj:GetAttribute("Blink") then
		table.insert(blinkers, obj)
	end
end
local clock = 0
RunService.RenderStepped:Connect(function(dt)
	clock += dt
	for _, b in ipairs(bobbers) do
		if b.obj.Parent then
			local y = math.sin(clock * 1.6) * b.h
			b.obj:PivotTo(b.obj:GetPivot() + Vector3.new(0, y - b.last, 0))
			b.last = y
		end
	end
	local on = math.floor(clock * 1.5) % 2 == 0
	for _, p in ipairs(blinkers) do
		p.Transparency = on and 0 or 0.85
	end
end)

-- lag on the iPad (2026-10-25): anything this script moves every frame stops casting a shadow. A shadow that moves has to be
-- redrawn every frame, and the asteroids, light drones, UFO and spinning shop displays were doing that all the time.
local function noShadow(obj)
	if obj:IsA("BasePart") then
		obj.CastShadow = false
	end
	for _, d in ipairs(obj:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CastShadow = false
		end
	end
end
for _, s in ipairs(spinners) do
	noShadow(s.obj)
end
for _, b in ipairs(bobbers) do
	noShadow(b.obj)
end

-- shooting stars
local rng = Random.new()
task.spawn(function()
	while true do
		task.wait(rng:NextNumber(4, 9))
		local angle = rng:NextNumber(0, math.pi * 2)
		local start = Vector3.new(math.cos(angle) * 450, rng:NextNumber(120, 220), math.sin(angle) * 450)
		local dir = Vector3.new(-math.sin(angle), rng:NextNumber(-0.25, -0.05), math.cos(angle)).Unit
		local star = Instance.new("Part")
		star.Name = "ShootingStar"
		star.Anchored = true
		star.CanCollide = false
		star.CanQuery = false
		star.CanTouch = false
		star.CastShadow = false
		star.Material = Enum.Material.Neon
		star.Color = Color3.fromRGB(255, 240, 220)
		star.Size = Vector3.new(0.6, 0.6, 18)
		star.CFrame = CFrame.lookAt(start, start + dir)
		star.Parent = workspace
		local tw = TweenService:Create(star, TweenInfo.new(1.3, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(start + dir * 320, start + dir * 321), Transparency = 1 })
		tw:Play()
		tw.Completed:Connect(function()
			star:Destroy()
		end)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="23">
          <Properties>
            <string name="Name">Sprint</string>
            <string name="Source"><![CDATA[-- Sprint (2026-10-18, Matthew: "a sprint feature that has a meter to it that drains and slowly brings back up").
-- Hold Shift, or the Sprint button on a phone or tablet. The energy bar drains while you run and refills after you stop.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local S = Config.Sprint
local C = Config.Colors
local player = Players.LocalPlayer

local energy, wantRun, lastRun = 1, false, 0

local gui = Instance.new("ScreenGui")
gui.Name = "Sprint"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

-- the energy bar, bottom middle
local bar = Instance.new("Frame")
bar.AnchorPoint = Vector2.new(0.5, 1)
bar.Position = UDim2.new(0.5, 0, 1, -84) -- above Roblox's backpack bar, where weapons show up (2026-10-18)
bar.Size = UDim2.fromOffset(300, 26)
bar.BackgroundColor3 = C.Dark
bar.BackgroundTransparency = 0.15
bar.Parent = gui
local bc = Instance.new("UICorner")
bc.CornerRadius = UDim.new(1, 0)
bc.Parent = bar
local bs = Instance.new("UIStroke")
bs.Color = C.Blue
bs.Thickness = 2
bs.Parent = bar
local fill = Instance.new("Frame")
fill.Size = UDim2.fromScale(1, 1)
fill.BackgroundColor3 = C.Blue
fill.Parent = bar
local fc = Instance.new("UICorner")
fc.CornerRadius = UDim.new(1, 0)
fc.Parent = fill
local label = Instance.new("TextLabel")
label.Size = UDim2.fromScale(1, 1)
label.BackgroundTransparency = 1
label.Font = Enum.Font.FredokaOne
label.TextScaled = true
label.TextColor3 = Color3.new(1, 1, 1)
label.TextStrokeTransparency = 0.3
label.Text = "SPRINT (Shift)"
label.ZIndex = 2
label.Parent = bar

-- a Sprint button for touch screens
if UserInputService.TouchEnabled then
	label.Text = "SPRINT"
	local btn = Instance.new("TextButton")
	btn.AnchorPoint = Vector2.new(1, 1)
	btn.Position = UDim2.new(1, -295, 1, -50) -- left of PUNCH, clear of Jump (2026-10-18)
	btn.Size = UDim2.fromOffset(110, 70)
	btn.BackgroundColor3 = C.Blue
	btn.Font = Enum.Font.FredokaOne
	btn.TextScaled = true
	btn.TextColor3 = C.Dark
	btn.Text = "Sprint"
	btn.Parent = gui
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 16)
	c.Parent = btn
	btn.MouseButton1Down:Connect(function()
		wantRun = true
	end)
	btn.MouseButton1Up:Connect(function()
		wantRun = false
	end)
	btn.MouseLeave:Connect(function()
		wantRun = false
	end)
end

UserInputService.InputBegan:Connect(function(input, typing)
	if typing then
		return
	end
	if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift or input.KeyCode == Enum.KeyCode.ButtonL3 then
		wantRun = true
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift or input.KeyCode == Enum.KeyCode.ButtonL3 then
		wantRun = false
	end
end)

local tired = false -- once empty, you have to let it refill a bit before running again
RunService.Heartbeat:Connect(function(dt)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	local moving = hum.MoveDirection.Magnitude > 0.1
	local running = wantRun and moving and energy > 0 and not tired
	if running then
		energy = math.max(0, energy - S.drainPerSecond / 100 * dt)
		lastRun = os.clock()
		if energy <= 0 then
			tired = true
		end
	elseif os.clock() - lastRun > S.refillDelay then
		energy = math.min(1, energy + S.refillPerSecond / 100 * dt)
		if tired and energy > 0.25 then
			tired = false
		end
	end
	-- Turbo Legs adds speed; a hit stuns you for a moment (2026-10-18)
	local ch = player.Character
	local lvl = ch:GetAttribute("SpeedLevel") or 0
	local stunned = (ch:GetAttribute("StunnedUntil") or 0) > workspace:GetServerTimeNow()
	if stunned then
		hum.WalkSpeed = 4
	else
		hum.WalkSpeed = running and (S.run + lvl * Config.SpeedPerLevel.run) or (S.walk + lvl * Config.SpeedPerLevel.walk)
	end
	fill.Size = UDim2.fromScale(math.max(energy, 0.001), 1)
	fill.BackgroundColor3 = tired and Color3.fromRGB(150, 156, 176) or (running and C.Orange or C.Blue)
end)

player.CharacterAdded:Connect(function()
	energy, tired = 1, false
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="24">
          <Properties>
            <string name="Name">Station</string>
            <string name="Source"><![CDATA[-- The station's moving parts on this player's screen (2026-10-18, Matthew's batch): the metal gates rolling down and up
-- with each base's lock, disco balls, trampolines, comets crossing the sky, and extra twinkling stars over the open roof.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage.Shared.Config)
local player = Players.LocalPlayer
local station = workspace:WaitForChild("Station", 30)
if not station then
	return
end

local function sfx(name, pos)
	local def = Config.Sounds[name]
	if not def then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = "rbxassetid://" .. def.id
	s.Volume = def.volume or 0.5
	s.PlaybackSpeed = def.pitch or 1
	local holder = s
	if pos then
		local p = Instance.new("Part")
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.Transparency = true, false, false, false, 1
		p.Size = Vector3.new(1, 1, 1)
		p.CFrame = CFrame.new(pos)
		p.Parent = workspace
		s.RollOffMinDistance, s.RollOffMaxDistance = 14, 160
		s.Parent = p
		holder = p
	else
		s.Parent = SoundService
	end
	s:Play()
	if def.stopAfter then
		task.delay(def.stopAfter, function()
			if s.Parent then
				s:Stop()
			end
		end)
	end
	Debris:AddItem(holder, math.max(def.stopAfter or 0, 6))
end

-- ---------- the metal gates ----------
local function hookGate(base)
	local shutter, bar = base:WaitForChild("Shutter", 10), base:WaitForChild("ShutterBar", 10)
	if not (shutter and bar) then
		return
	end
	local top = shutter.CFrame * CFrame.new(0, shutter.Size.Y / 2, 0) -- built rolled up: its top edge is the housing
	local full = shutter:GetAttribute("Full") or 12
	local sx, sz = shutter.Size.X, shutter.Size.Z
	local amount = Instance.new("NumberValue") -- 0 = rolled up, 1 = all the way down
	local function draw()
		local h = 0.2 + (full - 0.2) * amount.Value
		shutter.Size = Vector3.new(sx, h, sz)
		shutter.CFrame = top * CFrame.new(0, -h / 2, 0)
		bar.CFrame = top * CFrame.new(0, -h - 0.25, 0)
	end
	amount.Changed:Connect(draw)
	local down = false
	local function update(instant)
		local want = (base:GetAttribute("ShieldUntil") or 0) > workspace:GetServerTimeNow()
		if want == down then
			return
		end
		down = want
		if instant then
			amount.Value = want and 1 or 0
			return
		end
		local tw = TweenService:Create(amount, TweenInfo.new(want and 0.8 or 1.1, want and Enum.EasingStyle.Bounce or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = want and 1 or 0 })
		tw:Play()
		if want then
			task.delay(0.45, function()
				sfx("gate", bar.Position)
			end)
		end
	end
	base:GetAttributeChangedSignal("ShieldUntil"):Connect(function()
		update(false)
	end)
	update(true)
end
for _, m in ipairs(station:GetChildren()) do
	if m:IsA("Model") and m:GetAttribute("BaseIndex") then
		task.spawn(hookGate, m)
	end
end

-- ---------- disco balls: spin and throw coloured light while the base's party is on ----------
local PARTY = { Color3.fromRGB(255, 90, 160), Color3.fromRGB(90, 200, 255), Color3.fromRGB(255, 220, 90), Color3.fromRGB(140, 255, 140), Color3.fromRGB(190, 120, 255) }
local clock = 0
-- lag on the iPad (2026-10-25): the bases and their disco balls are looked up twice a second, not searched for every frame,
-- and a ball that is off is left alone instead of having its lights rewritten each frame
local bases, balls, lookedAt = {}, {}, -1
local function findBalls()
	table.clear(bases)
	for _, m in ipairs(station:GetChildren()) do
		if m:IsA("Model") and m:GetAttribute("BaseIndex") then
			local f = m:FindFirstChild("Furniture")
			local ball = f and f:FindFirstChild("DiscoBall", true)
			if ball then
				table.insert(bases, m)
				balls[m] = ball
			end
		end
	end
end
local wasOn = {} -- [ball] = true while its party lights are on
RunService.RenderStepped:Connect(function(dt)
	clock += dt
	if clock - lookedAt > 0.5 then
		lookedAt = clock
		findBalls()
	end
	for _, m in ipairs(bases) do
		local ball = balls[m]
		if ball and ball.Parent then
			local on = m:GetAttribute("Disco") == true
			if on then
				ball.CFrame = ball.CFrame * CFrame.Angles(0, dt * 1.5, 0)
			end
			if on or wasOn[ball] then
				wasOn[ball] = on or nil
				for i, l in ipairs(ball:GetChildren()) do
					if l:IsA("SpotLight") then
						l.Brightness = on and 4 or 0
						l.Color = PARTY[(math.floor(clock * 2) + i) % #PARTY + 1]
					end
				end
			end
		end
	end
end)

-- ---------- trampolines: land on one and you fly ----------
local lastBounce = 0
local function hookTrampoline(p)
	if not (p:IsA("BasePart") and p:GetAttribute("Bounce")) then
		return
	end
	p.Touched:Connect(function(hit)
		local ch = player.Character
		local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
		if not (hrp and hit:IsDescendantOf(ch)) or os.clock() - lastBounce < 0.4 then
			return
		end
		lastBounce = os.clock()
		local v = hrp.AssemblyLinearVelocity
		hrp.AssemblyLinearVelocity = Vector3.new(v.X, p:GetAttribute("Bounce"), v.Z)
		sfx("bounce", p.Position)
	end)
end
for _, d in ipairs(station:GetDescendants()) do
	hookTrampoline(d)
end
station.DescendantAdded:Connect(hookTrampoline)

-- ---------- more stars over the open roof, gently twinkling ----------
local skyFolder = Instance.new("Folder")
skyFolder.Name = "LocalSky"
skyFolder.Parent = workspace
local rng = Random.new(7)
local twinkle = {}
for i = 1, 140 do
	local dir = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(0.35, 1), rng:NextNumber(-1, 1)).Unit
	local s = Instance.new("Part")
	s.Name = "SkyStar"
	s.Shape = Enum.PartType.Ball
	local size = rng:NextNumber(1.2, 3.2)
	s.Size = Vector3.new(size, size, size)
	s.Material = Enum.Material.Neon
	s.Color = (i % 5 == 0) and Color3.fromRGB(255, 220, 180) or ((i % 7 == 0) and Color3.fromRGB(180, 220, 255) or Color3.fromRGB(255, 255, 255))
	s.Anchored, s.CanCollide, s.CanQuery, s.CanTouch, s.CastShadow = true, false, false, false, false
	s.CFrame = CFrame.new(dir * rng:NextNumber(650, 900))
	s.Parent = skyFolder
	table.insert(twinkle, { part = s, phase = rng:NextNumber(0, 6.28), speed = rng:NextNumber(0.8, 2.2) })
end
local lastTwinkle = 0
RunService.Heartbeat:Connect(function()
	local t = os.clock()
	if t - lastTwinkle < 0.1 then -- 10 times a second is plenty for a slow twinkle (2026-10-25, lag on the iPad)
		return
	end
	lastTwinkle = t
	for i = 1, #twinkle, 2 do -- half of them twinkle
		local tw = twinkle[i]
		tw.part.Transparency = 0.15 + 0.55 * (0.5 + 0.5 * math.sin(t * tw.speed + tw.phase))
	end
end)

-- ---------- a comet across the sky every couple of minutes ----------
local function comet()
	local angle = rng:NextNumber(0, math.pi * 2)
	local from = Vector3.new(math.cos(angle) * 900, rng:NextNumber(200, 320), math.sin(angle) * 900)
	local to = Vector3.new(-math.cos(angle) * 900, rng:NextNumber(160, 280), -math.sin(angle) * 900) + Vector3.new(rng:NextNumber(-200, 200), 0, rng:NextNumber(-200, 200))
	local head = Instance.new("Part")
	head.Name = "Comet"
	head.Shape = Enum.PartType.Ball
	head.Size = Vector3.new(9, 9, 9)
	head.Material = Enum.Material.Neon
	head.Color = Color3.fromRGB(200, 235, 255)
	head.Anchored, head.CanCollide, head.CanQuery, head.CanTouch, head.CastShadow = true, false, false, false, false
	head.CFrame = CFrame.lookAt(from, to)
	head.Parent = skyFolder
	local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
	a0.Position, a1.Position = Vector3.new(0, 4, 0), Vector3.new(0, -4, 0)
	a0.Parent, a1.Parent = head, head
	local trail = Instance.new("Trail")
	trail.Attachment0, trail.Attachment1 = a0, a1
	trail.Lifetime = 3
	trail.LightEmission = 1
	trail.FaceCamera = true
	trail.Color = ColorSequence.new(Color3.fromRGB(220, 240, 255), Color3.fromRGB(150, 200, 255))
	trail.Transparency = NumberSequence.new(0.1, 1)
	trail.WidthScale = NumberSequence.new(1, 0)
	trail.Parent = head
	local sparks = Instance.new("ParticleEmitter")
	sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparks.Color = ColorSequence.new(Color3.fromRGB(255, 230, 180))
	sparks.LightEmission = 1
	sparks.Size = NumberSequence.new(2, 0)
	sparks.Lifetime = NumberRange.new(1, 2)
	sparks.Rate = 40
	sparks.Speed = NumberRange.new(2, 6)
	sparks.Parent = head
	sfx("comet")
	local secs = 16
	local tw = TweenService:Create(head, TweenInfo.new(secs, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(to, to + (to - from)) })
	tw:Play()
	tw.Completed:Connect(function()
		head:Destroy()
	end)
end
task.spawn(function()
	task.wait(rng:NextNumber(25, 50))
	while true do
		comet()
		task.wait(rng:NextNumber(Config.CometEvery[1], Config.CometEvery[2]))
	end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>