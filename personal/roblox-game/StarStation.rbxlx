-- ---------- rubber ducks: the count, and found ones vanish from your screen ----------
local foundSet = {}
local duckModels = {} -- [model] = true
local function duckLook(m)
	local id = m:GetAttribute("DuckId")
	local found = id and foundSet[id] or false
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.LocalTransparencyModifier = found and 1 or 0
		elseif d:IsA("ProximityPrompt") then
			d.MaxActivationDistance = found and 0 or 8
		end
	end
end
local function refreshDucks()
	table.clear(foundSet)
	for id in string.gmatch(player:GetAttribute("DucksFound") or "", "[^,]+") do
		foundSet[id] = true
	end
	duckL.Text = "Ducks: " .. (player:GetAttribute("DuckCount") or 0) .. " / " .. (player:GetAttribute("DuckTotal") or #L.Ducks)
	for m in pairs(duckModels) do
		if m.Parent then
			duckLook(m)
		else
			duckModels[m] = nil
		end
	end
end
local function trackDuck(m)
	if m:IsA("Model") and m:GetAttribute("DuckId") then
		duckModels[m] = true
		task.defer(duckLook, m)
	end
end
try("ducks", function()
	local df = park:WaitForChild("Ducks", 20)
	if df then
		for _, m in ipairs(df:GetChildren()) do
			trackDuck(m)
		end
		df.ChildAdded:Connect(trackDuck)
	end
end)
player:GetAttributeChangedSignal("DucksFound"):Connect(refreshDucks)
player:GetAttributeChangedSignal("DuckCount"):Connect(refreshDucks)
refreshDucks()

-- ---------- finding things in the park by name (they may arrive a little after the park folder) ----------
local function whenPart(name, fn)
	local found = park:FindFirstChild(name, true)
	if found then
		task.spawn(try, name, fn, found)
		return
	end
	local conn
	conn = park.DescendantAdded:Connect(function(d)
		if d.Name == name then
			conn:Disconnect()
			task.spawn(try, name, fn, d)
		end
	end)
end

local function prompt(parent, action, object, reach)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = action
	pp.ObjectText = object
	pp.HoldDuration = 0
	pp.MaxActivationDistance = reach or 10
	pp.RequiresLineOfSight = false
	pp.Parent = parent
	return pp
end

-- ---------- the slides ----------
-- Press Ride on the pad at the bottom (E, or tap it): you're lifted to the top, sat down, and your own screen carries you along the
-- slide's points at its speed, then drops you into the splash pool with a splash. Nothing is left to physics on the way down, the
-- ride always ends (it has a time limit too), and anything odd (you reset, you leave the park, an error) ends it straight away.
local riding = nil
local UP = Vector3.new(0, 2.4, 0) -- the seat of your pants sits this far above the slide's floor

local function endRide(r, intoPool)
	if riding ~= r then
		return
	end
	riding = nil
	if r.conn then
		r.conn:Disconnect()
	end
	try("ending a ride", function()
		r.hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
		r.hum.Sit = false
		if intoPool and r.hrp.Parent then
			local at = r.slide.splash
			r.hrp.CFrame = CFrame.lookAt(at, at + r.flat)
			r.hrp.AssemblyLinearVelocity = r.flat * 18 + Vector3.new(0, -6, 0)
		end
	end)
	if intoPool then
		local at = r.slide.splash + Vector3.new(0, 2, 0)
		splash(at, 2)
		sfx("splash", at)
		pop(at + Vector3.new(0, 3, 0), "SPLASH!", AQUA)
		Park:FireServer("splash", at, 2)
		if r.slide.countdown then
			shout(string.format("%.1f seconds!", os.clock() - r.started), SUN, 2)
		end
	end
end

local function ride(slide)
	if riding or not here() then
		return
	end
	local ch, hum, hrp = char()
	if not (ch and hum and hrp) or hum.Health <= 0 or hum.SeatPart then
		return
	end
	local pts = slide.points
	if #pts < 2 then
		return
	end
	local cum = { 0 }
	for i = 2, #pts do
		cum[i] = cum[i - 1] + (pts[i] - pts[i - 1]).Magnitude
	end
	local total = cum[#pts]
	local last = pts[#pts] - pts[#pts - 1]
	local flat = Vector3.new(last.X, 0, last.Z)
	flat = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(0, 0, -1)
	local r = { slide = slide, hum = hum, hrp = hrp, ch = ch, flat = flat, started = os.clock(), moving = false, conn = nil }
	riding = r
	pcall(function()
		hum:UnequipTools()
	end)
	hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	hum.Sit = true
	local startDir = (pts[2] - pts[1]).Unit
	local hold = slide.countdown and 1.8 or 0.5
	local t0 = os.clock()
	local dist, seg, y = 0, 1, pts[1].Y
	local topY = pts[1].Y
	local maxTime = hold + total / slide.base + 3
	local lastPlaced = pts[1] + UP
	local counted = 0
	local function place(pos, dir)
		lastPlaced = pos + UP
		hrp.CFrame = CFrame.lookAt(lastPlaced, lastPlaced + dir)
	end
	place(pts[1], startDir)
	r.conn = RunService.RenderStepped:Connect(function(dt)
		local ok, err = pcall(function()
			if riding ~= r then
				return
			end
			if not (ch.Parent and hrp.Parent and hum.Health > 0) or not here() then
				endRide(r, false)
				return
			end
			if (hrp.Position - lastPlaced).Magnitude > 30 then -- something moved you (a switch of games): stop, leave you there
				endRide(r, false)
				return
			end
			if not hum.Sit then
				hum.Sit = true
			end
			local el = os.clock() - t0
			if el < hold then -- a moment at the top (3, 2, 1 on the racer)
				place(pts[1], startDir)
				hrp.AssemblyLinearVelocity = Vector3.zero
				if slide.countdown then
					local n = 3 - math.floor(el / 0.6)
					if n ~= counted and n >= 1 then
						counted = n
						shout(tostring(n), SUN, 0.5)
					end
				end
				return
			end
			if not r.moving then
				r.moving = true
				r.started = os.clock()
				if slide.countdown then
					shout("GO!", Color3.fromRGB(120, 255, 150), 0.8)
				end
				sfx("slide")
			end
			dt = math.min(dt, 0.1)
			local speed = slide.base + slide.gain * math.sqrt(math.max(0, topY - y))
			dist += speed * dt
			if dist >= total or el > maxTime then
				endRide(r, true)
				return
			end
			while seg < #pts - 1 and cum[seg + 1] < dist do
				seg += 1
			end
			local a, b = pts[seg], pts[seg + 1]
			local f = math.clamp((dist - cum[seg]) / math.max(0.001, cum[seg + 1] - cum[seg]), 0, 1)
			local pos = a:Lerp(b, f)
			local dir = (b - a).Unit
			y = pos.Y
			place(pos, dir)
			hrp.AssemblyLinearVelocity = dir * speed
		end)
		if not ok then
			warn("[Splash Lagoon] ride: " .. tostring(err))
			endRide(r, true)
		end
	end)
end

for _, s in ipairs(L.Slides) do
	whenPart("RidePad_" .. s.id, function(pad)
		local pp = prompt(pad, "Ride!", s.name, 9)
		pp.Triggered:Connect(function()
			ride(s)
		end)
	end)
end

-- ---------- the cannonball tower, the springboard, and cannonballs ----------
whenPart("ClimbPad", function(pad)
	local pp = prompt(pad, "Climb up", "Cannonball Tower", 9)
	pp.Triggered:Connect(function()
		local _, hum, hrp = char()
		if hrp and hum and not riding and here() and not hum.SeatPart then
			hrp.CFrame = L.Cannonball.stand
			hrp.AssemblyLinearVelocity = Vector3.zero
			shout("Walk off the board!", SUN, 2, "Jump in for a CANNONBALL!")
		end
	end)
end)

local lastBounce = 0
whenPart("Springboard", function(board)
	board.Touched:Connect(function(hit)
		local ch, _, hrp = char()
		if not (ch and hrp and hit:IsDescendantOf(ch)) or riding or os.clock() - lastBounce < 0.6 then
			return
		end
		lastBounce = os.clock()
		hrp.AssemblyLinearVelocity = Vector3.new(board:GetAttribute("Push") or 14, board:GetAttribute("Bounce") or 70, 0)
		sfx("bounce", board.Position)
	end)
end)

-- a big jump into the water makes a big splash
local fallFrom = nil
local function hookFalls(ch)
	local hum = ch:WaitForChild("Humanoid", 10)
	if not hum then
		return
	end
	hum.StateChanged:Connect(function(_, new)
		local hrp = ch:FindFirstChild("HumanoidRootPart")
		if not (hrp and here()) or riding then
			fallFrom = nil
			return
		end
		if new == Enum.HumanoidStateType.Freefall then
			fallFrom = hrp.Position.Y
		elseif new == Enum.HumanoidStateType.Swimming then
			local h = fallFrom and (fallFrom - L.Origin.Y) or 0
			fallFrom = nil
			if h >= 9 and L.inAnyWater(hrp.Position) then
				local size = math.clamp(h / 9, 1, 3)
				local at = Vector3.new(hrp.Position.X, L.Origin.Y + 0.5, hrp.Position.Z)
				splash(at, size)
				sfx("splash", at)
				shout(h >= 18 and "MEGA CANNONBALL!" or "CANNONBALL!", AQUA, 1.6)
				Park:FireServer("splash", at, size)
			end
		elseif new == Enum.HumanoidStateType.Landed or new == Enum.HumanoidStateType.Running then
			fallFrom = nil
		end
	end)
end
player.CharacterAdded:Connect(function(ch)
	if riding then -- reset mid-ride: tidy the old ride away
		endRide(riding, false)
	end
	fallFrom = nil
	hookFalls(ch)
end)
if player.Character then
	task.spawn(hookFalls, player.Character)
end

-- ---------- the lazy river's current and the wave pool's waves (only your own character) ----------
local pushedWave = nil
RunService.Heartbeat:Connect(function(dt)
	if not here() or riding then
		return
	end
	local _, hum, hrp = char()
	if not (hum and hrp) or hum.SeatPart then
		return
	end
	dt = math.min(dt, 0.1)
	local pos = hrp.Position
	if L.inRiver(pos) then
		-- carried along: a steady nudge downstream each frame, so you drift round the loop even if you stop swimming
		hrp.CFrame = hrp.CFrame + L.riverFlow(pos) * (L.River.speed * dt)
	elseif L.inWavePool(pos) then
		local t = workspace:GetServerTimeNow()
		local gw = park:GetAttribute("GiantWaveAt") or -1000
		local giant = t - gw < L.WaveTravel
		local crest, id
		if giant then
			crest = L.WavePool.x2 - (L.WavePool.x2 - L.WavePool.x1) * ((t - gw) / L.WaveTravel)
			id = "g" .. tostring(gw)
		else
			crest = L.waveCrestX(t)
			id = "w" .. math.floor(t / L.WaveEvery)
		end
		local lx = pos.X - L.Origin.X
		if crest and math.abs(lx - crest) < 7 then
			-- ride the wave toward the beach while it passes you, with a bob up as it arrives
			hrp.CFrame = hrp.CFrame + Vector3.new(-(giant and 22 or 9) * dt, 0, 0)
			if pushedWave ~= id then
				pushedWave = id
				local v = hrp.AssemblyLinearVelocity
				hrp.AssemblyLinearVelocity = Vector3.new(v.X - (giant and 20 or 8), giant and 26 or 12, v.Z)
			end
		end
	end
end)

-- ---------- what moves on your screen: the wave crest, rings in the river, floats, spinning tokens, the floating duck ----------
local visualOk = try("park visuals", function()
	local crestPart = Instance.new("Part")
	crestPart.Name = "WaveCrest"
	crestPart.Anchored, crestPart.CanCollide, crestPart.CanQuery, crestPart.CanTouch, crestPart.CastShadow = true, false, false, false, false
	crestPart.Material = Enum.Material.SmoothPlastic
	crestPart.Color = Color3.fromRGB(235, 250, 255)
	crestPart.Transparency = 1
	crestPart.Size = Vector3.new(3, 1.2, (L.WavePool.z2 - L.WavePool.z1) - 4)
	crestPart.Parent = fx
	local midZ = (L.WavePool.z1 + L.WavePool.z2) / 2

	local function ring(color, dia)
		local p = Instance.new("Part")
		p.Name = "Float"
		p.Shape = Enum.PartType.Cylinder
		p.Size = Vector3.new(0.9, dia, dia)
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
		p.Color = color
		p.Parent = fx
		return p
	end
	local colors = { CORAL, SUN, AQUA, Color3.fromRGB(150, 110, 240), Color3.fromRGB(110, 220, 140), Color3.fromRGB(255, 150, 200) }
	local loop = L.riverLoop()
	local legs, perim = {}, 0
	for i = 1, #loop do
		local a, b = loop[i], loop[i % #loop + 1]
		table.insert(legs, { a = a, b = b, len = (b - a).Magnitude, start = perim })
		perim += (b - a).Magnitude
	end
	local function onLoop(d)
		d = d % perim
		for _, leg in ipairs(legs) do
			if d <= leg.start + leg.len then
				return leg.a:Lerp(leg.b, (d - leg.start) / leg.len)
			end
		end
		return loop[1]
	end
	local tubes = {}
	for i = 1, 6 do
		table.insert(tubes, { part = ring(colors[i], 5), off = perim * (i - 1) / 6 })
	end
	local floats = {}
	local frng = Random.new(5)
	for i = 1, 5 do
		local x = frng:NextNumber(L.WavePool.x1 + 16, L.WavePool.x2 - 10)
		local z = frng:NextNumber(L.WavePool.z1 + 10, L.WavePool.z2 - 10)
		table.insert(floats, { part = ring(colors[i + 1], 4.5), x = x, z = z, phase = i * 1.3 })
	end
	local spinning = {} -- [token] = its home position
	local floater = nil
	local acc, clock = 0, 0
	local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))
	RunService.RenderStepped:Connect(function(dt)
		if not here() then
			if crestPart.Transparency < 1 then
				crestPart.Transparency = 1
			end
			return
		end
		clock += dt
		acc += dt
		if acc < 1 / 30 then -- 30 times a second is smooth enough and kinder to an iPad
			return
		end
		acc = 0
		local t = workspace:GetServerTimeNow()
		-- the wave
		local gw = park:GetAttribute("GiantWaveAt") or -1000
		local giant = t - gw < L.WaveTravel
		local crest = giant and (L.WavePool.x2 - (L.WavePool.x2 - L.WavePool.x1) * ((t - gw) / L.WaveTravel)) or L.waveCrestX(t)
		if crest then
			local h = giant and 3.5 or 1.2
			crestPart.Size = Vector3.new(giant and 5 or 3, h, crestPart.Size.Z)
			crestPart.CFrame = CFrame.new(L.at(crest, h / 2 - 0.3, midZ))
			crestPart.Transparency = 0.35
		else
			crestPart.Transparency = 1
		end
		-- rings drifting round the lazy river
		for _, tb in ipairs(tubes) do
			local pos = onLoop(tb.off + clock * L.River.speed)
			tb.part.CFrame = CFrame.new(pos + Vector3.new(0, 0.25 + math.sin(clock * 2 + tb.off) * 0.12, 0)) * CFrame.Angles(0, clock * 0.4 + tb.off, 0) * UPRIGHT
		end
		-- floats bobbing on the wave pool, lifted as a wave goes under
		for _, fl in ipairs(floats) do
			local lift = (crest and math.abs(fl.x - crest) < 8) and (giant and 2.5 or 0.9) or 0
			fl.part.CFrame = CFrame.new(L.at(fl.x, 0.25 + math.sin(clock * 1.5 + fl.phase) * 0.2 + lift, fl.z)) * UPRIGHT
		end
		-- tokens spin, bubbles bob
		local tokens = park:FindFirstChild("Tokens")
		if tokens then
			for _, p in ipairs(tokens:GetChildren()) do
				if p:IsA("BasePart") then
					local home = spinning[p]
					if not home then
						home = p.Position
						spinning[p] = home
					end
					if p.Name == "Bubble" then
						p.CFrame = CFrame.new(home + Vector3.new(0, math.sin(clock * 2 + home.X) * 0.6, 0))
					else
						p.CFrame = CFrame.new(home + Vector3.new(0, math.sin(clock * 3 + home.Z) * 0.3, 0)) * CFrame.Angles(0, clock * 2.5 + home.X, 0)
					end
				end
			end
			for p in pairs(spinning) do
				if not p.Parent then
					spinning[p] = nil
				end
			end
		end
		-- the duck floating in the river bobs
		if not floater then
			local df = park:FindFirstChild("Ducks")
			for _, m in ipairs(df and df:GetChildren() or {}) do
				if m:IsA("Model") and m:GetAttribute("Floats") then
					floater = { model = m, home = m:GetPivot() }
				end
			end
		end
		if floater and floater.model.Parent then
			floater.model:PivotTo(floater.home * CFrame.new(0, math.sin(clock * 1.8) * 0.15, 0) * CFrame.Angles(0, 0, math.sin(clock * 1.3) * 0.08))
		end
	end)
end)
if not visualOk then
	warn("[Splash Lagoon] park visuals are off")
end

-- ---------- Splash Tokens: your screen grabs one the moment you touch it, and the server checks and pays ----------
local claimed = {} -- [token] = os.clock() when we grabbed it
task.spawn(function()
	while true do
		task.wait(0.1)
		if here() then
			try("tokens", function()
				local _, _, hrp = char()
				local tokens = park:FindFirstChild("Tokens")
				if not (hrp and tokens) then
					return
				end
				local now0 = os.clock()
				for _, p in ipairs(tokens:GetChildren()) do
					local c = claimed[p]
					if c then
						if now0 - c > 2 and p.Parent then -- someone else got it first: show it again
							claimed[p] = nil
							p.LocalTransparencyModifier = 0
						end
					elseif p:IsA("BasePart") and p:GetAttribute("Ready") and (p.Position - hrp.Position).Magnitude <= P.tokenPickup then
						claimed[p] = now0
						p.LocalTransparencyModifier = 1
						splash(p.Position, 0.5)
						sfx("token", p.Position)
						Park:FireServer("token", p)
					end
				end
				for p in pairs(claimed) do
					if not p.Parent then
						claimed[p] = nil
					end
				end
			end)
		end
	end
end)

-- ---------- the big bucket: a countdown on its sign, and every so often it tips ----------
local bucketTip
try("bucket", function()
	local tower = park:WaitForChild("SplashPad", 20)
	tower = tower and tower:WaitForChild("BucketTower", 10)
	local bucket = tower and tower:WaitForChild("Bucket", 10)
	if not (bucket and bucket.PrimaryPart) then
		return
	end
	local home = bucket:GetPivot()
	local angle = Instance.new("NumberValue")
	angle.Changed:Connect(function(a)
		bucket:PivotTo(home * CFrame.Angles(math.rad(a), 0, 0))
	end)
	local labels = {}
	for _, d in ipairs(tower:GetDescendants()) do
		if d:IsA("TextLabel") and d.Name == "BucketTimer" then
			table.insert(labels, d)
		end
	end
	local B = L.Bucket
	local ground = L.at(B.x, 0.5, B.z)
	local warned = false
	task.spawn(function()
		while true do
			task.wait(0.25)
			if here() then
				local left = math.ceil((park:GetAttribute("BucketNext") or 0) - workspace:GetServerTimeNow())
				local text = left > 0 and ("Bucket tips in " .. left .. "s") or "SPLASH!"
				for _, l in ipairs(labels) do
					l.Text = text
				end
				local _, _, hrp = char()
				local near = hrp and (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(ground.X, 0, ground.Z)).Magnitude < 40
				if left == 3 and near and not warned then
					warned = true
					shout("The bucket is tipping!", SUN, 1.5, "Stand under it to get SOAKED!")
				elseif left > 3 then
					warned = false
				end
			end
		end
	end)
	bucketTip = function()
		TweenService:Create(angle, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Value = 115 }):Play()
		task.delay(0.7, function()
			-- the water comes down: a big splash on the pad and spray off the bucket's lip
			splash(ground, 3)
			splash(ground + Vector3.new(0, B.height * 0.6, 0), 2)
			sfx("splash", ground)
			sfx("bucket", ground)
			local _, _, hrp = char()
			if hrp then
				local flatD = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(ground.X, 0, ground.Z)).Magnitude
				if flatD <= B.soakRadius and hrp.Position.Y - L.Origin.Y < 20 then
					blueFlash(0.5)
					shout("SOAKED!", AQUA, 1.6, "The big bucket got you!")
				end
			end
		end)
		task.delay(2.3, function()
			TweenService:Create(angle, TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Value = 0 }):Play()
		end)
	end
end)

-- ---------- the water blaster: a spray of water, a splash, and SOAKED! on whoever it hits ----------
local lastSpray = 0
local function sprayFrom(fromPos, toPos)
	local drops = {}
	for k = 1, 6 do
		local d = Instance.new("Part")
		d.Name = "Droplet"
		d.Shape = Enum.PartType.Ball
		d.Size = Vector3.new(0.7, 0.7, 0.7)
		d.Color = Color3.fromRGB(110, 200, 255)
		d.Material = Enum.Material.SmoothPlastic
		d.Transparency = 0.2
		d.Anchored, d.CanCollide, d.CanQuery, d.CanTouch, d.CastShadow = true, false, false, false, false
		d.CFrame = CFrame.new(fromPos)
		d.Parent = fx
		drops[k] = d
	end
	local t0 = os.clock()
	local flight = 0.4
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local el = os.clock() - t0
		local done = true
		for k, d in ipairs(drops) do
			local a = math.clamp((el - (k - 1) * 0.04) / flight, 0, 1)
			if a < 1 then
				done = false
			end
			d.CFrame = CFrame.new(fromPos:Lerp(toPos, a) + Vector3.new(0, 4 * a * (1 - a) * 2.5, 0))
		end
		if done then
			conn:Disconnect()
			for _, d in ipairs(drops) do
				d:Destroy()
			end
			splash(toPos, 0.7)
		end
	end)
end
local function spray()
	if not here() or riding or os.clock() - lastSpray < P.soakCooldown then
		return
	end
	local _, _, hrp = char()
	if not hrp then
		return
	end
	lastSpray = os.clock()
	local look = hrp.CFrame.LookVector
	local from = hrp.Position + look * 2 + Vector3.new(0, 1, 0)
	local to = hrp.Position + look * (P.soakRange * 0.8) + Vector3.new(0, -2, 0)
	sprayFrom(from, to)
	Park:FireServer("soak")
end
splashBtn.Activated:Connect(spray)
UIS.InputBegan:Connect(function(input, typing)
	if typing or not here() then
		return
	end
	if input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.ButtonX or input.UserInputType == Enum.UserInputType.MouseButton1 then
		spray()
	end
end)

-- ---------- news from the server ----------
Park.OnClientEvent:Connect(function(kind, a, b, c)
	if kind == "stopride" then
		if riding then
			endRide(riding, false)
		end
		return
	end
	if not here() then
		return
	end
	try("park event " .. tostring(kind), function()
		if kind == "pop" then
			pop(a, b, SUN)
		elseif kind == "poof" then
			splash(a, b and 0.8 or 0.5)
		elseif kind == "splash" then
			splash(a, b)
			sfx("splash", a)
		elseif kind == "spray" then
			local hrp = a and a.Character and a.Character:FindFirstChild("HumanoidRootPart")
			if hrp and typeof(b) == "Vector3" then
				sprayFrom(hrp.Position + hrp.CFrame.LookVector * 2 + Vector3.new(0, 1, 0), b)
			end
		elseif kind == "soaked" then
			blueFlash(0.45)
			shout("SOAKED!", AQUA, 1.4, tostring(a) .. " got you!")
			local _, _, hrp = char()
			if hrp then -- drips for a couple of seconds
				local e = Instance.new("ParticleEmitter")
				e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
				e.Color = ColorSequence.new(Color3.fromRGB(150, 220, 255))
				e.Size = NumberSequence.new(0.4, 0.2)
				e.Lifetime = NumberRange.new(0.4, 0.7)
				e.Rate = 18
				e.Speed = NumberRange.new(1, 3)
				e.Acceleration = Vector3.new(0, -30, 0)
				e.SpreadAngle = Vector2.new(60, 60)
				e.Parent = hrp
				Debris:AddItem(e, 2)
			end
		elseif kind == "soakhit" then
			local head = a and a.Character and a.Character:FindFirstChild("Head")
			if head then
				pop(head.Position + Vector3.new(0, 2, 0), "SOAKED!", AQUA)
			end
		elseif kind == "bucket" then
			if bucketTip then
				bucketTip()
			end
		elseif kind == "duck" then
			splash(a, 0.8)
			pop(a + Vector3.new(0, 2, 0), "QUACK!", SUN)
			shout("Rubber duck " .. tostring(b) .. " of " .. tostring(c) .. "!", SUN, 2)
		elseif kind == "giantwave" then
			shout("GIANT WAVE!", AQUA, 2.5, "Captain's orders!")
			sfx("wave")
		elseif kind == "bubbles" then
			shout("BUBBLE PARTY!", Color3.fromRGB(190, 230, 255), 2.5, "Pop the bubbles for Stardust!")
			local _, _, hrp = char()
			if hrp then
				local e = Instance.new("ParticleEmitter")
				e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
				e.Color = ColorSequence.new(Color3.fromRGB(190, 235, 255), Color3.fromRGB(255, 200, 240))
				e.Size = NumberSequence.new(0.8, 1.4)
				e.Transparency = NumberSequence.new(0.3, 1)
				e.Lifetime = NumberRange.new(2, 3)
				e.Rate = 6
				e.Speed = NumberRange.new(1, 3)
				e.Acceleration = Vector3.new(0, 2, 0)
				e.SpreadAngle = Vector2.new(180, 180)
				e.Parent = hrp
				Debris:AddItem(e, tonumber(a) or 20)
			end
		end
	end)
end)

-- ---------- coming and going ----------
local function onZone()
	local inside = here()
	gui.Enabled = inside
	if inside then
		local _, hum = char()
		if hum then
			pcall(function()
				hum:UnequipTools() -- the station's weapons stay in the backpack here
			end)
		end
		refreshDucks()
		shout(L.Name, AQUA, 2.5, "Ride the slides and find the rubber ducks!")
	elseif riding then
		endRide(riding, false)
	end
end
player:GetAttributeChangedSignal("Zone"):Connect(onZone)
onZone()
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="24">
          <Properties>
            <string name="Name">ParkWorld</string>
            <string name="Source"><![CDATA[-- Splash Lagoon's sky on this player's screen (2026-11-07). Roblox has one Lighting and one gravity for the whole server, and the
-- station's events change them (Black Hole Night goes purple, Low Gravity floats everyone, the Captain changes the lights). So while
-- you're in the park, your own screen paints a bright sunny day with a little haze, and keeps your gravity normal: your character's
-- falling is worked out on your own device, so the station's low gravity never reaches you. Leaving the park puts the station's look
-- back, read from the attributes the server keeps on Lighting.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Config = require(ReplicatedStorage.Shared.Config)
local player = Players.LocalPlayer

local WHITE = Color3.new(1, 1, 1)
local PARK = {
	ClockTime = 14,
	Brightness = 2,
	Ambient = Color3.fromRGB(150, 150, 158),
	OutdoorAmbient = Color3.fromRGB(160, 170, 186),
	FogColor = Color3.fromRGB(200, 232, 255),
	FogStart = 250,
	FogEnd = 1100, -- the station is 4,000 studs away: well inside the haze
	ExposureCompensation = 0,
}
local SKY = { StarCount = 0, CelestialBodiesShown = true }

local here = false
local applying = false -- set while this script changes things, so its own change doesn't call it again
local saved = nil -- the station's values for the things the server never changes after it starts

local function cc()
	return Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
end
local function sky()
	return Lighting:FindFirstChildOfClass("Sky")
end
local function normalGravity()
	return workspace:GetAttribute("NormalGravity") or 196.2
end

local function set(obj, prop, value)
	if obj and obj[prop] ~= value then
		obj[prop] = value
	end
end

local function applyPark()
	applying = true
	local ok, err = pcall(function()
		for k, v in pairs(PARK) do
			set(Lighting, k, v)
		end
		set(cc(), "TintColor", WHITE)
		local s = sky()
		if s then
			for k, v in pairs(SKY) do
				set(s, k, v)
			end
		end
		set(workspace, "Gravity", normalGravity())
	end)
	applying = false
	if not ok then
		warn("[Splash Lagoon] park sky: " .. tostring(err))
	end
end

local function restore()
	if not saved then
		return
	end
	applying = true
	local ok, err = pcall(function()
		for k in pairs(PARK) do
			if saved[k] ~= nil then
				Lighting[k] = saved[k]
			end
		end
		-- the server changes these during the station's events: put back what they are now, not what they were when we left
		Lighting.Ambient = Lighting:GetAttribute("StAmbient") or saved.Ambient
		Lighting.OutdoorAmbient = Lighting:GetAttribute("StOutdoor") or saved.OutdoorAmbient
		Lighting.Brightness = Lighting:GetAttribute("StBrightness") or saved.Brightness
		local c = cc()
		if c then
			c.TintColor = Lighting:GetAttribute("StTint") or WHITE
		end
		local s = sky()
		if s and saved.sky then
			for k, v in pairs(saved.sky) do
				s[k] = v
			end
		end
		local low = (workspace:GetAttribute("LowGravityUntil") or 0) > workspace:GetServerTimeNow()
		workspace.Gravity = low and Config.LowGravityValue or normalGravity()
	end)
	applying = false
	if not ok then
		warn("[Splash Lagoon] putting the station sky back: " .. tostring(err))
	end
end

local function snapshot()
	saved = {}
	for k in pairs(PARK) do
		saved[k] = Lighting[k]
	end
	local s = sky()
	if s then
		saved.sky = {}
		for k in pairs(SKY) do
			saved.sky[k] = s[k]
		end
	end
end

local function update()
	local want = player:GetAttribute("Zone") == "park"
	if want == here then
		return
	end
	here = want
	if here then
		if not saved then
			snapshot()
		end
		applyPark()
	else
		restore()
	end
end
player:GetAttributeChangedSignal("Zone"):Connect(update)
update()

-- the server's own changes (a Black Hole Night starting, low gravity) arrive here too: paint the park's back over them straight away
Lighting.Changed:Connect(function(prop)
	if here and not applying and PARK[prop] ~= nil then
		applyPark()
	end
end)
workspace:GetPropertyChangedSignal("Gravity"):Connect(function()
	if here and not applying then
		applyPark()
	end
end)
local function watchCC(c)
	if c:IsA("ColorCorrectionEffect") then
		c:GetPropertyChangedSignal("TintColor"):Connect(function()
			if here and not applying then
				applyPark()
			end
		end)
	end
end
for _, c in ipairs(Lighting:GetChildren()) do
	watchCC(c)
end
Lighting.ChildAdded:Connect(watchCC)

-- and once a second, in case anything slipped past
task.spawn(function()
	while true do
		task.wait(1)
		if here then
			applyPark()
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="25">
          <Properties>
            <string name="Name">Pets</string>
            <string name="Source"><![CDATA[-- Draws every player's pet (the critter they picked in the Collection Book) floating along beside them.
-- Purely on each screen: it costs the server nothing and never affects the game.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local CritterModels = require(ReplicatedStorage.Shared.CritterModels)

local folder = Instance.new("Folder")
folder.Name = "Pets"
folder.Parent = workspace

local pets = {} -- [player] = { key, model, phase }

local function buildPet(key, owner)
	local def, mut = Config.fromKey(key)
	if not def then
		return nil
	end
	local m = CritterModels.build(def, CFrame.new(0, -500, 0), mut)
	local body = m.PrimaryPart
	local tag = body:FindFirstChild("Tag")
	if tag then
		local nameL = tag:FindFirstChild("CritterName")
		local info = tag:FindFirstChild("Info")
		if info then
			info.Text = owner.DisplayName .. "'s pet"
		end
		if nameL then
			nameL.Text = m.Name
		end
		tag.MaxDistance = 40
		tag.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
	end
	pcall(function()
		m:ScaleTo(0.6)
	end)
	m.Parent = folder
	return m
end

local keep = { Eye = true, Pupil = true, Nose = true }
local t = 0
RunService.RenderStepped:Connect(function(dt)
	t += dt
	for _, p in ipairs(Players:GetPlayers()) do
		local key = p:GetAttribute("Pet")
		local rec = pets[p]
		if (rec and rec.key) ~= key then
			if rec and rec.model then
				rec.model:Destroy()
			end
			pets[p] = nil
			rec = nil
			if key then
				rec = { key = key, model = buildPet(key, p), phase = math.random() * 6 }
				pets[p] = rec
			end
		end
		local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		if rec and rec.model and hrp then
			local target = hrp.CFrame * CFrame.new(3.4, 1.4 + math.sin(t * 3 + rec.phase) * 0.45, 3)
			local current = rec.model:GetPivot()
			if (current.Position - target.Position).Magnitude > 40 then
				rec.model:PivotTo(target) -- teleported: catch up at once
			else
				rec.model:PivotTo(current:Lerp(target, math.clamp(dt * 7, 0, 1)))
			end
			if rec.model:GetAttribute("Rainbow") then
				local h = (t * 0.25) % 1
				for _, part in ipairs(rec.model:GetDescendants()) do
					if part:IsA("BasePart") and not keep[part.Name] then
						part.Color = Color3.fromHSV(h, 0.55, 1)
					end
				end
			end
		end
	end
	for p, rec in pairs(pets) do
		if not p.Parent then
			if rec.model then
				rec.model:Destroy()
			end
			pets[p] = nil
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="26">
          <Properties>
            <string name="Name">Rover</string>
            <string name="Source"><![CDATA[-- Driving the Moon Rover (2026-10-18): while you sit in its seat, your screen steers it. WASD / arrow keys or the
-- tablet joystick come through the VehicleSeat as Throttle and Steer; the server hands you the rover while you drive.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local MAX_SPEED = 32 -- a bit faster than sprinting (27)
local REVERSE_SPEED = 14
local TURN_RATE = 1.9 -- radians per second at full lock
local ACCEL = 30 -- studs per second, per second

local speed, yaw, driving = 0, 0, nil

RunService.RenderStepped:Connect(function(dt)
	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	local seat = hum and hum.SeatPart
	if not (seat and seat:IsA("VehicleSeat") and seat:GetAttribute("Rover")) then
		driving, speed = nil, 0
		return
	end
	local rover = seat.Parent
	local hull = rover and rover.PrimaryPart
	local lv = hull and hull:FindFirstChildOfClass("LinearVelocity")
	local turn = hull and hull:FindFirstChildOfClass("AlignOrientation")
	if not (lv and turn) then
		return
	end
	if driving ~= seat then -- just got in: start from where it's pointing
		driving = seat
		local _, y = hull.CFrame:ToEulerAnglesYXZ()
		yaw, speed = y, 0
	end
	local throttle, steer = seat.ThrottleFloat, seat.SteerFloat
	local target = throttle > 0 and throttle * MAX_SPEED or throttle * REVERSE_SPEED
	if speed < target then
		speed = math.min(target, speed + ACCEL * dt)
	elseif speed > target then
		speed = math.max(target, speed - ACCEL * 1.5 * dt)
	end
	-- steer like a car: turning needs some speed, and flips when reversing
	local grip = math.clamp(math.abs(speed) / 8, 0.35, 1) * (speed < -0.5 and -1 or 1)
	yaw -= steer * TURN_RATE * grip * dt
	local heading = CFrame.Angles(0, yaw, 0)
	turn.CFrame = heading
	lv.VectorVelocity = heading.LookVector * speed
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="27">
          <Properties>
            <string name="Name">Spin</string>
            <string name="Source"><![CDATA[-- Turns everything marked with a "SpinSpeed" attribute (degrees per second) on this player's screen only,
-- and sends a shooting star across the sky now and then. Nothing here touches the game rules.
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local station = workspace:WaitForChild("Station", 30)
if not station then
	return
end
local decor = station:WaitForChild("Decor", 30)
if not decor then
	return
end

local spinners = {}
for _, obj in ipairs(decor:GetDescendants()) do
	if (obj:IsA("BasePart") or obj:IsA("Model")) and obj:GetAttribute("SpinSpeed") then
		table.insert(spinners, { obj = obj, speed = math.rad(obj:GetAttribute("SpinSpeed")) })
	end
end
for _, obj in ipairs(decor:GetChildren()) do -- asteroids are models in the folder itself
	if obj:IsA("Model") and obj:GetAttribute("SpinSpeed") and obj.PrimaryPart then
		local seen = false
		for _, s in ipairs(spinners) do
			if s.obj == obj then
				seen = true
			end
		end
		if not seen then
			table.insert(spinners, { obj = obj, speed = math.rad(obj:GetAttribute("SpinSpeed")) })
		end
	end
end

-- the belt stripes in the launch tunnel travel with the critters and loop back to the start
local belt = {}
for _, obj in ipairs(decor:GetDescendants()) do
	if obj:IsA("BasePart") and obj:GetAttribute("Belt") then
		table.insert(belt, obj)
	end
end
local Config = require(game:GetService("ReplicatedStorage").Shared.Config)
RunService.RenderStepped:Connect(function(dt)
	for _, s in ipairs(belt) do
		local p = s.Position
		local x = p.X + Config.ConveyorSpeed * dt
		if x > 64 then
			x -= 129
		end
		s.CFrame = CFrame.new(x, p.Y, p.Z)
	end
end)

-- turn around the world's up axis through the object's own centre, keeping its tilt
local function turn(cf, a)
	return CFrame.new(cf.Position) * CFrame.Angles(0, a, 0) * (cf - cf.Position)
end

RunService.RenderStepped:Connect(function(dt)
	for _, s in ipairs(spinners) do
		local o = s.obj
		if o.Parent then
			if o:IsA("Model") then
				o:PivotTo(turn(o:GetPivot(), s.speed * dt))
			else
				o.CFrame = turn(o.CFrame, s.speed * dt)
			end
		end
	end
end)

-- things that bob up and down (the UFO) and lights that blink (rocket beacons) (2026-10-18)
local bobbers, blinkers = {}, {}
for _, obj in ipairs(decor:GetDescendants()) do
	if obj:IsA("Model") and obj:GetAttribute("Bob") then
		table.insert(bobbers, { obj = obj, h = obj:GetAttribute("Bob"), last = 0 })
	elseif obj:IsA("BasePart") and obj:GetAttribute("Blink") then
		table.insert(blinkers, obj)
	end
end
local clock = 0
RunService.RenderStepped:Connect(function(dt)
	clock += dt
	for _, b in ipairs(bobbers) do
		if b.obj.Parent then
			local y = math.sin(clock * 1.6) * b.h
			b.obj:PivotTo(b.obj:GetPivot() + Vector3.new(0, y - b.last, 0))
			b.last = y
		end
	end
	local on = math.floor(clock * 1.5) % 2 == 0
	for _, p in ipairs(blinkers) do
		p.Transparency = on and 0 or 0.85
	end
end)

-- lag on the iPad (2026-10-25): anything this script moves every frame stops casting a shadow. A shadow that moves has to be
-- redrawn every frame, and the asteroids, light drones, UFO and spinning shop displays were doing that all the time.
local function noShadow(obj)
	if obj:IsA("BasePart") then
		obj.CastShadow = false
	end
	for _, d in ipairs(obj:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CastShadow = false
		end
	end
end
for _, s in ipairs(spinners) do
	noShadow(s.obj)
end
for _, b in ipairs(bobbers) do
	noShadow(b.obj)
end

-- shooting stars
local rng = Random.new()
task.spawn(function()
	while true do
		task.wait(rng:NextNumber(4, 9))
		local angle = rng:NextNumber(0, math.pi * 2)
		local start = Vector3.new(math.cos(angle) * 450, rng:NextNumber(120, 220), math.sin(angle) * 450)
		local dir = Vector3.new(-math.sin(angle), rng:NextNumber(-0.25, -0.05), math.cos(angle)).Unit
		local star = Instance.new("Part")
		star.Name = "ShootingStar"
		star.Anchored = true
		star.CanCollide = false
		star.CanQuery = false
		star.CanTouch = false
		star.CastShadow = false
		star.Material = Enum.Material.Neon
		star.Color = Color3.fromRGB(255, 240, 220)
		star.Size = Vector3.new(0.6, 0.6, 18)
		star.CFrame = CFrame.lookAt(start, start + dir)
		star.Parent = workspace
		local tw = TweenService:Create(star, TweenInfo.new(1.3, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(start + dir * 320, start + dir * 321), Transparency = 1 })
		tw:Play()
		tw.Completed:Connect(function()
			star:Destroy()
		end)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="28">
          <Properties>
            <string name="Name">Sprint</string>
            <string name="Source"><![CDATA[-- Sprint (2026-10-18, Matthew: "a sprint feature that has a meter to it that drains and slowly brings back up").
-- Hold Shift, or the Sprint button on a phone or tablet. The energy bar drains while you run and refills after you stop.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local S = Config.Sprint
local C = Config.Colors
local player = Players.LocalPlayer

local energy, wantRun, lastRun = 1, false, 0

local gui = Instance.new("ScreenGui")
gui.Name = "Sprint"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

-- the energy bar, bottom middle
local bar = Instance.new("Frame")
bar.AnchorPoint = Vector2.new(0.5, 1)
bar.Position = UDim2.new(0.5, 0, 1, -84) -- above Roblox's backpack bar, where weapons show up (2026-10-18)
bar.Size = UDim2.fromOffset(300, 26)
bar.BackgroundColor3 = C.Dark
bar.BackgroundTransparency = 0.15
bar.Parent = gui
local bc = Instance.new("UICorner")
bc.CornerRadius = UDim.new(1, 0)
bc.Parent = bar
local bs = Instance.new("UIStroke")
bs.Color = C.Blue
bs.Thickness = 2
bs.Parent = bar
local fill = Instance.new("Frame")
fill.Size = UDim2.fromScale(1, 1)
fill.BackgroundColor3 = C.Blue
fill.Parent = bar
local fc = Instance.new("UICorner")
fc.CornerRadius = UDim.new(1, 0)
fc.Parent = fill
local label = Instance.new("TextLabel")
label.Size = UDim2.fromScale(1, 1)
label.BackgroundTransparency = 1
label.Font = Enum.Font.FredokaOne
label.TextScaled = true
label.TextColor3 = Color3.new(1, 1, 1)
label.TextStrokeTransparency = 0.3
label.Text = "SPRINT (Shift)"
label.ZIndex = 2
label.Parent = bar

-- a Sprint button for touch screens
if UserInputService.TouchEnabled then
	label.Text = "SPRINT"
	local btn = Instance.new("TextButton")
	btn.AnchorPoint = Vector2.new(1, 1)
	btn.Position = UDim2.new(1, -295, 1, -50) -- left of PUNCH, clear of Jump (2026-10-18)
	btn.Size = UDim2.fromOffset(110, 70)
	btn.BackgroundColor3 = C.Blue
	btn.Font = Enum.Font.FredokaOne
	btn.TextScaled = true
	btn.TextColor3 = C.Dark
	btn.Text = "Sprint"
	btn.Parent = gui
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 16)
	c.Parent = btn
	btn.MouseButton1Down:Connect(function()
		wantRun = true
	end)
	btn.MouseButton1Up:Connect(function()
		wantRun = false
	end)
	btn.MouseLeave:Connect(function()
		wantRun = false
	end)
end

UserInputService.InputBegan:Connect(function(input, typing)
	if typing then
		return
	end
	if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift or input.KeyCode == Enum.KeyCode.ButtonL3 then
		wantRun = true
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift or input.KeyCode == Enum.KeyCode.ButtonL3 then
		wantRun = false
	end
end)

local tired = false -- once empty, you have to let it refill a bit before running again
RunService.Heartbeat:Connect(function(dt)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	local moving = hum.MoveDirection.Magnitude > 0.1
	local running = wantRun and moving and energy > 0 and not tired
	if running then
		energy = math.max(0, energy - S.drainPerSecond / 100 * dt)
		lastRun = os.clock()
		if energy <= 0 then
			tired = true
		end
	elseif os.clock() - lastRun > S.refillDelay then
		energy = math.min(1, energy + S.refillPerSecond / 100 * dt)
		if tired and energy > 0.25 then
			tired = false
		end
	end
	-- Turbo Legs adds speed; a hit stuns you for a moment (2026-10-18)
	local ch = player.Character
	local lvl = ch:GetAttribute("SpeedLevel") or 0
	local stunned = (ch:GetAttribute("StunnedUntil") or 0) > workspace:GetServerTimeNow()
	if stunned then
		hum.WalkSpeed = 4
	else
		hum.WalkSpeed = running and (S.run + lvl * Config.SpeedPerLevel.run) or (S.walk + lvl * Config.SpeedPerLevel.walk)
	end
	fill.Size = UDim2.fromScale(math.max(energy, 0.001), 1)
	fill.BackgroundColor3 = tired and Color3.fromRGB(150, 156, 176) or (running and C.Orange or C.Blue)
end)

player.CharacterAdded:Connect(function()
	energy, tired = 1, false
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="29">
          <Properties>
            <string name="Name">Station</string>
            <string name="Source"><![CDATA[-- The station's moving parts on this player's screen (2026-10-18, Matthew's batch): the metal gates rolling down and up
-- with each base's lock, disco balls, trampolines, comets crossing the sky, and extra twinkling stars over the open roof.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage.Shared.Config)
local player = Players.LocalPlayer
local station = workspace:WaitForChild("Station", 30)
if not station then
	return
end

local function sfx(name, pos)
	local def = Config.Sounds[name]
	local id = Config.soundId(def)
	if not id then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = def.volume or 0.5
	s.PlaybackSpeed = def.pitch or 1
	local holder = s
	if pos then
		local p = Instance.new("Part")
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.Transparency = true, false, false, false, 1
		p.Size = Vector3.new(1, 1, 1)
		p.CFrame = CFrame.new(pos)
		p.Parent = workspace
		s.RollOffMinDistance, s.RollOffMaxDistance = 14, 160
		s.Parent = p
		holder = p
	else
		s.Parent = SoundService
	end
	s:Play()
	if def.stopAfter then
		task.delay(def.stopAfter, function()
			if s.Parent then
				s:Stop()
			end
		end)
	end
	Debris:AddItem(holder, math.max(def.stopAfter or 0, 6))
end

-- ---------- the metal gates ----------
local function hookGate(base)
	local shutter, bar = base:WaitForChild("Shutter", 10), base:WaitForChild("ShutterBar", 10)
	if not (shutter and bar) then
		return
	end
	local top = shutter.CFrame * CFrame.new(0, shutter.Size.Y / 2, 0) -- built rolled up: its top edge is the housing
	local full = shutter:GetAttribute("Full") or 12
	local sx, sz = shutter.Size.X, shutter.Size.Z
	local amount = Instance.new("NumberValue") -- 0 = rolled up, 1 = all the way down
	local function draw()
		local h = 0.2 + (full - 0.2) * amount.Value
		shutter.Size = Vector3.new(sx, h, sz)
		shutter.CFrame = top * CFrame.new(0, -h / 2, 0)
		bar.CFrame = top * CFrame.new(0, -h - 0.25, 0)
	end
	amount.Changed:Connect(draw)
	local down = false
	local function update(instant)
		local want = (base:GetAttribute("ShieldUntil") or 0) > workspace:GetServerTimeNow()
		if want == down then
			return
		end
		down = want
		if instant then
			amount.Value = want and 1 or 0
			return
		end
		local tw = TweenService:Create(amount, TweenInfo.new(want and 0.8 or 1.1, want and Enum.EasingStyle.Bounce or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = want and 1 or 0 })
		tw:Play()
		if want then
			task.delay(0.45, function()
				sfx("gate", bar.Position)
			end)
		end
	end
	base:GetAttributeChangedSignal("ShieldUntil"):Connect(function()
		update(false)
	end)
	update(true)
end
for _, m in ipairs(station:GetChildren()) do
	if m:IsA("Model") and m:GetAttribute("BaseIndex") then
		task.spawn(hookGate, m)
	end
end

-- ---------- disco balls: spin and throw coloured light while the base's party is on ----------
local PARTY = { Color3.fromRGB(255, 90, 160), Color3.fromRGB(90, 200, 255), Color3.fromRGB(255, 220, 90), Color3.fromRGB(140, 255, 140), Color3.fromRGB(190, 120, 255) }
local clock = 0
-- lag on the iPad (2026-10-25): the bases and their disco balls are looked up twice a second, not searched for every frame,
-- and a ball that is off is left alone instead of having its lights rewritten each frame
local bases, balls, lookedAt = {}, {}, -1
local function findBalls()
	table.clear(bases)
	for _, m in ipairs(station:GetChildren()) do
		if m:IsA("Model") and m:GetAttribute("BaseIndex") then
			local f = m:FindFirstChild("Furniture")
			local ball = f and f:FindFirstChild("DiscoBall", true)
			if ball then
				table.insert(bases, m)
				balls[m] = ball
			end
		end
	end
end
local wasOn = {} -- [ball] = true while its party lights are on
RunService.RenderStepped:Connect(function(dt)
	clock += dt
	if clock - lookedAt > 0.5 then
		lookedAt = clock
		findBalls()
	end
	for _, m in ipairs(bases) do
		local ball = balls[m]
		if ball and ball.Parent then
			local on = m:GetAttribute("Disco") == true
			if on then
				ball.CFrame = ball.CFrame * CFrame.Angles(0, dt * 1.5, 0)
			end
			if on or wasOn[ball] then
				wasOn[ball] = on or nil
				for i, l in ipairs(ball:GetChildren()) do
					if l:IsA("SpotLight") then
						l.Brightness = on and 4 or 0
						l.Color = PARTY[(math.floor(clock * 2) + i) % #PARTY + 1]
					end
				end
			end
		end
	end
end)

-- ---------- trampolines: land on one and you fly ----------
local lastBounce = 0
local function hookTrampoline(p)
	if not (p:IsA("BasePart") and p:GetAttribute("Bounce")) then
		return
	end
	p.Touched:Connect(function(hit)
		local ch = player.Character
		local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
		if not (hrp and hit:IsDescendantOf(ch)) or os.clock() - lastBounce < 0.4 then
			return
		end
		lastBounce = os.clock()
		local v = hrp.AssemblyLinearVelocity
		hrp.AssemblyLinearVelocity = Vector3.new(v.X, p:GetAttribute("Bounce"), v.Z)
		sfx("bounce", p.Position)
	end)
end
for _, d in ipairs(station:GetDescendants()) do
	hookTrampoline(d)
end
station.DescendantAdded:Connect(hookTrampoline)

-- ---------- more stars over the open roof, gently twinkling ----------
local skyFolder = Instance.new("Folder")
skyFolder.Name = "LocalSky"
skyFolder.Parent = workspace
local rng = Random.new(7)
local twinkle = {}
for i = 1, 140 do
	local dir = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(0.35, 1), rng:NextNumber(-1, 1)).Unit
	local s = Instance.new("Part")
	s.Name = "SkyStar"
	s.Shape = Enum.PartType.Ball
	local size = rng:NextNumber(1.2, 3.2)
	s.Size = Vector3.new(size, size, size)
	s.Material = Enum.Material.Neon
	s.Color = (i % 5 == 0) and Color3.fromRGB(255, 220, 180) or ((i % 7 == 0) and Color3.fromRGB(180, 220, 255) or Color3.fromRGB(255, 255, 255))
	s.Anchored, s.CanCollide, s.CanQuery, s.CanTouch, s.CastShadow = true, false, false, false, false
	s.CFrame = CFrame.new(dir * rng:NextNumber(650, 900))
	s.Parent = skyFolder
	table.insert(twinkle, { part = s, phase = rng:NextNumber(0, 6.28), speed = rng:NextNumber(0.8, 2.2) })
end
local lastTwinkle = 0
RunService.Heartbeat:Connect(function()
	local t = os.clock()
	if t - lastTwinkle < 0.1 then -- 10 times a second is plenty for a slow twinkle (2026-10-25, lag on the iPad)
		return
	end
	lastTwinkle = t
	for i = 1, #twinkle, 2 do -- half of them twinkle
		local tw = twinkle[i]
		tw.part.Transparency = 0.15 + 0.55 * (0.5 + 0.5 * math.sin(t * tw.speed + tw.phase))
	end
end)

-- ---------- a comet across the sky every couple of minutes ----------
local function comet()
	local angle = rng:NextNumber(0, math.pi * 2)
	local from = Vector3.new(math.cos(angle) * 900, rng:NextNumber(200, 320), math.sin(angle) * 900)
	local to = Vector3.new(-math.cos(angle) * 900, rng:NextNumber(160, 280), -math.sin(angle) * 900) + Vector3.new(rng:NextNumber(-200, 200), 0, rng:NextNumber(-200, 200))
	local head = Instance.new("Part")
	head.Name = "Comet"
	head.Shape = Enum.PartType.Ball
	head.Size = Vector3.new(9, 9, 9)
	head.Material = Enum.Material.Neon
	head.Color = Color3.fromRGB(200, 235, 255)
	head.Anchored, head.CanCollide, head.CanQuery, head.CanTouch, head.CastShadow = true, false, false, false, false
	head.CFrame = CFrame.lookAt(from, to)
	head.Parent = skyFolder
	local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
	a0.Position, a1.Position = Vector3.new(0, 4, 0), Vector3.new(0, -4, 0)
	a0.Parent, a1.Parent = head, head
	local trail = Instance.new("Trail")
	trail.Attachment0, trail.Attachment1 = a0, a1
	trail.Lifetime = 3
	trail.LightEmission = 1
	trail.FaceCamera = true
	trail.Color = ColorSequence.new(Color3.fromRGB(220, 240, 255), Color3.fromRGB(150, 200, 255))
	trail.Transparency = NumberSequence.new(0.1, 1)
	trail.WidthScale = NumberSequence.new(1, 0)
	trail.Parent = head
	local sparks = Instance.new("ParticleEmitter")
	sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparks.Color = ColorSequence.new(Color3.fromRGB(255, 230, 180))
	sparks.LightEmission = 1
	sparks.Size = NumberSequence.new(2, 0)
	sparks.Lifetime = NumberRange.new(1, 2)
	sparks.Rate = 40
	sparks.Speed = NumberRange.new(2, 6)
	sparks.Parent = head
	sfx("comet")
	local secs = 16
	local tw = TweenService:Create(head, TweenInfo.new(secs, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(to, to + (to - from)) })
	tw:Play()
	tw.Completed:Connect(function()
		head:Destroy()
	end)
end
task.spawn(function()
	task.wait(rng:NextNumber(25, 50))
	while true do
		comet()
		task.wait(rng:NextNumber(Config.CometEvery[1], Config.CometEvery[2]))
	end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>