# Surge site — Apache config for SiteGround (and most shared Apache hosts).
# The local Node dev server does NOT read this; it mirrors the important bits.

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8
# 2026-11-09 (overnight review): the host sent site.webmanifest with no Content-Type, and Chrome logged
# "Manifest: Line: 1, column: 1, Syntax error" on every page. Apache has no type for .webmanifest unless told.
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Canonical host: www -> non-www. Flip both lines if you prefer www.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Pages consolidated 2026-09-07 — redirect the retired URLs to their new homes.
  # NE keeps the "#" fragment from being escaped to %23 in the Location header.
  RewriteRule ^how-it-works/?$        /what-we-do/#the-stages [R=301,L,NE]
  RewriteRule ^training/?$            /careers/#how-you-are-trained       [R=301,L,NE]
  RewriteRule ^careers/apply/?$       /careers/#apply                     [R=301,L,NE]
  # Sectors tabled 2026-09-07 — hub + all subpages fold to what-we-do.
  RewriteRule ^sectors(/.*)?$         /what-we-do/                        [R=301,L]
  # people who have left (2026-10-05): their pages go to the team page
  RewriteRule ^team/(ryan-conger|jon-wallace)/?$ /team/ [R=301,L]

  # The WordPress site this replaces (mapped 2026-11-10 from its sitemaps, menus and
  # wp post list). Every URL Google or an inbound link may hold goes to the page that
  # now does that job, so the launch does not turn them into 404s. /contact/, /careers/,
  # /team/ and /blog/ keep their addresses and need no rule.
  RewriteRule ^(our-focus|generate-revenue)/?$                 /what-we-do/      [R=301,L]
  RewriteRule ^clients/?$                                      /about/#sectors   [R=301,L,NE]
  RewriteRule ^(personal-growth|career-growth)/?$              /careers/         [R=301,L]
  RewriteRule ^locations(/.*)?$                                /contact/         [R=301,L]
  RewriteRule ^(denver-co|asheville-nc|houston-tx)/?$          /contact/         [R=301,L]
  RewriteRule ^privacy-policy/?$                               /privacy/         [R=301,L]
  RewriteRule ^terms-conditions/?$                             /terms/           [R=301,L]
  # the three posts kept their slugs, one level down
  RewriteRule ^(leadership-skills|entering-new-markets|scale-your-team)/?$ /blog/$1/ [R=301,L]
  # WordPress archives, feeds and paging
  RewriteRule ^blog/page/[0-9]+/?$                             /blog/            [R=301,L]
  RewriteRule ^[0-9]{4}/[0-9]{2}(/[0-9]{2})?/?$                /blog/            [R=301,L]
  RewriteRule ^(category|tag|author)(/.*)?$                    /blog/            [R=301,L]
  RewriteRule ^(feed|comments/feed)/?$                         /blog/            [R=301,L]
  # Yoast and core sitemaps -> the one sitemap
  RewriteRule ^(sitemap_index|page-sitemap|post-sitemap|category-sitemap|author-sitemap|sitemap-post-type-[a-z]+)\.xml$ /sitemap.xml [R=301,L]
  # WordPress itself is gone: say so (410) rather than 404, so crawlers drop it quickly
  RewriteRule ^(wp-admin|wp-includes|wp-content|wp-json)(/|$)   - [G,L]
  RewriteRule ^(wp-login|wp-cron|xmlrpc)\.php$                 - [G,L]
</IfModule>

# The form handler's settings file is PHP and prints nothing, but it should not answer
# over the web at all (DEPLOY.md expects 403; flagged by the 2026-11-09 review).
<Files "config.php">
  Require all denied
</Files>

# Never serve notes, sources, logs, dotfiles
<FilesMatch "\.(md|log|sh|mjs|map)$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # HTTPS is forced above, so browsers may remember it (the Traverse and 365 sites send the same header)
  Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "\.(?:css|js|svg|webp|jpg|jpeg|png|ico|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(?:webmanifest|xml)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp        "access plus 1 year"
  ExpiresByType image/jpeg        "access plus 1 year"
  ExpiresByType image/png         "access plus 1 year"
  ExpiresByType image/svg+xml     "access plus 1 year"
  ExpiresByType font/woff2        "access plus 1 year"
  ExpiresByType text/css          "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/xml application/javascript image/svg+xml application/json
</IfModule>
