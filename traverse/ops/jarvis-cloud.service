# J.A.R.V.I.S. cloud watcher (TRIAL: practice copy only). systemd USER service on the Azure VM; installed by jarvis-cloud.sh deploy
# to ~/.config/systemd/user/jarvis-cloud.service. Runs without a login because linger is on for yard (sudo loginctl enable-linger yard).
#   systemctl --user status|stop|start|restart jarvis-cloud      journalctl --user -u jarvis-cloud      log: ~/jarvis/state/help-watch.log
[Unit]
Description=J.A.R.V.I.S. cloud watcher (TRIAL: practice copy only)
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/bin/bash %h/jarvis/ops/help-watch-cloud.sh
Restart=always
RestartSec=20
Nice=5
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
